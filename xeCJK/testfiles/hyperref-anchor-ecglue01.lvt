\input{regression-test}

% #1047: hyperref 的行内锚点会在 xeCJK 的 marker 与后续字符之间插入不可见
% 节点，遮蔽边界探测，使锚点右侧的 \CJKecglue 丢失。有两个出口，按**调用点**
% 区分（不是按锚点内容），各自需要注册：
%
% 1. 驱动层的 \hyper@anchor：承接经 \hyper@@anchor 进来的锚点，直接排出裸的
%    pdf:dest whatsit。\hypertarget 的两个分支最终都走这里——\@hyper@@anchor
%    在 \ifHy@activeanchor 为假时统一调 \hyper@anchor，与目标内容是否为空
%    无关（已用计数器实测：空目标、CJK 目标、西文目标、数字目标四种形式的
%    \Hy@raisedlink 调用次数均为 0）。
% 2. \Hy@raisedlink：承接需要抬升的锚点——目录条目、脚注等——以及下游手工
%    包裹的写法，例如 ctxdoc 的 \exptarget 定义为
%    \Hy@raisedlink{\hypertarget{name}{}}。它在水平模式下排出 \penalty\@M
%    加一个 \smash 后的 hbox(0+0)x0（内含 pdf:dest special）。
%    本测试的 \TestTarget 就是复刻这种写法。
%
% 两者都无可见输出，注册为 transparent（入口取走 marker 与可选源码空格，
% 锚点节点排出后原样恢复）。\Hy@raisedlink 这一侧不能用 post-transparent：
% 那个 after-only 变体要求 marker 与末尾零尺寸盒子相邻，而 \Hy@raisedlink
% 在盒子之前还排出 \penalty，搬移条件不成立（实测无效）。
%
% 判别力（已实测）：去掉 \Hy@raisedlink 注册，TEST 1、TEST 2 由 41.66002
% 退化为 38.33002；去掉 \hyper@anchor 注册，TEST 3、TEST 4 各少一枚 3.33pt。
% 两组互不重叠，说明确实是两个独立出口。

\documentclass{article}

\usepackage{xeCJK}
\setCJKmainfont{FandolSong-Regular.otf}
\usepackage[hidelinks]{hyperref}

\newbox\RaisedBox \newbox\PlainLinkBox \newbox\DirectMathBox
\newbox\BareMathBox \newbox\BareWordBox \newbox\DirectWordBox
\newbox\NonEmptyBox \newbox\RefBox \newbox\SpacedRefBox

\makeatletter
\newcommand\TestTarget[1]{\Hy@raisedlink{\hypertarget{#1}{}}}
\makeatother

\begin{document}

\START

% 字体预热：先把后面用到的字体组合排一遍并丢弃。
\setbox\RaisedBox=\hbox{带有 \TestTarget{warm}$\star$ 标 word}

% --- TEST 1: \Hy@raisedlink 锚点紧接链接公式（Issue 原始 MWE 的结构）---
% oracle 用不带锚点、不带链接的直接公式：\CJKecglue 应当在两侧都出现。

\setbox\RaisedBox=\hbox{带有 \TestTarget{t1}\hyperlink{t1}{$\star$} 标}
\setbox\PlainLinkBox=\hbox{带有 \hyperlink{t1}{$\star$} 标}
\setbox\DirectMathBox=\hbox{带有 $\star$ 标}

\TEST{raisedlink anchor before link keeps ecglue (1047)}{
  \TYPE{INFO: with-anchor=\the\wd\RaisedBox,
    link-only=\the\wd\PlainLinkBox, direct=\the\wd\DirectMathBox}
  % 三者可见输出应完全一致：锚点与链接注释都无可见宽度。
  \dimen0=\wd\RaisedBox \advance\dimen0 by -\wd\DirectMathBox
  \ifdim\dimen0<0pt \dimen0=-\dimen0 \fi
  \ifdim\dimen0<0.01pt
    \TYPE{PASS: anchored link matches direct math oracle}
  \else
    \TYPE{FAIL: anchored link differs from oracle by \the\dimen0}
  \fi
  % 加锚点前后也应一致（锚点本身不改变间距）。
  \dimen2=\wd\RaisedBox \advance\dimen2 by -\wd\PlainLinkBox
  \ifdim\dimen2<0pt \dimen2=-\dimen2 \fi
  \ifdim\dimen2<0.01pt
    \TYPE{PASS: anchor does not change link spacing}
  \else
    \TYPE{FAIL: anchor changed link spacing by \the\dimen2}
  \fi
}

% --- TEST 2: 单独的 \Hy@raisedlink 锚点（无链接）---

\TEST{raisedlink anchor alone keeps ecglue (1047)}{
  \setbox\BareMathBox=\hbox{带有 \TestTarget{t2}$\star$ 标}
  \TYPE{INFO: anchor+math=\the\wd\BareMathBox,
    direct=\the\wd\DirectMathBox}
  \dimen0=\wd\BareMathBox \advance\dimen0 by -\wd\DirectMathBox
  \ifdim\dimen0<0pt \dimen0=-\dimen0 \fi
  \ifdim\dimen0<0.01pt
    \TYPE{PASS: bare raisedlink anchor is transparent}
  \else
    \TYPE{FAIL: bare raisedlink anchor differs by \the\dimen0}
  \fi
}

% --- TEST 3: 裸 \hypertarget 走驱动层 \hyper@anchor ---
% \hypertarget 不经过 \Hy@raisedlink（无论目标是否为空），需要独立注册。

\TEST{empty hypertarget before math keeps ecglue (1047)}{
  \setbox\BareMathBox=\hbox{带有 \hypertarget{t3}{}$\star$ 标}
  \TYPE{INFO: hypertarget+math=\the\wd\BareMathBox,
    direct=\the\wd\DirectMathBox}
  \dimen0=\wd\BareMathBox \advance\dimen0 by -\wd\DirectMathBox
  \ifdim\dimen0<0pt \dimen0=-\dimen0 \fi
  \ifdim\dimen0<0.01pt
    \TYPE{PASS: empty hypertarget is transparent before math}
  \else
    \TYPE{FAIL: empty hypertarget differs by \the\dimen0}
  \fi
}

% --- TEST 4: 裸 \hypertarget 后接西文词 ---
% 公式与普通西文词走 Boundary->Default 的不同分支，分别断言。

\TEST{empty hypertarget before Latin word keeps ecglue (1047)}{
  \setbox\BareWordBox=\hbox{带有 \hypertarget{t4}{}word 标}
  \setbox\DirectWordBox=\hbox{带有 word 标}
  \TYPE{INFO: hypertarget+word=\the\wd\BareWordBox,
    direct=\the\wd\DirectWordBox}
  \dimen0=\wd\BareWordBox \advance\dimen0 by -\wd\DirectWordBox
  \ifdim\dimen0<0pt \dimen0=-\dimen0 \fi
  \ifdim\dimen0<0.01pt
    \TYPE{PASS: empty hypertarget is transparent before Latin word}
  \else
    \TYPE{FAIL: empty hypertarget differs by \the\dimen0}
  \fi
}

% --- TEST 4b: 带西文可见内容的 \hypertarget 也走 \hyper@anchor ---
% 这一项固定「区分依据是调用点而非锚点内容」：目标非空时锚点仍经
% \hyper@anchor 排出，左侧的 \CJKecglue 同样依赖该注册。

\TEST{hypertarget with visible Latin target keeps ecglue (1047)}{
  \setbox\BareWordBox=\hbox{带有 \hypertarget{t4b}{word}$\star$ 标}
  \setbox\DirectWordBox=\hbox{带有 word$\star$ 标}
  \TYPE{INFO: visible-target=\the\wd\BareWordBox,
    direct=\the\wd\DirectWordBox}
  \dimen0=\wd\BareWordBox \advance\dimen0 by -\wd\DirectWordBox
  \ifdim\dimen0<0pt \dimen0=-\dimen0 \fi
  \ifdim\dimen0<0.01pt
    \TYPE{PASS: visible-target hypertarget matches direct input}
  \else
    \TYPE{FAIL: visible-target hypertarget differs by \the\dimen0}
  \fi
}

% --- TEST 5: 带 CJK 可见内容的 \hypertarget 仍按实际类别处理 ---
% 目标内容是 CJK 时，锚点前后应是 CJK-CJK 边界（\CJKglue，默认 0pt
% plus 0.96002），不能因为注册了 transparent 就补上 \CJKecglue。

\TEST{non-empty CJK hypertarget keeps CJK-CJK boundary (1047)}{
  \setbox\NonEmptyBox=\hbox{带有 \hypertarget{t5}{锚}$\star$ 标}
  \setbox\BareMathBox=\hbox{带有 锚$\star$ 标}
  \TYPE{INFO: cjk-target=\the\wd\NonEmptyBox,
    direct=\the\wd\BareMathBox}
  \dimen0=\wd\NonEmptyBox \advance\dimen0 by -\wd\BareMathBox
  \ifdim\dimen0<0pt \dimen0=-\dimen0 \fi
  \ifdim\dimen0<0.01pt
    \TYPE{PASS: CJK target content keeps its own boundary classes}
  \else
    \TYPE{FAIL: CJK target differs from direct input by \the\dimen0}
  \fi
}

% --- TEST 6: \ref 的链接注释不受影响 ---
% \Hy@raisedlink 也用于 \label 侧的锚点；注册它不应改变 \ref 两侧间距。
% 不用 \ref 的实际编号做参考：l3build 只编译一遍，首轮 .aux 未就绪时
% \ref 排出的是两字符的 `??`，宽度与最终编号不同（实测差 5.86pt）。
% 这里改用 \hyperref 直接给出链接文字，绕开 .aux 依赖。

\section{章节标题}\label{sec:target}

\TEST{hyperref link spacing unaffected (1047)}{
  \setbox\RefBox=\hbox{参见 \hyperref[sec:target]{1} 节}
  \setbox\SpacedRefBox=\hbox{参见 \mbox{1} 节}
  \TYPE{INFO: hyperref=\the\wd\RefBox, mbox=\the\wd\SpacedRefBox}
  \dimen0=\wd\RefBox \advance\dimen0 by -\wd\SpacedRefBox
  \ifdim\dimen0<0pt \dimen0=-\dimen0 \fi
  \ifdim\dimen0<0.01pt
    \TYPE{PASS: hyperref matches plain mbox layout}
  \else
    \TYPE{FAIL: hyperref differs from mbox by \the\dimen0}
  \fi
}

\END

\end{document}
