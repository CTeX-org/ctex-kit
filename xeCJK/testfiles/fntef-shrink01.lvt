% #1026 + #1037：装饰正文里西文词两侧的 \CJKecglue 收缩量都必须留在外层列表。
%
% ulem 自己扫描正文并按源码空格把它切成固定宽度的装饰片段盒。落在片段盒内部的
% glue，其收缩量被盒子固化而无法参与断行；行尾因此溢出右边距，装饰随之参差。
%
% 这条机制有两半，分别由两个 issue 修掉：
%   #1026（词后）：正文经宏参数间接展开时，西文词右侧的 \CJKecglue 进了片段盒。
%     修法是让正文以字面记号留在 ulem 的替换文本里。
%   #1037（词前）：「源码空格 + 西文词」处，源码空格已被前视吃掉，marker 落在
%     ulem 刚打开的片段盒内部，随后补出的 \CJKecglue 也就固化在盒内。修法是让
%     该处经 \@@_ulem_glue:n 输出，即先 \UL@stop 关盒、把间距画成外层 leaders、
%     再 \UL@start 开新盒。
%
% 只修一半时本文件前四项仍报 3.64pt 溢出（#1026 修好前是 18.08pt）；两半都修好
% 后不再溢出。判据因此是「无 Overfull 记录」，而不是某个具体溢出量。
%
% 三点必须注意，否则测试量不出这个缺陷：
%   1. 只有真正的段落断行才显现。把同一内容装进单个 \hbox 或 \vbox 都测不出，
%      因为那里的 glue set 会把内外层收缩一并用掉。
%   2. 正文必须在调用处写成字面记号。写成 \CJKunderline{\BODY} 时，\BODY 在
%      ulem 扫描期间才展开，收缩量同样进不了外层——这是发布版本就有的既有限制，
%      不在本次修复范围内，因此这里不用宏承载正文。
%   3. 前四项只固定行盒尺寸与 glue set，不比对装饰图形。TEST 5 是例外：它固定
%      完整节点列表，因此对装饰结构与 PDF 标记的改动同样敏感（改 ActualText 值
%      只有它会失败；改装饰线粗细则五项全失败，因为线粗会改变行盒高深）。这是
%      必要代价——只有节点列表能
%      拦住“宽度不变而装饰已消失”的实现。
%
% 溢出量随修复进度变化：#1026 缺陷版 18.08pt，只修词后 3.64pt，两半都修好后无
% 溢出。前四项的基线里因此不含任何 Overfull 行——这也意味着「溢出消失」不是空
% 基线的默认结果，而是可以被重新引入缺陷推翻的断言（实测两条变异各自会让
% Overfull 行回到基线里，见 TEST 6 的注释）。
\input{regression-test}

\documentclass{article}

\usepackage{xeCJK,xeCJKfntef}
\usepackage{xcolor}  % TEST 9 需要 \color；其他用例不受影响
\setCJKmainfont{FandolSong-Regular.otf}

\begin{document}

\START

% \loggingoutput 会把 \showboxbreadth／\showboxdepth 覆盖成 \maxdimen，因此必须
% 先调用它、再设回本文件需要的深度；顺序写反会让前四项也倒出完整节点列表（含
% 大量 PDF 绘图 special），与「只固定行盒尺寸与 glue set」的设计相矛盾。
\loggingoutput
\showboxbreadth=1 \showboxdepth=0

\TEST{underline keeps outer shrink across linebreak}{
  \hsize=200pt \linewidth=200pt \parindent=0pt
  虚室生白，吉祥止止\CJKunderline{虚室 hello 生白，吉祥 world 止止虚室生白，吉祥止止 }虚室生白，吉祥止止
  \par
}

\TEST{underwave keeps outer shrink across linebreak}{
  \hsize=200pt \linewidth=200pt \parindent=0pt
  虚室生白，吉祥止止\CJKunderwave{虚室 hello 生白，吉祥 world 止止虚室生白，吉祥止止 }虚室生白，吉祥止止
  \par
}

\TEST{subtract form keeps outer shrink across linebreak}{
  \hsize=200pt \linewidth=200pt \parindent=0pt
  虚室生白，吉祥止止\CJKunderline-{虚室 hello 生白，吉祥 world 止止虚室生白，吉祥止止 }虚室生白，吉祥止止
  \par
}

% 正文以“公式＋尾随源码空格”结尾时走重排路径（#1002）。重排同样必须让正文以
% 字面记号进入 ulem 的参数，否则这条路径会保留 #1026 的收缩量缺陷。因此这一项
% 必须同时含西文词，才能真正量到外层收缩量；只写 \CJKunderline{中文 $x$ } 的
% 用例分辨不出重排分支是否把正文关进了片段盒。
%
% “重排是否发生”由下一项的节点列表一并固定：把重排条件恒置为假时该项基线会失败
% （实测 rc 1）。command-boundary-math05 的 stream-ulem 末状态同样会失败，两者
% 互为交叉验证。
\TEST{math tail with trailing space keeps outer shrink}{
  \hsize=200pt \linewidth=200pt \parindent=0pt
  虚室生白，吉祥止止\CJKunderline{虚室 hello 生白，吉祥 world 止止虚室生白，吉祥止 $x$ }虚室生白，吉祥止止
  \par
}

% 尾随空格必须仍被装饰：重排把空格从正文里剥离后要交还 ulem 排版。漏掉这一步
% 时装饰盒总宽从 32.37527pt 降到 29.04527pt，末段装饰片段宽度同步从 11.04524pt
% 缩到 7.71524pt。片段数不变（前后都是 5 段），变化只在末段的宽度。
%
% 这一项不能依赖 overfull 报告作观察通道——内容短、不触发溢出，基线会是空的，
% 等于什么都没固定。因此观察通道分两层：
%   1. 成对宽度差。同一正文在“有／无尾随源码空格”下的装饰盒宽度之差，就是尾随
%      空格所占的那一段；漏交还空格时差值从 3.33pt 压到 0pt。
%   2. 节点列表。宽度差单独不足以证明那一段“被装饰”——把空格换成等宽 kern 时
%      宽度完全相同。因此把盒子按 command-boundary-math02 的既定做法交给
%      \loggingoutput 输出，让末段 \cleaders 及其中的图案盒本身进入基线。
%      注意不能用 \showbox：checkopts 带 -halt-on-error，\showbox 抛出的
%      "! OK." 会当场终止编译，之后的用例静默不执行而 check 仍报绿（同一个坑已
%      记在 verb-ecglue02.lvt 的注释里）。
\TEST{math tail trailing space is decorated}{
  \setbox0=\hbox{\CJKunderline{中文 $x$}}%   无尾随空格
  \setbox1=\hbox{\CJKunderline{中文 $x$ }}%  有尾随空格
  \TYPE{without-trailing-space=\the\wd0}
  \TYPE{with-trailing-space=\the\wd1}
  \dimen0=\wd1 \advance\dimen0 by -\wd0
  \TYPE{trailing-space-span=\the\dimen0}
  % 先 \clearpage 排空前序用例的页面，否则本项基线会夹带上千行前序页面转写。
  \clearpage
  % 基线里最深的条目是片段盒内的 \special，缩进 7 层（\box 排出后外面还有若干层
  % \vbox／\hbox 包装）。实测最小可行值就是 7：depth=6 会缺行而失败，7 与 8／9／20
  % 输出逐字节相同。这里取 8，即比最小值多 1 层——余量只有这 1 层，装饰结构一旦
  % 加深，\special 会先从基线里消失，届时需要同步调大这个值。
  \showboxbreadth=100 \showboxdepth=8
  \box1
  \clearpage
  \showboxbreadth=1 \showboxdepth=0
}

% #1037 的正向断言。前四项以「没有 Overfull 行」为判据，这是必要的但偏弱：它无法
% 区分「收缩量回到了外层」和「行恰好因别的原因不溢出」。这一项直接测量可收缩量。
%
% 不能用「\hbox to 的实际宽度」作判据：\hbox to 总会取到目标宽度，实际宽度减目标
% 宽度恒为 0，与收缩量在哪里无关。观察通道必须是 \badness——收缩量够时为 0，
% 不够时为 1000000（并伴随 Overfull 报告）。
%
% 做法：把同一正文压窄到自然宽度减 2pt。该正文在外层可用的收缩量，修好后是词前
% 1.11pt 加词后 1.11pt 共 2.22pt，足以吸收 2pt，\badness 为有限值（基线记 73）；
% 只修词后时外层仅 1.11pt，不足 2pt，\badness=1000000。取 2pt 正是为了落在
% 1.11 与 2.22 之间。（注意有限值不等于 0：\badness 反映的是收缩比例，用满一部分
% 收缩量就会大于 0，压窄 1pt 时为 9、2pt 时为 73。）
%
% 判别力（已实测 rc 1）：把 \@@_use_ecglue_skip: 改回 \skip_horizontal:N（即撤销
% #1037）后，本项 badness 由 73 变 1000000，且前四项的 Overfull 行回到基线。
%
% 正文必须含「源码空格 + 西文词」；写成 \CJKunderline{中文} 时没有 ecglue 可搬，
% 这一项就失去判别力。
\TEST{word-front ecglue shrink is available to the outer list}{
  \setbox0=\hbox{\CJKunderline{虚室 hello 生白}}%
  \dimen0=\wd0
  \TYPE{natural=\the\dimen0}
  \dimen2=\dimen0 \advance\dimen2 by -2pt
  % 用 \hfuzz 抑制 Overfull 报告：本项的观察量只有 \badness，报告文本进基线反而有害
  % ——它带一个 l3build 不归一化的绝对行号（见下），会让任何无关的行数变动使本项失败。
  %
  % 必须用 \hfuzz 而不是 \hbadness：\hbadness 只管 Underfull 警告的阈值，对 Overfull
  % 报告无效（实测默认值与 \hbadness=10000 都照样输出 Overfull；\hfuzz=100pt 才消掉，
  % 且三种设置下 \badness 都是 1000000，即观察量本身不受影响）。
  %
  % l3build 归一化的是 "on line %d*"、"on input line %d*"（l3build-check.lua:210,211）、
  % "at lines %d*--%d*"（:217）与行首的 "l.%d+ "（:144）。Overfull 单数形式的
  % "detected at line %d" 不在其中；曾让基线冻结了 "detected at line 149"，
  % 在 .lvt 里插入一行无关注释即失败。
  %
  % 不需要在末尾还原：\TEST 自带 \begingroup…\endgroup，这条局部赋值随分组失效。
  % （曾写成 \hbadness=0 「还原」，但 regression-test 下的默认值其实是 1000，
  %   写死 0 是个错误前提；若日后把这段搬出 \TEST 或改成全局赋值会开始漏警告。）
  \hfuzz=100pt
  \setbox2=\hbox to \dimen2{\CJKunderline{虚室 hello 生白}}%
  \TYPE{shrink-by-2pt-badness=\the\badness}
  % 对照：压窄 1pt 一定在两种实现下都够，用来证明上一行的 0 不是恒真。
  \setbox4=\hbox to \dimexpr\dimen0-1pt\relax{\CJKunderline{虚室 hello 生白}}%
  \TYPE{shrink-by-1pt-badness=\the\badness}
  % 对照：压窄 5pt 一定超出任何实现的收缩量，用来证明 1000000 可达。
  \setbox6=\hbox to \dimexpr\dimen0-5pt\relax{\CJKunderline{虚室 hello 生白}}%
  \TYPE{shrink-by-5pt-badness=\the\badness}
}

% #1037 的守卫回归。词前 ecglue 改走 \@@_ulem_glue:n 后，该入口位于所有中西文边界
% 都会经过的通用路径 \@@_check_for_ecglue_aux:，因此必须先确认「装饰 stream 确实
% 活动」才能取 ulem 通道。
%
% 只依赖 \@@_ulem_glue:n 自带的 \xeCJK_if_ulem_patch:TF 不够：它的判据仅是 \ 的含义
% 是否等于 ulem 保存的 \LA@space，无法区分「不在装饰中」与「在装饰外但 \ 被别的宏包
% 改过定义」。后者会在没有 \UL@box 打开的列表里执行 \UL@stop，报 Too many }'s。
% nath、morehype 等重定义 \ 的宏包会让不含任何装饰命令的「中 abc 文」直接报错。
%
% 因此这一项在装饰之外重定义 \ ，再排普通中西文混排：正确实现下 \l_@@_ulem_stream
% _started_bool 为假，退化为普通 \hskip，宽度正常且无错误。判别力已实测 rc 1：去掉
% 布尔守卫、只留 \@@_ulem_glue:n 时，本项编译即报 Too many }'s（基线里会多出错误
% 行），而前六项全部照常通过——即前六项对这个缺陷没有判别力，必须有本项。
\TEST{word-front ecglue stays neutral outside decoration}{
  \begingroup
  \def\ {\leavevmode\nobreak\ }%   模拟 nath/morehype 对 \ 的重定义
  \setbox0=\hbox{中 abc 文}%
  \TYPE{outside-decoration-width=\the\wd0}
  \endgroup
}

% #1037 守卫的第二个象限：布尔为真但片段盒已关闭。
%
% TEST 7 覆盖的是「布尔为假」（装饰之外）。只测布尔不足够：行内公式里的装饰命令经
% \UL@onmath／\UL@onin 结束，不走 \@@_ulem_end:，所以同一个公式内装饰命令之后
% \l_@@_ulem_stream_started_bool 仍为真，而片段盒其实已经关闭。此时再叠加 \ 被重定义，
% 依然会在没有 \UL@box 打开的列表里执行 \UL@stop。
%
% 因此守卫还要确认 \UL@start 已被 \let 成 \@empty（即片段盒确实打开）。实测三点区分：
% 文档层 bool=f／UL@start-is-@empty=f；装饰内 T／T；公式内装饰命令之后 T／f——只有第三
% 种会被布尔单独判断漏掉。
%
% 判别力已实测 rc 1：把守卫退回只测布尔（去掉 \cs_if_eq_p:NN \UL@start \@empty）后，
% 本项报 Extra }, or forgotten \endgroup 及两次 Undefined control sequence \UL@leadtype，
% 而 TESTs 1-7 全部照常通过——即 TEST 7 对这个象限没有判别力，必须有本项。
% 基线里那条 "Missing character: There is no 中 ... lmroman10-regular" 是预期噪声，不是
% 本项要观察的东西：公式内的 \mbox 恢复的是数学模式的正文字体，其中没有汉字。
% 实测该警告在 head 与 #1037 之前的实现上都是 1 次（即属既有行为、与本改动无关）；
% 守卫有缺陷的版本反而是 0 次，因为编译在 TEST 8 出错后走不到发出警告的位置——这也说明
% 不能拿这条警告的有无当判据，本项的判据是编译无错误加宽度值。
% 之所以仍保留汉字而不改成纯西文，是因为必须有中西文边界才会调用
% \@@_check_for_ecglue_aux:，而这正是被测入口。
\TEST{word-front ecglue stays neutral after math-mode decoration}{
  \begingroup
  \def\ {\leavevmode\nobreak\ }%
  \setbox0=\hbox{$\CJKunderline{中}\mbox{中 abc 文}$}%
  \TYPE{after-math-decoration-width=\the\wd0}
  \endgroup
}

% #1037 的第三条补 ecglue 的路径：\@@_recover_ecglue_source_space_success: 与
% \@@_check_for_glue_auxi:。西文词被显式分组或字体／颜色命令包住时走的是这两处，而不是
% \@@_check_for_ecglue_aux:，因此它们也必须改用 \@@_use_ecglue_skip:。
%
% 本项用 \color 形态。必须用它而不是 \bfseries：实测 \bfseries 形态在这两处改动前后都是
% 2.22pt（它根本不走这条路径），拿它做断言会得到一个恒真的测试。\color 形态才是真正的判据
% ——改动前 1.11pt、改动后 2.22pt（与无装饰 oracle 相同）。
%
% 段落级也可见，但注意三个阶段各自的数值不要混：以 #1026 资产 MWE（paperwidth=10cm）为例，
% #1026 缺陷版是 18.91pt 与 3.91pt 两行各溢出，#1026 修好而 #1037 未修时只剩 4.47pt 一处，
% #1037 修好后不溢出。本文件用的是 \hsize=200pt，同样三个阶段对应 18.08pt、3.64pt、无溢出
% （见文件开头第 14-15 与 29-31 行）。两组几何不可混用，同一组内也不要把不同阶段的数值并列。
%
% 判别力已实测 rc 1：把这两处改回裸 \skip_horizontal:N 后，本项 \color 形态的 badness 由
% 73 变 1000000。TESTs 1-8 对这两处零判别力（改回后它们的基线无任何变化），必须有本项。
%
% braced 两行原先固定的是一条「已接受的限制」：正文写成 \CJKunderline{虚室 {hello} 生白}
% 时，显式分组使 \l_@@_group_tag_tl 与当前分组标记不符（实测 T1L4 vs T1L5），
% \@@_ulem_glue:n 的 group tag 守卫据此拒绝搬运，收缩量固化在片段盒内（压窄 2pt 时
% badness 1000000）。#1067 把这条限制修掉了，因此这两行现在固定的是修复后的行为
% （2pt → 73、1pt → 9，与 oracle 一致），成因与门禁见 TEST 11。
%
% 守卫本身没有改动，也不该改：绕过它会让 fntef-font01 失败（字体从 FandolKai 退回
% FandolSong），因为在用户分组内执行 \UL@stop 会连带退出用户那层分组。#1067 的修法是让
% 守卫的 else 分支不再原地固化，而是「盒内放不可伸缩的 kern 占住自然宽度、把伸缩量记账，
% 到词尾已在盒外时补一个零宽带伸缩的 glue」——见 \@@_ulem_defer_glue:n 与
% \@@_ulem_flush_pending_shrink:。
%
% 另需注意：这两种写法早先从 0pt 到 1.11pt 的改善来自 #1026（词后那半），不是 #1037 的
% 功劳；#1037 在这两种写法上没有进一步改善。补齐最后 1.11pt 的是 #1067。
\TEST{grouped western word also frees outer shrink}{
  \setbox0=\hbox{\CJKunderline{虚室 \color{red}hello 生白}}%
  \dimen0=\wd0
  \TYPE{color-natural=\the\dimen0}
  \hfuzz=100pt
  \setbox2=\hbox to \dimexpr\dimen0-2pt\relax{\CJKunderline{虚室 \color{red}hello 生白}}%
  \TYPE{color-shrink-by-2pt-badness=\the\badness}
  % #1067 修好后：显式分组形态的收缩量也回到外层，压窄 2pt 够用（与 oracle 一致）
  \setbox4=\hbox{\CJKunderline{虚室 {hello} 生白}}%
  \dimen4=\wd4
  \setbox6=\hbox to \dimexpr\dimen4-2pt\relax{\CJKunderline{虚室 {hello} 生白}}%
  \TYPE{braced-shrink-by-2pt-badness=\the\badness}
  \setbox8=\hbox to \dimexpr\dimen4-1pt\relax{\CJKunderline{虚室 {hello} 生白}}%
  \TYPE{braced-shrink-by-1pt-badness=\the\badness}
}

% #1037 的第四条路径：\xeCJK_check_for_glue: 的 \@@_if_last_math: 真分支。公式紧接 CJK
% （中间无源码空格，如 $x$中文）时走这一处。它在前几轮被误判为「装饰内不可达」——当时的探针
% 只包装函数入口、没有区分分支，因此没命中；直接在该行插桩才看到它确实执行。
%
% 判别力已实测 rc 1：把该处改回裸 \skip_horizontal:N 后本项 badness 由 73 变 1000000，
% TESTs 1-9 零命中。
%
% 另：\@@_check_for_glue_auxi: 的两处本文件无覆盖——TEST 9 的正文一次都没进入该函数。
% 注意那是两个**独立**的 dim_case 分支，各自需要一条断言：
%   default 分支：末节点是 Default 类，如 \mbox{hi}中文
%   math 分支：末节点是 math marker，如 \mbox{$x$}中文
% 逐分支变异实测：只改回 default 分支时仅 boxed 断言失败；只改回 math 分支时，若没有
% boxed-math 断言则全套 115 项仍全绿（该分支可达且改动正确，但无门禁）。
\TEST{math-adjacent and boxed forms also free outer shrink}{
  \hfuzz=100pt
  \setbox0=\hbox{\CJKunderline{$x$中文}}%
  \dimen0=\wd0
  \TYPE{math-adjacent-natural=\the\dimen0}
  \setbox2=\hbox to \dimexpr\dimen0-1pt\relax{\CJKunderline{$x$中文}}%
  \TYPE{math-adjacent-shrink-by-1pt-badness=\the\badness}
  \setbox4=\hbox{\CJKunderline{\mbox{hi}中文}}%
  \dimen4=\wd4
  \setbox6=\hbox to \dimexpr\dimen4-1pt\relax{\CJKunderline{\mbox{hi}中文}}%
  \TYPE{boxed-shrink-by-1pt-badness=\the\badness}
  % math 分支：盒内是公式，末节点因此是 math marker 而非 Default 类
  \setbox8=\hbox{\CJKunderline{\mbox{$x$}中文}}%
  \dimen8=\wd8
  \setbox10=\hbox to \dimexpr\dimen8-1pt\relax{\CJKunderline{\mbox{$x$}中文}}%
  \TYPE{boxed-math-shrink-by-1pt-badness=\the\badness}
}

% #1067：花括号分组内的 \CJKecglue 收缩量也要回到外层。
%
% 成因：ulem 按源码空格切词（实测两种写法切出的词相同，只差一对花括号），词内容传给
% \UL@start 后花括号在片段盒**内部**展开成分组，于是边界检测在盒内、且在用户分组内触发；
% \@@_ulem_glue:n 的 group tag 守卫比对 saved=T1L4 与 now=T1L5 不相等，走 else 分支。
% 修好前 else 分支是裸 \skip_horizontal:n，间距连收缩量固化在定宽片段盒内。
%
% 修法（\@@_ulem_defer_glue:n + \@@_ulem_flush_pending_shrink:）：盒内只放不可伸缩的 kern
% 占住自然宽度（排版位置与总宽不变），把伸缩量记账到全局；到 \@@_ulem_loop:nw 的词尾搬运
% 处已经在片段盒外、用户分组外，再补一个零宽带伸缩的 glue。
%
% 为什么不能简单绕过守卫：实测强制搬运（已确认执行到）之后，搬出来的 glue 落进了
% \cleaders 内部而仍在盒内——在用户分组内 \UL@stop 关不掉正确层级，\UL@start 重开的盒子
% 又把它包了回去；而且绕过守卫会让 fntef-font01 失败（分组内字体设置丢失）。
% 也就是说「守卫是直接原因」与「绕过守卫无效」同时成立，修法必须绕开这个结构而不是拆掉守卫。
%
% 自然宽度为零的间距必须短路，不能走记账：\CJKglue 是 0pt plus 0.96（只有伸长、没有收缩），
% 把它换成 kern 会连伸长量一起丢掉。实测漏掉这个短路时 fntef-font01 的盒宽从 40.0pt 变成
% 39.00002pt（\glue 0.0 plus 0.96002 变成 \kern 0.0），这也是本项必须带 cjkglue 断言的原因。
%
% 判别力（逐条实测）：
%   - 去掉 \@@_ulem_defer_glue:n 的记账（else 分支改回裸 \skip_horizontal:n）：
%     braced / textbf / nested 三条由 73 变 1000000。
%   - 去掉 \@@_ulem_flush_pending_shrink: 的调用：同上三条变 1000000（记了账没兑现）。
%   - 去掉自然宽度为零的短路：cjkglue-width 由 40.0pt 变 39.00002pt（fntef-font01 同时失败）。
%
% 注意 \CJKunderline{虚室 {文字} 生白} 这类纯汉字正文**不在**本项范围：它的 oracle 本身就是
% 1000000（纯汉字之间只有 \CJKglue，没有可收缩的间距），与编组、与装饰命令都无关。曾把它
% 误列为「受影响」，实测 oracle 后否证。
\TEST{brace group ecglue shrink returns to the outer list}{
  \hfuzz=100pt
  % oracle：同一正文去掉装饰命令，收缩量全部可用
  \setbox20=\hbox{虚室 {hello} 生白}%
  \dimen20=\wd20
  \TYPE{oracle-natural=\the\dimen20}
  \setbox21=\hbox to \dimexpr\dimen20-2pt\relax{虚室 {hello} 生白}%
  \TYPE{oracle-shrink-by-2pt-badness=\the\badness}
  % 裸花括号
  \setbox22=\hbox{\CJKunderline{虚室 {hello} 生白}}%
  \dimen22=\wd22
  \TYPE{braced-natural=\the\dimen22}
  \setbox23=\hbox to \dimexpr\dimen22-2pt\relax{\CJKunderline{虚室 {hello} 生白}}%
  \TYPE{braced-shrink-by-2pt-badness=\the\badness}
  % 带参数的命令：花括号属于 \textbf 的参数，同样在盒内开分组
  \setbox24=\hbox{\CJKunderline{虚室 \textbf{hello} 生白}}%
  \dimen24=\wd24
  \TYPE{textbf-natural=\the\dimen24}
  \setbox25=\hbox to \dimexpr\dimen24-2pt\relax{\CJKunderline{虚室 \textbf{hello} 生白}}%
  \TYPE{textbf-shrink-by-2pt-badness=\the\badness}
  % 嵌套两层花括号：记账要能累加
  \setbox26=\hbox{\CJKunderline{虚室 {{hello}} 生白}}%
  \dimen26=\wd26
  \TYPE{nested-natural=\the\dimen26}
  \setbox27=\hbox to \dimexpr\dimen26-2pt\relax{\CJKunderline{虚室 {{hello}} 生白}}%
  \TYPE{nested-shrink-by-2pt-badness=\the\badness}
  % 自然宽度为零的 \CJKglue 必须原样保留伸长量：漏掉短路时本行宽度会变窄约 1pt
  \setbox28=\hbox{\CJKunderline{文字{\sffamily 文字}}}%
  \TYPE{cjkglue-braced-width=\the\wd28}
}
\END
