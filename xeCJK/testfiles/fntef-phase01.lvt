      {
        \special{pdf:literal~direct~q~0.22345~0.33456~m~Q}
        \tex_vrule:D
          width  \dim_eval:n { 1 em / 4 }
          height .05 em
          depth  0 pt
        \hss
      }
  }
\cs_set_protected:Npn \__xeCJK_fntef_wave_left_endpoint_symbol:
  {
