\newcommand\PhaseLeftAnchor{%
  \hbox to 0pt{%
    \special{pdf:literal direct q 0.54321 0.65432 m Q}%
    \vrule width .01pt height .01pt\hss}}
\newcommand\PhaseRightAnchor{%
  \hbox to 0pt{%
    \special{pdf:literal direct q 0.64321 0.75432 m Q}%
    \vrule width .01pt height .01pt\hss}}
\newcommand\PhaseRow[2]{%
  \hbox to 100pt{\hskip#1\PhaseLeftAnchor#2\PhaseRightAnchor\hss}\par}
\newcommand\EndpointRow[1]{%
  \PhaseLeftAnchor#1\PhaseRightAnchor\par}

\begin{document}

\START

\TYPE{PHASE-CHECK-PENDING}

\offinterlineskip
\PhaseRow{0pt}{\CJKunderwave[hidden=true]{字字字字}}
\PhaseRow{1pt}{\CJKunderwave[hidden=true]{字字字字}}
\PhaseRow{3pt}{\CJKunderwave[hidden=true]{字字字字}}
\PhaseRow{5pt}{\CJKunderwave[hidden=true]{字字字字}}
\PhaseRow{0pt}{\CJKxout[hidden=true]{字字字字}}
\PhaseRow{1pt}{\CJKxout[hidden=true]{字字字字}}
\PhaseRow{3pt}{\CJKxout[hidden=true]{字字字字}}
\PhaseRow{5pt}{\CJKxout[hidden=true]{字字字字}}

\EndpointRow{\CJKunderwave[hidden=true]{字字字字}}
\EndpointRow{\CJKunderwave-[hidden=true]{字字字字}}
\EndpointRow{\CJKxout[hidden=true]{字字字字}}
\EndpointRow{\CJKxout-[hidden=true]{字字字字}}

\begingroup
  \xeCJKsetup{CJKglue=\hskip 1pt}
  \FntefGlueMarkersOn
  \EndpointRow{\CJKunderwave[hidden=true]{字字字字}}
  \EndpointRow{\CJKxout[hidden=true]{字字字字}}
\endgroup

\begingroup
  \xeCJKsetup{CJKglue=\hskip 0pt plus 1fil}
  \FntefGlueMarkersOn
  \hbox to 4.4em{\PhaseLeftAnchor
    \CJKunderwave[hidden=true]{字字字字}\PhaseRightAnchor}\par
  \hbox to 4.4em{\PhaseLeftAnchor
    \CJKxout[hidden=true]{字字字字}\PhaseRightAnchor}\par
\endgroup

\EndpointRow{\CJKunderwave-[hidden=true]{字字}%
  \CJKunderwave-[hidden=true]{字字}}
\EndpointRow{\CJKxout-[hidden=true]{字字}%
  \CJKxout-[hidden=true]{字字}}

\EndpointRow{\CJKunderwave[hidden=true]{字\quad 字}}
\EndpointRow{\CJKxout[hidden=true]{字\quad 字}}
\clearpage

\END

