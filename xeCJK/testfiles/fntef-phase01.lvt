\ExplSyntaxOn
\cs_new_protected:Npn \__fntef_test_marker:nn #1#2
  {
    \special{pdf:literal~direct~q~#1~#2~m~Q}
    \tex_vrule:D width .01 pt height .01 pt depth 0 pt
    \tex_kern:D -.01 pt
  }
\cs_set_protected:Npn \__xeCJK_fntef_wave_symbol:
  {
    \hbox_to_wd:nn { 1 em / 4 }
      {
        \special{pdf:literal~direct~q~0.12345~0.23456~m~Q}
        \tex_vrule:D
          width  \dim_eval:n { 1 em / 4 }
          height .05 em
          depth  0 pt
        \hss
      }
  }
\cs_set_protected:Npn \__xeCJK_fntef_xout_symbol:
  {
