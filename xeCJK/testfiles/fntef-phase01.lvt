\bool_new:N \l__fntef_test_glue_markers_bool
\cs_if_exist:NT \__xeCJK_fntef_wave_glue:n
  {
    \cs_new_eq:NN \__fntef_test_wave_glue:n
      \__xeCJK_fntef_wave_glue:n
    \cs_set_protected:Npn \__xeCJK_fntef_wave_glue:n #1
      {
        \bool_if:NT \l__fntef_test_glue_markers_bool
          { \__fntef_test_marker:nn { 0.72345 } { 0.83456 } }
        \__fntef_test_wave_glue:n {#1}
        \bool_if:NT \l__fntef_test_glue_markers_bool
