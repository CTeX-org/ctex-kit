\input{regression-test}

\documentclass{article}

\AtBeginDvi{%
  \special{dvipdfmx:config z 0}%
  \special{dvipdfmx:config C 0x40}}
\usepackage{xeCJKfntef}
\setCJKmainfont{FandolSong-Regular.otf}

\pagestyle{empty}
\setlength\parindent{0pt}

\ExplSyntaxOn
\cs_new_protected:Npn \__fntef_test_marker:nn #1#2
  {
    \special{pdf:literal~direct~q~#1~#2~m~Q}
    \tex_vrule:D width .01 pt height .01 pt depth 0 pt
    \tex_kern:D -.01 pt
  }
\cs_set_protected:Npn \__xeCJK_fntef_wave_symbol:
  {
    \hbox_to_wd:nn { 1 em / 4 }
      {
        \special{pdf:literal~direct~q~0.12345~0.23456~m~Q}
        \tex_vrule:D
          width  \dim_eval:n { 1 em / 4 }
          height .05 em
          depth  0 pt
        \hss
      }
  }
\cs_set_protected:Npn \__xeCJK_fntef_xout_symbol:
  {
    \hbox_to_wd:nn { 1 em / 4 }
      {
        \special{pdf:literal~direct~q~0.22345~0.33456~m~Q}
        \tex_vrule:D
          width  \dim_eval:n { 1 em / 4 }
          height .05 em
          depth  0 pt
        \hss
      }
  }
\cs_new_eq:NN \__fntef_test_clipped_leaders:nnn
  \__xeCJK_ulem_periodic_clipped_leaders:nnn
\cs_set_protected:Npn \__xeCJK_ulem_periodic_clipped_leaders:nnn #1#2#3
  {
    \skip_horizontal:n {#2}
    \__fntef_test_marker:nn { 0.32345 } { 0.43456 }
    \skip_horizontal:n { - #2 }
    \__fntef_test_clipped_leaders:nnn {#1} {#2} {#3}
    \skip_horizontal:n { - #3 }
    \__fntef_test_marker:nn { 0.42345 } { 0.53456 }
    \skip_horizontal:n {#3}
  }
\NewDocumentCommand \FntefCommandSplit { }
  { \__fntef_test_marker:nn { 0.52345 } { 0.63456 } }
\ExplSyntaxOff

\newcommand\PhaseLeftAnchor{%
  \hbox to 0pt{%
    \special{pdf:literal direct q 0.54321 0.65432 m Q}%
    \vrule width .01pt height .01pt\hss}}
\newcommand\PhaseRightAnchor{%
  \hbox to 0pt{%
    \special{pdf:literal direct q 0.64321 0.75432 m Q}%
    \vrule width .01pt height .01pt\hss}}
\newcommand\PhaseRow[2]{%
  \hbox to 100pt{\hskip#1\PhaseLeftAnchor#2\PhaseRightAnchor\hss}\par}
\newcommand\EndpointRow[1]{%
  \PhaseLeftAnchor#1\PhaseRightAnchor\par}

\begin{document}

\START

\TYPE{PHASE-CHECK-PENDING}

\offinterlineskip
\PhaseRow{0pt}{\CJKunderwave[hidden=true]{字字字字}}
\PhaseRow{1pt}{\CJKunderwave[hidden=true]{字字字字}}
\PhaseRow{3pt}{\CJKunderwave[hidden=true]{字字字字}}
\PhaseRow{5pt}{\CJKunderwave[hidden=true]{字字字字}}
\PhaseRow{0pt}{\CJKxout[hidden=true]{字字字字}}
\PhaseRow{1pt}{\CJKxout[hidden=true]{字字字字}}
\PhaseRow{3pt}{\CJKxout[hidden=true]{字字字字}}
\PhaseRow{5pt}{\CJKxout[hidden=true]{字字字字}}
\PhaseRow{0pt}{\CJKunderwave-[hidden=true]{字字字字}}
\PhaseRow{1pt}{\CJKunderwave-[hidden=true]{字字字字}}
\PhaseRow{3pt}{\CJKunderwave-[hidden=true]{字字字字}}
\PhaseRow{5pt}{\CJKunderwave-[hidden=true]{字字字字}}
\PhaseRow{0pt}{\CJKxout-[hidden=true]{字字字字}}
\PhaseRow{1pt}{\CJKxout-[hidden=true]{字字字字}}
\PhaseRow{3pt}{\CJKxout-[hidden=true]{字字字字}}
\PhaseRow{5pt}{\CJKxout-[hidden=true]{字字字字}}

\EndpointRow{\CJKunderwave[hidden=true]{字字字字}}
\EndpointRow{\CJKunderwave-[hidden=true]{字字字字}}
\EndpointRow{\CJKxout[hidden=true]{字字字字}}
\EndpointRow{\CJKxout-[hidden=true]{字字字字}}

\begingroup
  \xeCJKsetup{CJKglue=\hskip 1pt}
  \EndpointRow{\CJKunderwave[hidden=true]{字字字字}}
  \EndpointRow{\CJKxout[hidden=true]{字字字字}}
\endgroup

\begingroup
  \xeCJKsetup{CJKglue=\hskip 0pt plus 1fil}
  \hbox to 4.4em{\PhaseLeftAnchor
    \CJKunderwave[hidden=true]{字字字字}\PhaseRightAnchor}\par
  \hbox to 4.4em{\PhaseLeftAnchor
    \CJKxout[hidden=true]{字字字字}\PhaseRightAnchor}\par
\endgroup

\EndpointRow{\CJKunderwave-[hidden=true]{字字}%
  \FntefCommandSplit\CJKunderwave-[hidden=true]{字字}}
\EndpointRow{\CJKxout-[hidden=true]{字字}%
  \FntefCommandSplit\CJKxout-[hidden=true]{字字}}

\EndpointRow{\CJKunderwave[hidden=true]{字\quad 字}}
\EndpointRow{\CJKxout[hidden=true]{字\quad 字}}

\EndpointRow{\CJKunderwave[hidden=true]{字}}
\EndpointRow{\CJKunderwave-[hidden=true]{字}}
\EndpointRow{\CJKxout[hidden=true]{字}}
\EndpointRow{\CJKxout-[hidden=true]{字}}
\clearpage

\END

