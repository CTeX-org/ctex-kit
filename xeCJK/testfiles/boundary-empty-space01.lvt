\input{regression-test}

% #1103：没有可见输出的已注册命令两侧都有源码空格时，以前多出一枚空格
% （两侧是汉字时多出两枚空格的宽度，|中 \mbox{} 文| 为 26.66pt，直接输入
% 20.0pt）。比较基准是把命令从源码中删去后的直接输入：|中 \cmd 文| 对应
% |中  文|，TeX 把相邻的两个空格读成一个空格记号。
%
% 每个矩阵对一个命令、一组左右文字比较四种写法（00 两侧都没有空格、10 只有
% 左侧、01 只有右侧、11 两侧都有），在默认间距与可区分间距、xCJKecglue 两种
% 取值下各执行一遍。命令包括用户注册的 stream、transparent、box 三种空命令，
% 核心已注册的 \mbox{}、\textcolor{red}{}，hyperref 的 \hypertarget{a}{}，
% xeCJKfntef 的 \uline{}，siunitx 的 \numlist{}、\unit{}。
%
% 只列出与直接输入一致的组合。下列写法与直接输入仍不一致，与本修复无关，没有
% 列出（见 llmdoc/memory/doc-gaps.md）：
%   - 左侧是全角标点、右侧有空格（|，\cmd 文|），以前就如此；
%   - 左侧是汉字、右侧没有空格、命令之后是盒子、规则、标点等不检查 marker
%     的内容（|中\cmd\hbox{x}|），直接输入的汉字 marker 被盒子挡住，命令则
%     把它重放在盒子之前；
%   - 左侧是 |中{}|、|中\ |、命令之后紧接汉字（|中{} \cmd文|），直接输入保留
%     空格，命令的入口按汉字之后的空格处理；
%   - 左侧是公式、右侧是汉字；
%   - 左侧是西文、tabular 单元格末尾的 |A \mbox{} & B|（以及 \textcolor{red}{}、
%     transparent、box 命令）：命令留下的节点挡住 |l| 列模板末尾的 \unskip，
%     比删去命令的 |A  & B| 宽一枚空格。
% 这些组合在修复前后相同，或修复前也与直接输入不一致。
%
% 左侧以 |{ }| 这类写在分组里的空格结尾时（|中{ }\cmd 文|），修复前与直接
% 输入一致，现在少一枚空格：它在命令之前留下的节点列表与 |中{} \cmd 文|、
% |中\ \cmd 文| 相同，只能按后者处理。这是已接受的回退，见用户手册“CJK 文字
% 与命令交互时的间距”一节，这里不比较。
%
% 另外比较 #1103 审查中发现的写法：命令左侧紧贴 |~|、|\nobreakspace{}|（不是
% 源码空格，命令之后的空格不能删）；命令之后是 |{$y$}| 或 |\color{red}$y$|；
% \tn{color}；表格单元格末尾与 plain \tn{halign} 的 \tn{cr}、\tn{crcr}、
% \tn{span}，以及列模板以命令结尾（命令之后是 \tn{endtemplate}）；零尺寸但有
% 可见内容的盒子；\tn{discretionary} 的不断行文本；颜色正文以空格结尾；
% 正文里另有 \tn{color}、\tn{normalcolor} 的颜色命令；嵌套在颜色命令里的
% 空命令；替换文本以 |\outer...| 开头的普通宏；分组层数 0 的 \tn{color}；
% \tn{sbox} 夹在两个空命令之间。
%
% 空格与命令之间只有不排出内容的命令或空分组时（|A \sbox0{x}\mbox{} B|、
% |A {}\mbox{} B|），命令之前的节点列表与 |A \mbox{} B| 相同，按后者处理，比
% 直接输入少一枚空格。这同样写在用户手册里，这里不比较。
%
% 命令之后、下一个空命令之前还有未注册的命令时（|A \mbox{}\small\mbox{} B|），
% 无法预先知道它会不会排出内容，按排出内容处理，与修复前一样比直接输入多一枚
% 空格。这也写在用户手册里，这里只比较 \rule、\special 等确实排出内容的情形。

\documentclass{article}

\usepackage{xeCJK}
\usepackage{xcolor}
\usepackage{xeCJKfntef}
\usepackage{siunitx}
\usepackage{hyperref}

\setCJKmainfont{FandolSong-Regular.otf}
\setCJKmonofont{FandolFang-Regular.otf}

\newcommand\RegStream[1]{\leavevmode}
\newcommand\RegTrans[1]{\special{t}}
\newcommand\RegBox[1]{\hbox{}}
\newcommand\RegStreamBody[1]{#1}
\xeCJKsetup{
  experiment/boundary-register={command=\RegStream,strategy=stream},
  experiment/boundary-register={command=\RegTrans,strategy=transparent},
  experiment/boundary-register={command=\RegBox,strategy=box},
  experiment/boundary-register={command=\RegStreamBody,strategy=stream}}

\newbox\EmptyCandidate
\newbox\EmptyOracle
\newcount\EmptyChecks
\newcount\EmptyFailures

\ExplSyntaxOn
\cs_new_protected:Npn \EmptyReset
  {
    \tl_gclear:N \g__xeCJK_last_node_tl
    \bool_gset_false:N \g__xeCJK_glue_check_pending_bool
    \bool_gset_false:N \g__xeCJK_boundary_after_space_bool
  }
\cs_new:Npn \EmptyCaptureDepth
  { \int_use:N \g__xeCJK_boundary_capture_depth_int }
\ExplSyntaxOff

% #1 名称  #2 左侧  #3 命令  #4 右侧  #5 左空格  #6 右空格  #7 删去命令后的空格
% 作为参数传入的两个空格记号不会像源码里那样合并，所以 oracle 的空格单独给出：
% 两侧都有空格时只放一个，与源码 |中  文| 读出的记号相同。左侧以控制空格 |\ |
% 结尾时，源码里紧跟的空格会被跳过，用记号拼出的 oracle 却保留它，所以这类左侧
% 只比较两侧都有空格的写法。
\newcommand\EmptyVariant[7]{%
  \global\advance\EmptyChecks by 1
  \EmptyReset
  \setbox\EmptyCandidate=\hbox{#2#5#3#6#4}%
  \ifnum\EmptyCaptureDepth=0 \else
    \global\advance\EmptyFailures by 1
    \TYPE{FAIL: #1 left a nonzero capture depth}%
  \fi
  \EmptyReset
  \setbox\EmptyOracle=\hbox{#2#7#4}%
  \ifdim\wd\EmptyCandidate=\wd\EmptyOracle \else
    \global\advance\EmptyFailures by 1
    \TYPE{FAIL: #1 (\the\wd\EmptyCandidate\space vs \the\wd\EmptyOracle)}%
  \fi
}
% \EmptyMatrix{名称}{左侧}{命令}{右侧}：四种空格写法。
\newcommand\EmptyMatrix[4]{%
  \EmptyVariant{#1/00}{#2}{#3}{#4}{}{}{}%
  \EmptyVariant{#1/10}{#2}{#3}{#4}{ }{}{ }%
  \EmptyVariant{#1/01}{#2}{#3}{#4}{}{ }{ }%
  \EmptyVariant{#1/11}{#2}{#3}{#4}{ }{ }{ }%
}
% \EmptyBoth{名称}{左侧}{命令}{右侧}：只比较两侧都有空格的写法。
\newcommand\EmptyBoth[4]{%
  \EmptyVariant{#1/11}{#2}{#3}{#4}{ }{ }{ }%
}

\newcommand\EmptyForCommands[3]{% #1 名称前缀 #2 左侧 #3 右侧
  \EmptyMatrix{#1/stream}{#2}{\RegStream{}}{#3}%
  \EmptyMatrix{#1/transparent}{#2}{\RegTrans{}}{#3}%
  \EmptyMatrix{#1/box}{#2}{\RegBox{}}{#3}%
  \EmptyMatrix{#1/mbox}{#2}{\mbox{}}{#3}%
  \EmptyMatrix{#1/textcolor}{#2}{\textcolor{red}{}}{#3}%
  \EmptyMatrix{#1/hypertarget}{#2}{\hypertarget{a}{}}{#3}%
  \EmptyMatrix{#1/uline}{#2}{\uline{}}{#3}%
  \EmptyMatrix{#1/numlist}{#2}{\numlist{}}{#3}%
  \EmptyMatrix{#1/unit}{#2}{\unit{}}{#3}%
}
% \EmptyLeftForCommands：只比较左侧有空格的两种写法（10、11）。
\newcommand\EmptyLeft[4]{%
  \EmptyVariant{#1/10}{#2}{#3}{#4}{ }{}{ }%
  \EmptyVariant{#1/11}{#2}{#3}{#4}{ }{ }{ }%
}
\newcommand\EmptyLeftForCommands[3]{%
  \EmptyLeft{#1/stream}{#2}{\RegStream{}}{#3}%
  \EmptyLeft{#1/transparent}{#2}{\RegTrans{}}{#3}%
  \EmptyLeft{#1/box}{#2}{\RegBox{}}{#3}%
  \EmptyLeft{#1/mbox}{#2}{\mbox{}}{#3}%
  \EmptyLeft{#1/textcolor}{#2}{\textcolor{red}{}}{#3}%
  \EmptyLeft{#1/hypertarget}{#2}{\hypertarget{a}{}}{#3}%
  \EmptyLeft{#1/uline}{#2}{\uline{}}{#3}%
  \EmptyLeft{#1/numlist}{#2}{\numlist{}}{#3}%
  \EmptyLeft{#1/unit}{#2}{\unit{}}{#3}%
  \EmptyLeft{#1/color}{#2}{\color{red}}{#3}%
}
\newcommand\EmptyBothForCommands[3]{%
  \EmptyBoth{#1/stream}{#2}{\RegStream{}}{#3}%
  \EmptyBoth{#1/transparent}{#2}{\RegTrans{}}{#3}%
  \EmptyBoth{#1/box}{#2}{\RegBox{}}{#3}%
  \EmptyBoth{#1/mbox}{#2}{\mbox{}}{#3}%
  \EmptyBoth{#1/textcolor}{#2}{\textcolor{red}{}}{#3}%
  \EmptyBoth{#1/hypertarget}{#2}{\hypertarget{a}{}}{#3}%
  \EmptyBoth{#1/uline}{#2}{\uline{}}{#3}%
  \EmptyBoth{#1/numlist}{#2}{\numlist{}}{#3}%
  \EmptyBoth{#1/unit}{#2}{\unit{}}{#3}%
}

\newcommand\EmptyRunAll{%
  % 两侧都有空格：入口前是什么都只保留一枚空格。
  \EmptyBothForCommands{C-C}{中}{文}%
  \EmptyBothForCommands{C-L}{中}{B}%
  \EmptyBothForCommands{C-math}{中}{$y$}%
  \EmptyBothForCommands{C-hbox}{中}{\hbox{x}}%
  \EmptyBothForCommands{C-punct}{中}{，}%
  \EmptyBothForCommands{C-leftparen}{中}{（文}%
  \EmptyBothForCommands{C-kern}{中}{\kern1pt 文}%
  \EmptyBothForCommands{C-tie}{中}{~文}%
  \EmptyBothForCommands{C-textbf}{中}{\textbf{文}}%
  \EmptyBothForCommands{L-C}{A}{文}%
  \EmptyBothForCommands{L-hbox}{A}{\hbox{x}}%
  \EmptyBothForCommands{math-L}{$x$}{B}%
  \EmptyBothForCommands{math-hbox}{$x$}{\hbox{x}}%
  \EmptyBothForCommands{group-C}{中{}}{文}%
  \EmptyBothForCommands{ctrl-C}{中\ }{文}%
  \EmptyBothForCommands{ctrl-kern}{中\ }{\kern1pt 文}%
  % 四种写法都与直接输入一致的组合。
  \EmptyForCommands{groupC-C}{{中}}{文}%
  \EmptyForCommands{groupC-L}{{中}}{B}%
  \EmptyForCommands{groupC-math}{{中}}{$y$}%
  \EmptyForCommands{groupC-punct}{{中}}{，}%
  \EmptyForCommands{mboxC-C}{\mbox{中}}{文}%
  \EmptyForCommands{mboxC-hbox}{\mbox{中}}{\hbox{x}}%
  \EmptyForCommands{mboxL-C}{\mbox{A}}{文}%
  \EmptyForCommands{mboxL-L}{\mbox{A}}{B}%
  \EmptyForCommands{L-L}{A}{B}%
  \EmptyForCommands{L-math}{A}{$y$}%
  \EmptyForCommands{L-punct}{A}{，}%
  \EmptyForCommands{group-hbox}{中{}}{\hbox{x}}%
  % 左侧紧贴 ~、\nobreakspace{}：命令之前的 glue 不是源码空格。
  \EmptyForCommands{tie-C}{中~}{文}%
  \EmptyForCommands{tie-L}{中~}{B}%
  \EmptyForCommands{tie-math}{中~}{$y$}%
  \EmptyForCommands{tie-hbox}{中~}{\hbox{x}}%
  \EmptyForCommands{Ltie-L}{A~}{B}%
  \EmptyForCommands{nbsp-C}{中\nobreakspace{}}{文}%
  % 命令之后是花括号或颜色命令。
  \EmptyForCommands{C-groupC}{中}{{文}}%
  \EmptyForCommands{C-colorC}{中}{\color{red}文}%
  \EmptyForCommands{groupC-colorC}{{中}}{\color{red}文}%
  \EmptyLeftForCommands{C-groupmath}{中}{{$y$}}%
  \EmptyLeftForCommands{C-colormath}{中}{\color{red}$y$}%
  % 上一组的 oracle 也含 \color；\color 本身在公式之前丢失间距时两边一起出错，
  % 所以单独与不含颜色命令的直接输入比较（中 \color{red}$y$ 与 中 $y$ 等宽）。
  \EmptyVariant{color-math-direct/10}{中}{\color{red}}{$y$}{ }{}{ }%
  \EmptyVariant{color-math-direct/11}{中}{\color{red}}{$y$}{ }{ }{ }%
  % \color 本身：没有可见输出，不是盒子。
  \EmptyMatrix{C-C/color}{中}{\color{red}}{文}%
  \EmptyMatrix{C-groupC/color}{中}{\color{red}}{{文}}%
  \EmptyLeft{groupC-math/color}{{中}}{\color{red}}{$y$}%
}

\begin{document}

% 抄录用的 CJK 等宽字体在 \START 之前加载，fontspec 的信息不进入 .tlg。
\setbox0=\hbox{\ttfamily 中}

\START

% 分组层数 0 的颜色命令：不在 \textcolor 里时，颜色推入命令不读写来源编号的
% 存放变量（以前读取未定义的 \g__xeCJK_boundary_color_origin_-1_tl，报
% Erroneous variable）。\TEST 自己开一个分组，所以写在外面。
\color{red}\normalcolor

% 字体预热。
\setbox0=\hbox{中文AB$x$\uline{中}\numlist{1;2}\unit{kg}\textcolor{red}{中}}

\TEST{package-default glue, xCJKecglue=false}{
  \begingroup
    \xeCJKsetup{xCJKecglue=false}
    \EmptyRunAll
  \endgroup
}

\TEST{package-default glue, xCJKecglue=true}{
  \begingroup
    \xeCJKsetup{xCJKecglue=true}
    \EmptyRunAll
  \endgroup
}

\xeCJKsetup{CJKecglue={\hskip 5pt},CJKglue={\hskip 1pt}}

\TEST{distinguishing glue, xCJKecglue=false}{
  \begingroup
    \xeCJKsetup{xCJKecglue=false}
    \EmptyRunAll
  \endgroup
}

\TEST{distinguishing glue, xCJKecglue=true}{
  \begingroup
    \xeCJKsetup{xCJKecglue=true}
    \EmptyRunAll
  \endgroup
}

% \phantomsection 不带参数，命令名之后的源码空格在读取控制序列名时就被跳过；
% 这里写成 \phantomsection{}，删去命令后的直接输入是 |A {} 文|。
\TEST{phantomsection followed by an empty group}{
  \setbox\EmptyCandidate=\hbox{A \phantomsection{} 文}%
  \setbox\EmptyOracle=\hbox{A {} 文}%
  \global\advance\EmptyChecks by 1
  \ifdim\wd\EmptyCandidate=\wd\EmptyOracle \else
    \global\advance\EmptyFailures by 1
    \TYPE{FAIL: phantomsection (\the\wd\EmptyCandidate\space vs \the\wd\EmptyOracle)}%
  \fi
}

% 表格单元格末尾：命令之后删去空格时不能越过 & 与 \\，以前报
% |Extra alignment tab|。
\TEST{empty command at the end of a tabular cell}{
  \EmptyReset
  \setbox\EmptyCandidate=\hbox{%
    \begin{tabular}{ll}
      中 \mbox{} & 文 \\
      中 \textcolor{red}{} & 文 \\
      中 \hypertarget{t}{} & 文 \\
      中 \uline{} & 文 \\
      中 \unit{} \\
    \end{tabular}}%
  \EmptyReset
  \setbox\EmptyOracle=\hbox{%
    \begin{tabular}{ll}
      中  & 文 \\
      中  & 文 \\
      中  & 文 \\
      中  & 文 \\
      中  \\
    \end{tabular}}%
  \global\advance\EmptyChecks by 1
  \ifdim\wd\EmptyCandidate=\wd\EmptyOracle \else
    \global\advance\EmptyFailures by 1
    \TYPE{FAIL: tabular (\the\wd\EmptyCandidate\space vs \the\wd\EmptyOracle)}%
  \fi
}

% 左侧是西文的 tabular 单元格：命令之后的空格被删去，下一个记号是 |&| 或
% |\\|。以前报 Extra alignment tab has been changed to \cr。每个命令单独排一张
% 表，宽度不受其他行影响。|l| 列模板末尾的 \unskip 只删去单元格末尾的空格；
% \mbox{}、\textcolor{red}{}、transparent、box 命令留下的节点挡住它，比较对象是
% 命令之后不写空格的同一行；其他命令不留节点，比较对象是删去命令的直接输入。
\newcommand\EmptyTabCell[3]{% #1 名称 #2 候选的一行 #3 比较对象的一行
  \global\advance\EmptyChecks by 1
  \EmptyReset
  \setbox\EmptyCandidate=\hbox{\begin{tabular}{ll}#2\end{tabular}}%
  \EmptyReset
  \setbox\EmptyOracle=\hbox{\begin{tabular}{ll}#3\end{tabular}}%
  \ifdim\wd\EmptyCandidate=\wd\EmptyOracle \else
    \global\advance\EmptyFailures by 1
    \TYPE{FAIL: #1 (\the\wd\EmptyCandidate\space vs \the\wd\EmptyOracle)}%
  \fi
}
\TEST{empty command after a latin letter at the end of a tabular cell}{
  \EmptyTabCell{tab-latin-mbox}{A \mbox{} & B \\}{A \mbox{}& B \\}%
  \EmptyTabCell{tab-latin-textcolor}{A \textcolor{red}{} & B \\}{A \textcolor{red}{}& B \\}%
  \EmptyTabCell{tab-latin-trans}{A \RegTrans{} & B \\}{A \RegTrans{}& B \\}%
  \EmptyTabCell{tab-latin-box}{A \RegBox{} & B \\}{A \RegBox{}& B \\}%
  \EmptyTabCell{tab-latin-hypertarget}{A \hypertarget{t2}{} & B \\}{A  & B \\}%
  \EmptyTabCell{tab-latin-uline}{A \uline{} & B \\}{A  & B \\}%
  \EmptyTabCell{tab-latin-unit}{A \unit{} & B \\}{A  & B \\}%
  \EmptyTabCell{tab-latin-numlist}{A \numlist{} & B \\}{A  & B \\}%
  \EmptyTabCell{tab-latin-stream}{A \RegStream{} \\}{A  \\}%
}

% plain \halign：命令之后紧跟 \cr、\crcr、\span 时，不能在 align-safe 分组之外
% 把它当作宏参数读取，以前报 |Forbidden control sequence|。
\newcommand\EmptyAlign[3]{% #1 名称 #2 候选 #3 删去命令后的直接输入
  \global\advance\EmptyChecks by 1
  \EmptyReset
  \setbox\EmptyCandidate=\vbox{\halign{##&##\cr #2}}%
  \EmptyReset
  \setbox\EmptyOracle=\vbox{\halign{##&##\cr #3}}%
  \ifdim\wd\EmptyCandidate=\wd\EmptyOracle \else
    \global\advance\EmptyFailures by 1
    \TYPE{FAIL: #1 (\the\wd\EmptyCandidate\space vs \the\wd\EmptyOracle)}%
  \fi
}
\TEST{empty command before cr, crcr and span in halign}{
  \EmptyAlign{cr-mbox}{中 \mbox{}\cr}{中 \cr}%
  \EmptyAlign{cr-stream}{中 \RegStream{}\cr}{中 \cr}%
  \EmptyAlign{cr-trans}{中 \RegTrans{}\cr}{中 \cr}%
  \EmptyAlign{cr-textcolor}{中 \textcolor{red}{}\cr}{中 \cr}%
  \EmptyAlign{cr-unit}{中 \unit{}\cr}{中 \cr}%
  \EmptyAlign{cr-hypertarget}{中 \hypertarget{a}{}\cr}{中 \cr}%
  \EmptyAlign{cr-latin}{A \mbox{}\cr}{A \cr}%
  \EmptyAlign{crcr-mbox}{中 \mbox{}\crcr}{中 \crcr}%
  \EmptyAlign{span-mbox}{中 \mbox{}\span 文\cr}{中 \span 文\cr}%
  \EmptyAlign{cr-space-mbox}{中 \mbox{} \cr}{中  \cr}%
  % 左侧是西文、命令之后有空格：删去空格之后清除 \l_peek_token 时，下一个
  % 记号是对齐记号，清除也必须在 align-safe 分组之内，否则 TeX 插入列模板的
  % 结尾，报 Missing control sequence inserted。
  \EmptyAlign{amp-space-latin}{A \mbox{} &C\cr}{A  &C\cr}%
  \EmptyAlign{cr-space-latin}{A \mbox{} \cr}{A  \cr}%
  \EmptyAlign{crcr-space-latin}{A \mbox{} \crcr}{A  \crcr}%
  \EmptyAlign{span-space-latin}{A \mbox{} \span C\cr}{A  \span C\cr}%
  \EmptyAlign{amp-space-textcolor}{A \textcolor{red}{} &C\cr}{A  &C\cr}%
  \EmptyAlign{amp-space-uline}{A \uline{} &C\cr}{A  &C\cr}%
}
% 列模板以命令结尾时，命令之后是 TeX 插入的 \endtemplate（\outer 记号），以前报
% |Forbidden control sequence|。直接输入 |中 | 之后的空格由单元格结尾删去。
\newcommand\EmptyTemplate[2]{% #1 名称 #2 模板末尾的命令
  \global\advance\EmptyChecks by 1
  \def\EmptyTemplateCmd{#2}%
  \EmptyReset
  \setbox\EmptyCandidate=\vbox{\halign{##\EmptyTemplateCmd\cr 中 \cr}}%
  \EmptyReset
  \setbox\EmptyOracle=\vbox{\halign{##\cr 中 \cr}}%
  \ifdim\wd\EmptyCandidate=\wd\EmptyOracle \else
    \global\advance\EmptyFailures by 1
    \TYPE{FAIL: #1 (\the\wd\EmptyCandidate\space vs \the\wd\EmptyOracle)}%
  \fi
}
\TEST{empty command at the end of an halign template}{
  \EmptyTemplate{tmpl-mbox}{\mbox{}}%
  \EmptyTemplate{tmpl-stream}{\RegStream{}}%
  \EmptyTemplate{tmpl-textcolor}{\textcolor{red}{}}%
  \EmptyTemplate{tmpl-unit}{\unit{}}%
  \EmptyTemplate{tmpl-hypertarget}{\hypertarget{z}{}}%
  \EmptyTemplate{tmpl-uline}{\uline{}}%
  % 命令之后还有一枚空格：删去空格之后再看下一个记号时遇到 \endtemplate。
  \EmptyTemplate{tmpl-mbox-space}{\mbox{} }%
}

% \outer 宏：\long\outer、\protected\outer、\protected\long\outer 的含义以
% \long、\protected 开头，只看开头会漏掉，以前报 |Forbidden control sequence|。直接输入 |中 \EmptyOuterA|
% 在 xeCJK 汉字之后的前视里同样报错（修复前就如此，见 doc-gaps），所以比较对象
% 写成宽度相同的 |中 |。\outer 宏不能出现在宏参数里，所以用 \BEGINTEST/\ENDTEST。
\outer\def\EmptyOuterA{}
\long\outer\def\EmptyOuterB{}
\protected\outer\def\EmptyOuterC{}
\protected\long\outer\def\EmptyOuterD{}
\BEGINTEST{empty command followed by an outer macro}
  \EmptyReset
  \setbox\EmptyCandidate=\hbox{中 \mbox{}\EmptyOuterA}%
  \EmptyReset
  \setbox\EmptyOracle=\hbox{中 }%
  \global\advance\EmptyChecks by 1
  \ifdim\wd\EmptyCandidate=\wd\EmptyOracle \else
    \global\advance\EmptyFailures by 1
    \TYPE{FAIL: outer-A}%
  \fi
  \EmptyReset
  \setbox\EmptyCandidate=\hbox{中 \mbox{}\EmptyOuterB}%
  \global\advance\EmptyChecks by 1
  \ifdim\wd\EmptyCandidate=\wd\EmptyOracle \else
    \global\advance\EmptyFailures by 1
    \TYPE{FAIL: outer-B}%
  \fi
  \EmptyReset
  \setbox\EmptyCandidate=\hbox{中 \mbox{}\EmptyOuterC}%
  \global\advance\EmptyChecks by 1
  \ifdim\wd\EmptyCandidate=\wd\EmptyOracle \else
    \global\advance\EmptyFailures by 1
    \TYPE{FAIL: outer-C}%
  \fi
  \EmptyReset
  \setbox\EmptyCandidate=\hbox{中 \mbox{}\EmptyOuterD}%
  \global\advance\EmptyChecks by 1
  \ifdim\wd\EmptyCandidate=\wd\EmptyOracle \else
    \global\advance\EmptyFailures by 1
    \TYPE{FAIL: outer-D}%
  \fi
  \EmptyReset
  \setbox\EmptyCandidate=\hbox{中 \color{red}\EmptyOuterB}%
  \global\advance\EmptyChecks by 1
  \ifdim\wd\EmptyCandidate=\wd\EmptyOracle \else
    \global\advance\EmptyFailures by 1
    \TYPE{FAIL: outer-color}%
  \fi
  % \outer 宏之后还有文字：认出 \outer 记号之后 \l_peek_token 仍等同于它，
  % 后面字符触发的 interchar 代码把 \l_peek_token 写在宏参数里，以前报
  % Forbidden control sequence。删去命令之后的空格时同样如此。比较对象是删去
  % 命令的直接输入；左侧是汉字时直接输入 |中 \EmptyOuterC 文| 在汉字之后的前视里
  % 报错（见上），改用宽度相同的 |中 \relax 文|。
  \EmptyReset
  \setbox\EmptyCandidate=\hbox{A \mbox{}\EmptyOuterA B}%
  \EmptyReset
  \setbox\EmptyOracle=\hbox{A \EmptyOuterA B}%
  \global\advance\EmptyChecks by 1
  \ifdim\wd\EmptyCandidate=\wd\EmptyOracle \else
    \global\advance\EmptyFailures by 1
    \TYPE{FAIL: outer-text-L}%
  \fi
  \EmptyReset
  \setbox\EmptyCandidate=\hbox{A \mbox{} \EmptyOuterD B}%
  \global\advance\EmptyChecks by 1
  \ifdim\wd\EmptyCandidate=\wd\EmptyOracle \else
    \global\advance\EmptyFailures by 1
    \TYPE{FAIL: outer-space-L}%
  \fi
  \EmptyReset
  \setbox\EmptyCandidate=\hbox{A \textcolor{red}{}\EmptyOuterB B}%
  \global\advance\EmptyChecks by 1
  \ifdim\wd\EmptyCandidate=\wd\EmptyOracle \else
    \global\advance\EmptyFailures by 1
    \TYPE{FAIL: outer-text-tc}%
  \fi
  \EmptyReset
  \setbox\EmptyCandidate=\hbox{中 \mbox{}\EmptyOuterC 文}%
  \EmptyReset
  \setbox\EmptyOracle=\hbox{中 \relax 文}%
  \global\advance\EmptyChecks by 1
  \ifdim\wd\EmptyCandidate=\wd\EmptyOracle \else
    \global\advance\EmptyFailures by 1
    \TYPE{FAIL: outer-text-C}%
  \fi
\ENDTEST

% 颜色正文以空格结尾：\reset@color 在分组结束之后执行，入口取下的是分组里的
% 空格，不是命令左侧的源码空格，命令之后的空格要保留。比较对象是删去颜色命令、
% 保留分组的直接输入。
\newcommand\EmptyColorTail[3]{% #1 名称 #2 候选 #3 直接输入
  \global\advance\EmptyChecks by 1
  \EmptyReset
  \setbox\EmptyCandidate=\hbox{#2}%
  \EmptyReset
  \setbox\EmptyOracle=\hbox{#3}%
  \ifdim\wd\EmptyCandidate=\wd\EmptyOracle \else
    \global\advance\EmptyFailures by 1
    \TYPE{FAIL: #1 (\the\wd\EmptyCandidate\space vs \the\wd\EmptyOracle)}%
  \fi
}
\newcommand\EmptyColorTailAll{%
  \EmptyColorTail{tc-tail-L}{\textcolor{red}{A } B}{{A } B}%
  \EmptyColorTail{color-tail-L}{{\color{red}red } text}{{red } text}%
  \EmptyColorTail{color-tail-C}{{\color{red}A } 中}{{A } 中}%
  \EmptyColorTail{tc-tail-ctrl}{\textcolor{red}{A\ } B}{{A\ } B}%
  \EmptyColorTail{tc-tail-math}{\textcolor{red}{A } $y$}{{A } $y$}%
  \EmptyColorTail{tc-tail-tie}{\textcolor{red}{A } ~B}{{A } ~B}%
  \EmptyColorTail{tc-tail-uline}{\uline{\textcolor{red}{A } B}}{\uline{{A } B}}%
  \EmptyColorTail{tc-empty-C}{中 \textcolor{red}{} 文}{中  文}%
  \EmptyColorTail{tc-empty-L}{A \textcolor{red}{} B}{A  B}%
  % 正文为空的颜色命令里嵌套空命令：内层命令的记录交给颜色命令，再交给外层。
  \EmptyColorTail{tc-tc-C}{中 \textcolor{red}{\textcolor{blue}{}} 文}{中  文}%
  \EmptyColorTail{tc-uline-C}{中 \textcolor{red}{\uline{}} 文}{中  文}%
  \EmptyColorTail{tc-xout-C}{中 \textcolor{red}{\xout{}} 文}{中  文}%
  \EmptyColorTail{tc-uwave-C}{中 \textcolor{red}{\uwave{}} 文}{中  文}%
  \EmptyColorTail{tc-uuline-C}{中 \textcolor{red}{\uuline{}} 文}{中  文}%
  \EmptyColorTail{tc-dashuline-C}{中 \textcolor{red}{\dashuline{}} 文}{中  文}%
  \EmptyColorTail{tc-dotuline-C}{中 \textcolor{red}{\dotuline{}} 文}{中  文}%
  \EmptyColorTail{tc-xout-L}{A \textcolor{red}{\xout{}} B}{A  B}%
  \EmptyColorTail{tc-uline-empty-L}{A \textcolor{red}{\uline{}} B}{A  B}%
  % 颜色正文以“空格 + 空命令”结尾：内层命令记下的入口空格在正文里，颜色弹出
  % 命令不能把它交给外层。|\textcolor{red}{中 \mbox{}} 文| 修复前后都多一枚
  % 空格，不在这里比较（见 doc-gaps）。
  \EmptyColorTail{tc-mbox-L}{\textcolor{red}{A \mbox{}} B}{{A } B}%
  \EmptyColorTail{color-mbox-L}{{\color{red}A \mbox{}} B}{{A } B}%
  \EmptyColorTail{tc-tc-L}{\textcolor{red}{A \textcolor{blue}{}} B}{{A } B}%
  \EmptyColorTail{tc-ht-L}{\textcolor{red}{A \hypertarget{x}{}} B}{{A } B}%
  \EmptyColorTail{tc-ps-L}{\textcolor{red}{A \phantomsection} B}{{A } B}%
  \EmptyColorTail{tc-unit-L}{\textcolor{red}{A \unit{}} B}{{A } B}%
  \EmptyColorTail{tc-uline-L}{\textcolor{red}{A \uline{}} B}{{A } B}%
  \EmptyColorTail{ul-tc-mbox-L}{\uline{\textcolor{red}{A \mbox{}} B}}{\uline{{A } B}}%
  % 正文里另有颜色命令：颜色弹出命令只转交与 \textcolor 自己的推入命令配对的
  % 记录，正文里的 \color、\normalcolor 不能替换它。
  \EmptyColorTail{tc-color-L}{\textcolor{red}{A \color{blue}} B}{{A } B}%
  \EmptyColorTail{tc-color-mbox-L}{\textcolor{red}{A \color{blue}\mbox{}} B}{{A } B}%
  \EmptyColorTail{tc-normal-L}{\textcolor{red}{A \normalcolor} B}{{A } B}%
  % 用户自己写的分组：删去颜色命令后分组还在，两枚空格都保留。
  \EmptyColorTail{group-color-L}{A {\color{red}} B}{A {} B}%
}
\TEST{color body ending with a space}{
  \begingroup \xeCJKsetup{xCJKecglue=false} \EmptyColorTailAll \endgroup
  \begingroup \xeCJKsetup{xCJKecglue=true} \EmptyColorTailAll \endgroup
}

% 替换文本以 |\outer...| 开头的普通宏不是 \outer 宏，命令之后照常检查：展开
% 它，记录交给外层的颜色命令。误判为 \outer 宏时记录作废，颜色命令之后多一枚
% 空格。
\def\EmptyNotOuter{\outerEmpty}
\def\outerEmpty{}
\TEST{empty command followed by a macro whose text starts with outer}{
  \EmptyColorTail{not-outer-C}{中 \textcolor{red}{\mbox{}\EmptyNotOuter} 文}{中  文}%
  \EmptyColorTail{not-outer-L}{A \textcolor{red}{\mbox{}\EmptyNotOuter} B}{A  B}%
  \EmptyColorTail{not-outer-tail}{中 \textcolor{red}{\mbox{}\EmptyNotOuter}}{中 }%
}

% \sbox 夹在两个空命令之间：\sbox 结束时恢复了暂停之前的记录，第二个命令之后
% 不能再删去第一个命令之后的空格。xCJKecglue=true 时第一个 \mbox{} 不在列表里
% 留下节点，第二个命令之前的列表与 |A \sbox0{x}\mbox{} B| 相同，属于用户手册
% 说明的无法区分的写法，这里只比较 xCJKecglue=false。
\newsavebox\EmptySaveBox
\newcommand\EmptyGobble[1]{}
\TEST{sbox between empty commands}{
  \xeCJKsetup{xCJKecglue=false}%
  \EmptyColorTail{mbox-sbox-mbox}{A \mbox{}\sbox0{x}\mbox{} B}{A \sbox0{x} B}%
  \EmptyColorTail{mbox-sbox-tc}{A \mbox{}\sbox0{x}\textcolor{red}{} B}{A \sbox0{x} B}%
  \EmptyColorTail{mbox-savebox-mbox}{A \mbox{}\savebox\EmptySaveBox{x}\mbox{} B}{A \savebox\EmptySaveBox{x} B}%
  \EmptyColorTail{mbox-sbox-uline}{A \mbox{}\sbox0{}\uline{} B}{A \sbox0{} B}%
  % 带参数的用户宏展开时连参数一起吃掉，按可能排出内容处理，第二个命令之后的
  % 空格保留。xCJKecglue=true 时同样属于上面说的无法区分的写法。
  \EmptyColorTail{mbox-usehook-mbox}{A \mbox{}\UseHook{empty/hook}\mbox{} B}{A \UseHook{empty/hook} B}%
  \EmptyColorTail{mbox-gobble-mbox}{A \mbox{}\EmptyGobble{x}\mbox{} B}{A \EmptyGobble{x} B}%
}

% 空命令之后紧跟 \rule、\special 等可能排出内容的命令时，记录不能留给后面
% 左侧没有源码空格的空命令：\rule 排出的盒子与 \mbox{} 的空盒子让列表末尾的
% 状态相同。记录也不能越过盒子与段落（#2 先排出、丢弃，再排 #3）。已注册命令、
% 展开后为空的宏之间仍然交接。
\newcommand\EmptyStale[4]{% #1 名称 #2 先排出的内容 #3 候选 #4 直接输入
  \global\advance\EmptyChecks by 1
  \EmptyReset
  \setbox\EmptyCandidate=\vbox{#2}%
  \setbox\EmptyCandidate=\hbox{#3}%
  \EmptyReset
  \setbox\EmptyOracle=\hbox{#4}%
  \ifdim\wd\EmptyCandidate=\wd\EmptyOracle \else
    \global\advance\EmptyFailures by 1
    \TYPE{FAIL: #1 (\the\wd\EmptyCandidate\space vs \the\wd\EmptyOracle)}%
  \fi
}
\def\EmptyNop{}
\newcommand\EmptyId[1]{#1}
\def\EmptySp{ }
\def\EmptyFoo{X}
\newtoks\EmptySpaceToks \EmptySpaceToks={ }
\newcommand\EmptyIfMbox[1]{\ifhmode\mbox{}\fi}
\NewDocumentCommand\EmptyNDNop{}{}
\makeatletter\def\EmptyAtEmpty{\@empty}\makeatother
\makeatletter\def\EmptyHbxt{\hb@xt@1pt{}}\makeatother
% \obeyspaces 之下的空格是活动字符，等同于 \space。取活动空格的名字会读走后面的
% 记号，所以先定义好宏，再在比较里使用。
\begingroup\obeyspaces%
\gdef\EmptyObeyMbox{A \mbox{} B}\gdef\EmptyObeyMboxC{中 \mbox{} 文}%
\gdef\EmptyObeyTc{中 \textcolor{red}{} 文}\gdef\EmptyObeyMboxMbox{A \mbox{}\mbox{} B}%
\gdef\EmptyObeyColor{A \color{red} B}\gdef\EmptyObeyColorD{A \ignorespaces B}%
\gdef\EmptyObeyL{A  B}\gdef\EmptyObeyC{中  文}%
\endgroup
% 活动空格等同于控制空格（不可展开）时同样不取名字。活动空格的含义在使用时
% 才查，LaTeX 全局把它定义为 \space，所以用 \EmptyObeyLet 在比较的分组里改。
\begingroup\obeyspaces%
\gdef\EmptyObeyLet{\let =\ }%
\gdef\EmptyObeyLetMbox{A \mbox{} B}\gdef\EmptyObeyLetTc{中 \textcolor{red}{} 文}%
\gdef\EmptyObeyLetColor{A \color{red} B}\gdef\EmptyObeyLetColorD{A \ignorespaces B}%
\gdef\EmptyObeyLetL{A  B}\gdef\EmptyObeyLetC{中  文}%
\endgroup
\newcommand\EmptyStaleAll{%
  \EmptyColorTail{rule-mbox}{A \mbox{}\rule{2pt}{1pt}\mbox{} B}{A \rule{2pt}{1pt} B}%
  \EmptyColorTail{rule-tc}{A \mbox{}\rule{2pt}{1pt}\textcolor{red}{} B}{A \rule{2pt}{1pt} B}%
  \EmptyColorTail{rule-ht}{A \mbox{}\rule{2pt}{1pt}\hypertarget{s}{} B}{A \rule{2pt}{1pt} B}%
  \EmptyColorTail{rule-uline}{A \mbox{}\rule{2pt}{1pt}\uline{} B}{A \rule{2pt}{1pt} B}%
  \EmptyColorTail{rule-makebox}{A \makebox[0pt]{}\rule{2pt}{1pt}\makebox[0pt]{} B}{A \rule{2pt}{1pt} B}%
  \EmptyColorTail{rule-rule}{A \mbox{}\rule{1em}{1ex}\rule{1em}{1ex}\mbox{} B}{A \rule{1em}{1ex}\rule{1em}{1ex} B}%
  \EmptyColorTail{special-tc}{A \textcolor{red}{}\special{x}\textcolor{blue}{} B}{A \special{x} B}%
  \EmptyColorTail{special-mbox}{A \textcolor{red}{}\special{x}\mbox{} B}{A \special{x} B}%
  \EmptyColorTail{brace-rule}{A \mbox{}{\rule{2pt}{1pt}}\mbox{} B}{A {\rule{2pt}{1pt}} B}%
  \EmptyColorTail{group-rule}{A {\mbox{}}\rule{2pt}{1pt}\mbox{} B}{A {}\rule{2pt}{1pt} B}%
  \EmptyColorTail{textbf-rule}{A \mbox{}\textbf{\rule{2pt}{1pt}}\mbox{} B}{A \textbf{\rule{2pt}{1pt}} B}%
  \EmptyColorTail{tc-rule-C}{中 \textcolor{red}{\mbox{}\rule{1pt}{1pt}} 文}{中 \textcolor{red}{\rule{1pt}{1pt}} 文}%
  \EmptyColorTail{tc-special-C}{中 \textcolor{red}{\special{x}\mbox{}} 文}{中 \textcolor{red}{\special{x}} 文}%
  \EmptyStale{hbox-hbox}{\hbox{A \mbox{}\rule{1pt}{1pt}}}{\rule{1pt}{1pt}\mbox{} B}{\rule{1pt}{1pt} B}%
  \EmptyStale{par-hbox}{\noindent A \mbox{}\rule{1pt}{1pt}\par}{\rule{1pt}{1pt}\mbox{} B}{\rule{1pt}{1pt} B}%
  \EmptyColorTail{mbox-mbox-L}{A \mbox{}\mbox{} B}{A  B}%
  \EmptyColorTail{mbox-mbox-mbox-C}{中 \mbox{}\mbox{}\mbox{} 文}{中  文}%
  \EmptyColorTail{mbox-tc-L}{A \mbox{}\textcolor{red}{} B}{A  B}%
  \EmptyColorTail{tc-mbox-L}{A \textcolor{red}{}\mbox{} B}{A  B}%
  \EmptyColorTail{tc-tc-seq-C}{中 \textcolor{red}{}\textcolor{blue}{} 文}{中  文}%
  \EmptyColorTail{tc-mbox-mbox-C}{中 \textcolor{red}{\mbox{}\mbox{}} 文}{中  文}%
  \EmptyColorTail{nop-C}{中 \mbox{}\EmptyNop\mbox{} 文}{中  文}%
  \EmptyColorTail{nop-L}{A \mbox{}\EmptyNop\mbox{} B}{A  B}%
  \EmptyColorTail{tc-nop-C}{中 \textcolor{red}{\mbox{}\EmptyNop} 文}{中  文}%
  % hyperref 的命令之后还有宏包自己的代码（\fi、\UseHookWithArguments），它们
  % 不是用户的宏，不能当作“可能排出内容”。
  \EmptyColorTail{tc-ht-C}{中 \textcolor{red}{\hypertarget{h}{}} 文}{中  文}%
  \EmptyColorTail{tc-ht-L}{A \textcolor{red}{\hypertarget{h}{}} B}{A  B}%
  \EmptyColorTail{tc-ps-C}{中 \textcolor{red}{\phantomsection} 文}{中  文}%
  \EmptyColorTail{tc-ps-L}{A \textcolor{red}{\phantomsection} B}{A  B}%
  \EmptyColorTail{ps-mbox-L}{A \phantomsection\mbox{} B}{A  B}%
  \EmptyColorTail{ps-tc-L}{A \phantomsection\textcolor{red}{} B}{A  B}%
  \EmptyColorTail{ps-ht-L}{A \phantomsection\hypertarget{h}{} B}{A  B}%
  \EmptyColorTail{ps-uline-L}{A \phantomsection\uline{} B}{A  B}%
  \EmptyColorTail{ps-rule-L}{A \phantomsection\rule{2pt}{1pt}\mbox{} B}{A \rule{2pt}{1pt} B}%
  % \color 以 \ignorespaces 结尾，之后的用户宏展开后紧跟 $：展开得到的 $ 不在
  % 源码里紧跟命令，不补公式前的间距。\EmptyId 的含义与 xeCJK 前视时认出的
  % 恒等宏相同，直接输入会越过它看 $，这里同样补。
  \EmptyColorTail{color-nop-math}{中 \color{red}\EmptyNop $x$}{中 \EmptyNop $x$}%
  \EmptyColorTail{color-nop-brace}{中 \color{red}\EmptyNop{$x$}}{中 \EmptyNop{$x$}}%
  \EmptyColorTail{mbox-nop-math}{中 \mbox{}\EmptyNop $x$}{中 \EmptyNop $x$}%
  \EmptyColorTail{mbox-id-math}{中 \mbox{}\EmptyId{$x$}}{中 \EmptyId{$x$}}%
  \EmptyColorTail{color-id-math}{中 \color{red}\EmptyId{$x$}}{中 \EmptyId{$x$}}%
  % 用户直接写的 \csname、\expandafter、\ifhmode 等可展开原语照常展开，展开
  % 后排出 \rule、\special 时记录不能留给后面的命令。
  \EmptyColorTail{csname-rule}{A \mbox{}\csname rule\endcsname{2pt}{1pt}\mbox{} B}{A \csname rule\endcsname{2pt}{1pt} B}%
  \EmptyColorTail{csname-rule-tc}{A \mbox{}\csname rule\endcsname{2pt}{1pt}\textcolor{red}{} B}{A \csname rule\endcsname{2pt}{1pt} B}%
  \EmptyColorTail{expandafter-rule}{A \mbox{}\expandafter\rule\expandafter{\romannumeral0 2pt}{1pt}\mbox{} B}{A \expandafter\rule\expandafter{\romannumeral0 2pt}{1pt} B}%
  \EmptyColorTail{tc-csname-special}{A \textcolor{red}{\csname relax\endcsname\special{x}} B}{A {\special{x}} B}%
  \EmptyColorTail{tc-ifhmode-special}{A \textcolor{red}{\ifhmode\special{x}\fi} B}{A {\ifhmode\special{x}\fi} B}%
  % 颜色正文以用户宏加公式开头、以公式结尾：命令有可见输出，入口空格照常放回。
  \EmptyColorTail{tc-nop-math-L}{A \textcolor{red}{\EmptyNop $x$} B}{A {\EmptyNop $x$} B}%
  \EmptyColorTail{tc-nop-display-L}{A \textcolor{red}{\EmptyNop $$} B}{A {\EmptyNop $$} B}%
  \EmptyColorTail{id-nop-math}{中 \mbox{}\EmptyId{\EmptyNop $x$}}{中 \EmptyId{\EmptyNop $x$}}%
  % 恒等宏的参数里另有用户宏：展开得到的空格、展开为空之后紧跟的源码空格都
  % 不删去。
  \EmptyColorTail{id-nop-L}{A \mbox{}\EmptyId{\EmptyNop} B}{A \EmptyId{\EmptyNop} B}%
  \EmptyColorTail{id-sp-L}{A \mbox{}\EmptyId{\EmptySp}B}{A \EmptyId{\EmptySp}B}%
  % \noexpand 不能展开：展开之后记号丢掉“不展开”的标记，会被当作宏再展开。
  \EmptyColorTail{noexpand-L}{A \mbox{}\noexpand\EmptyFoo B}{A \noexpand\EmptyFoo B}%
  \EmptyColorTail{tc-noexpand-L}{A \textcolor{red}{\noexpand\EmptyFoo} B}{A {\noexpand\EmptyFoo} B}%
  % 颜色正文以用户宏开头、以公式加空格结尾。
  \EmptyColorTail{tc-nop-math-space-L}{A \textcolor{red}{\EmptyNop $x$ } B}{A {\EmptyNop $x$ } B}%
  \EmptyColorTail{tc-relax-math-space-L}{A \textcolor{red}{\relax $x$ } B}{A {\relax $x$ } B}%
  % \ifhmode、\csname 展开之后紧跟 $：直接输入的前视不越过它们，不补间距。
  \EmptyColorTail{ifhmode-math}{中 \mbox{}\ifhmode $x$\fi}{中 \ifhmode $x$\fi}%
  \EmptyColorTail{csname-math}{中 \mbox{}\csname relax\endcsname $x$}{中 \csname relax\endcsname $x$}%
  % 恒等宏的参数以可展开原语或 \NewDocumentCommand 定义的命令开头再接公式：直接
  % 输入的前视越过恒等宏之后由参数自己的边界处理，补公式前的间距。
  \EmptyColorTail{id-ifhmode-math}{中 \mbox{}\EmptyId{\ifhmode $x$\fi}}{中 \EmptyId{\ifhmode $x$\fi}}%
  \EmptyColorTail{id-nd-math}{中 \mbox{}\EmptyId{\EmptyNDNop $x$}}{中 \EmptyId{\EmptyNDNop $x$}}%
  % \NewDocumentCommand 定义的无参命令、展开为 \@empty 的宏展开后为空，不阻止交接。
  \EmptyColorTail{nd-mbox-L}{A \mbox{}\EmptyNDNop\mbox{} B}{A \EmptyNDNop B}%
  \EmptyColorTail{atempty-mbox-L}{A \mbox{}\EmptyAtEmpty\mbox{} B}{A \EmptyAtEmpty B}%
  % \the、\expandafter 等可展开原语展开出的空格不是紧跟命令的源码空格，不删去。
  \EmptyColorTail{the-space-L}{A \mbox{}\the\EmptySpaceToks B}{A \the\EmptySpaceToks B}%
  \EmptyColorTail{the-space-tc-L}{A \textcolor{red}{}\the\EmptySpaceToks B}{A \the\EmptySpaceToks B}%
  \EmptyColorTail{expandafter-space-L}{A \mbox{}\expandafter\relax\space B}{A \expandafter\relax\space B}%
  \EmptyColorTail{the-space-C}{中 \mbox{}\the\EmptySpaceToks 文}{中 \the\EmptySpaceToks 文}%
  % 条件原语本身不排出空格：宏的替换文本以 \fi 结尾时，其后的源码空格照常删去。
  \EmptyColorTail{macro-fi-L}{A \EmptyIfMbox{x} B}{A  B}%
  \EmptyColorTail{macro-fi-C}{中 \EmptyIfMbox{x} 文}{中  文}%
  % \obeyspaces 之下的活动空格展开为空格，与直接输入的活动空格相同。
  \EmptyColorTail{obey-mbox-L}{\EmptyObeyMbox}{\EmptyObeyL}%
  \EmptyColorTail{obey-mbox-C}{\EmptyObeyMboxC}{\EmptyObeyC}%
  \EmptyColorTail{obey-tc-C}{\EmptyObeyTc}{\EmptyObeyC}%
  \EmptyColorTail{obey-mbox-mbox-L}{\EmptyObeyMboxMbox}{\EmptyObeyL}%
  \EmptyColorTail{obey-color-L}{\EmptyObeyColor}{\EmptyObeyColorD}%
  \begingroup\EmptyObeyLet\EmptyColorTail{obey-let-mbox-L}{\EmptyObeyLetMbox}{\EmptyObeyLetL}\endgroup
  \begingroup\EmptyObeyLet\EmptyColorTail{obey-let-tc-C}{\EmptyObeyLetTc}{\EmptyObeyLetC}\endgroup
  \begingroup\EmptyObeyLet\EmptyColorTail{obey-let-color-L}{\EmptyObeyLetColor}{\EmptyObeyLetColorD}\endgroup
  % 名字里有 @ 的内部命令按不排出内容处理；写在花括号里时按排出内容处理，
  % 两侧空格保留。
  \EmptyColorTail{brace-internal-L}{A \mbox{}{\EmptyHbxt}\mbox{} B}{A {\EmptyHbxt} B}%
  % stream 命令的正文只排出规则、盒子、glue、kern 这类不报告类别的内容时，命令
  % 有可见输出，两侧空格都保留；正文为空时只保留一枚。\hyperlink 在正文前后自己
  % 写入链接注释的 special。
  \EmptyColorTail{link-rule-L}{A \hyperlink{a}{\rule{2pt}{1pt}} B}{A {\rule{2pt}{1pt}} B}%
  \EmptyColorTail{link-fbox-L}{A \hyperlink{a}{\fbox{}} B}{A {\fbox{}} B}%
  \EmptyColorTail{link-hspace-L}{A \hyperlink{a}{\hspace{2pt}} B}{A {\hspace{2pt}} B}%
  \EmptyColorTail{link-mbox-rule-L}{A \hyperlink{a}{\mbox{\rule{2pt}{1pt}}} B}{A {\rule{2pt}{1pt}} B}%
  \EmptyColorTail{reg-rule-L}{A \RegStreamBody{\rule{2pt}{1pt}} B}{A {\rule{2pt}{1pt}} B}%
  \EmptyColorTail{reg-kern-L}{A \RegStreamBody{\kern2pt} B}{A {\kern2pt} B}%
  \EmptyColorTail{reg-hspace-L}{A \RegStreamBody{\hspace{2pt}} B}{A {\hspace{2pt}} B}%
  \EmptyColorTail{reg-empty-L}{A \RegStreamBody{} B}{A  B}%
  \EmptyColorTail{reg-empty-C}{中 \RegStreamBody{} 文}{中  文}%
  % 正文里只有没有可见输出的命令时，它们留下的空盒子、颜色 whatsit 不算外层的输出。
  \EmptyColorTail{link-mbox-L}{A \hyperlink{a}{\mbox{}} B}{A  B}%
  \EmptyColorTail{link-tc-L}{A \hyperlink{a}{\textcolor{red}{}} B}{A  B}%
  \EmptyColorTail{reg-mbox-L}{A \RegStreamBody{\mbox{}} B}{A  B}%
  \EmptyColorTail{reg-mbox-C}{中 \RegStreamBody{\mbox{}} 文}{中  文}%
  \EmptyColorTail{reg-tc-L}{A \RegStreamBody{\textcolor{red}{}} B}{A  B}%
  \EmptyColorTail{uline-mbox-C}{中 \uline{\mbox{}} 文}{中  文}%
  % 正文以 whatsit 或盒子结尾、或先有空命令再排出内容时，命令仍有可见输出。
  \EmptyColorTail{link-tc-rule-L}{A \hyperlink{a}{\textcolor{red}{\rule{2pt}{1pt}}} B}{A {\textcolor{red}{\rule{2pt}{1pt}}} B}%
  \EmptyColorTail{link-rule-nc-L}{A \hyperlink{a}{\rule{2pt}{1pt}\normalcolor} B}{A {\rule{2pt}{1pt}\normalcolor} B}%
  \EmptyColorTail{link-mbox-then-rule-L}{A \hyperlink{a}{\mbox{}\rule{2pt}{1pt}} B}{A {\rule{2pt}{1pt}} B}%
  \EmptyColorTail{link-mbox-then-fbox-L}{A \hyperlink{a}{\mbox{}\fbox{}} B}{A {\fbox{}} B}%
  \EmptyColorTail{link-special-L}{A \hyperlink{a}{\special{x}} B}{A {\special{x}} B}%
  \EmptyColorTail{reg-tc-rule-L}{A \RegStreamBody{\textcolor{red}{\rule{2pt}{1pt}}} B}{A {\textcolor{red}{\rule{2pt}{1pt}}} B}%
  \EmptyColorTail{reg-special-L}{A \RegStreamBody{\special{x}} B}{A {\special{x}} B}%
  \EmptyColorTail{mbox-x-reg-rule}{\mbox{x} \RegStreamBody{\rule{2pt}{1pt}} B}{\mbox{x} {\rule{2pt}{1pt}} B}%
}
\TEST{stale record after an empty command}{
  \begingroup \xeCJKsetup{xCJKecglue=false} \EmptyStaleAll \endgroup
  \begingroup \xeCJKsetup{xCJKecglue=true} \EmptyStaleAll \endgroup
}

% 宽、高、深都为零的盒子里可能有重叠排出的内容，这时按有可见输出处理。
\TEST{zero-sized box with visible content}{
  \EmptyVariant{smash/11}{A}{\mbox{\smash{\rlap{\rule{2pt}{1pt}}}}}{B}{ }{ }
    { \smash{\rlap{\rule{2pt}{1pt}}} }%
  % 只有 glue 的零尺寸盒子（\makebox[0pt]{} 里两枚相同的 fil glue）没有输出。
  \EmptyVariant{makebox0/11}{中}{\makebox[0pt]{}}{文}{ }{ }{ }%
  \EmptyVariant{makebox0-L/11}{A}{\makebox[0pt]{}}{B}{ }{ }{ }%
  % 末尾节点属于 \discretionary 的不断行文本时删不掉，检查要停下来。
  \EmptyVariant{disc/11}{A}{\mbox{\discretionary{}{}{\kern0pt}}}{B}{ }{ }
    { \discretionary{}{}{\kern0pt} }%
}

% \verb 等没有放哨兵的 stream 命令按有可见输出处理：抄录的空格不报告类别。
% \verb 不能写在宏参数里，所以在这里直接排盒子比较。
\newcommand\EmptyVerbCompare[1]{%
  \global\advance\EmptyChecks by 1
  \ifdim\wd\EmptyCandidate=\wd\EmptyOracle \else
    \global\advance\EmptyFailures by 1
    \TYPE{FAIL: #1 (\the\wd\EmptyCandidate\space vs \the\wd\EmptyOracle)}%
  \fi
}
\BEGINTEST{verb whose body is only spaces}
\EmptyReset
\setbox\EmptyCandidate=\hbox{A \verb| | B}%
\EmptyReset
\setbox\EmptyOracle=\hbox{A {\ttfamily\ } B}%
\EmptyVerbCompare{verb-space-L}%
\EmptyReset
\setbox\EmptyCandidate=\hbox{A \verb|  | B}%
\EmptyReset
\setbox\EmptyOracle=\hbox{A {\ttfamily\ \ } B}%
\EmptyVerbCompare{verb-2space-L}%
\ENDTEST

\TYPE{empty-output checks: \the\EmptyChecks}
\TYPE{empty-output failures: \the\EmptyFailures}

\END

\end{document}
