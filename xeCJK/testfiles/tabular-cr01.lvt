\input{regression-test}

\documentclass{article}

\usepackage{xeCJK}
\setCJKmainfont{FandolSong-Regular.otf}

\begin{document}

\START

\loggingoutput

% 独立成文件，不与 tabular01 的 TEST 3 合并：缺陷版下 TEST 3 会以
% Improper alphabetic constant 中止编译，同一文件里其后的用例根本不执行（实测缺陷版
% 日志里 TEST 4 出现 0 次），门禁形同虚设。每个能独立触发缺陷的用例都要有自己的文件。

% 同一根因的相邻写法：\\ 带可选参数（走 \@argtabularcr）、位于 & 之后、以及末行。
% 这三种都仍经过 \@tabularcr，即替换文本首记号是显式 { 的那条路径。
%
% 不含 array／\halign：它们不受本缺陷影响，原因不是「没用 {\ifnum0=`}\fi 平衡技巧」
% ——\@arraycr 用的正是同一个技巧（latex.ltx:16818）——而是替换文本首记号不同：
% \@arraycr 以 $ 开头（math shift），XeTeX 前瞻看到的不是 {；\halign 则直接用 \cr。
% 数学模式下 handler 本就不运行，是第二重保险。
\TEST{CJK before tabular cr variants}{
  \begin{tabular}{ll}
  甲文&乙文\\
  中文\\[2pt]
  末行 & 末列\\
  \end{tabular}
  \clearpage
}

\END

\end{document}
