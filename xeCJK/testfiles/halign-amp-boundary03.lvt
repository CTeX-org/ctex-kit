\input{regression-test}

\documentclass{article}

\usepackage{amsmath}
\usepackage{xcolor}
\usepackage{xeCJK}
\setCJKmainfont{FandolSong-Regular.otf}

\begin{document}

\START

\loggingoutput

% #1043 的第三种语境：夹在 CJK 之间，确认修复后 ecglue 仍照常插入。
% 本修复动的是 boundary 判断路径，若替换把参数弄坏，最先失守的就是这里的
% CJK-math 间距，所以这一项固定的是间距而非「不报错」。
%
% 独立成文件的理由同 halign-amp-boundary02.lvt（-halt-on-error 会让同文件内
% 后续 TEST 在缺陷态下根本不执行）。判别力已实测：删除替换后本文件 rc 1。

\TEST{ecglue preserved around colorbox with ampersand}{
  \begin{tabular}{c}
    中文\colorbox{yellow}{$\begin{array}{cc}1 &0\end{array}$}中文\\
  \end{tabular}
  \clearpage
}

\END

\end{document}
