\input{regression-test}

\documentclass{article}

\usepackage{xeCJK}
\usepackage{xcolor}
\usepackage{hyperref}
\usepackage{hypdoc}
\usepackage{xeCJKfntef}

\setCJKmainfont{FandolSong-Regular.otf}
\setCJKmonofont{FandolFang-Regular.otf}

\newskip\BoundaryExplicitSpace
\BoundaryExplicitSpace=3.33333pt plus 1.66666pt minus 1.11111pt

\showboxbreadth=100
\showboxdepth=20

\begin{document}

% Keep lazy fontspec family creation outside the normalized test log.
\setbox0=\hbox{\ttfamily 中文}

\START

\loggingoutput
\xeCJKsetup{CJKecglue={\hskip 5pt},CJKglue={\hskip 1pt}}

\TEST{box capture in paragraph mode}{
  \setbox0=\vbox{%
    \hsize=100pt
    \noindent 中\mbox{Alpha}文\par
  }%
  \box0
  \clearpage
}

\TEST{transparent capture preserves a source-space boundary}{
  \setbox0=\hbox{中\null 中文}%
  \box0
  \clearpage
}

\TEST{stream capture follows linked CJK output}{
  \setbox0=\hbox{A\href{https://example.com}{中文}B}%
  \box0
  \clearpage
}

\TEST{ulem stream keeps its left CJKglue outside the decoration}{
  \setbox0=\hbox{中\uline{中文}文}%
  \box0
  \clearpage
}

\TEST{explicit elastic glue is not a source space}{
  \setbox0=\hbox{%
    中\hskip 7pt plus 2pt minus 1pt\mbox{Alpha}文%
  }%
  \box0
  \clearpage
}

\TEST{entry capture preserves an explicit interword-sized glue}{
  \setbox0=\hbox{%
    中\hskip\BoundaryExplicitSpace\mbox{Alpha}文%
  }%
  \box0
  \clearpage
}

\TEST{direct explicit interword-sized glue remains explicit}{
  \setbox0=\hbox{%
    中\hskip\BoundaryExplicitSpace Alpha%
  }%
  \box0
  \clearpage
}

% The zero kern stops the source-space recoverer before it can reach the
% preceding CJK marker, preserving an otherwise source-space-shaped \hskip.
\TEST{a zero kern protects following explicit interword-sized glue}{
  \setbox0=\hbox{%
    中\mbox{中文}\kern0pt\hskip\BoundaryExplicitSpace Alpha%
  }%
  \box0
  \clearpage
}

\TEST{post-transparent null carries a recoverable boundary suffix}{
  \setbox0=\hbox{中\hskip 7pt\null Alpha}%
  \box0
  \clearpage
}

\TEST{assigned null does not replay stale state across explicit glue}{
  \setbox2=\hbox{}%
  \setbox0=\hbox{中\hskip 7pt\setbox2\null Alpha}%
  \box0
  \clearpage
}

\TEST{cs stream reports its actual western tail}{
  \setbox0=\hbox{中\cs{Alpha}文}%
  \box0
  \clearpage
}

\TEST{cs stream reports its actual CJK tail}{
  \setbox0=\hbox{A\cs{中文}B}%
  \box0
  \clearpage
}

\TEST{xCJKecglue recognizes source space after an uppercase box tail}{
  \begingroup
    \xeCJKsetup{xCJKecglue=true}%
    \setbox0=\hbox{中\mbox{A\mbox{B}C} 文}%
    \box0
    \clearpage
  \endgroup
}

\TEST{xCJKecglue follows marker and glue across post-transparent null}{
  \begingroup
    \xeCJKsetup{xCJKecglue=true}%
    \setbox0=\hbox{中 \hskip 7pt\null Alpha}%
    \box0
    \clearpage
  \endgroup
}

\TEST{xCJKecglue preserves explicit glue without a source space}{
  \begingroup
    \xeCJKsetup{xCJKecglue=true}%
    \setbox0=\hbox{中\hskip 7pt\null Alpha}%
    \box0
    \clearpage
  \endgroup
}

% The post-transparent relocation must not move an infinite fil/fill glue
% behind the zero-sized box.  A CJK word followed by a source space and a
% fill-order \hfill leaves an infinite glue on top of the CJK-space marker;
% the \null must stay after that fill glue (at the list end), so the two
% \hfill of a centered line keep equal stretch and the run stays centered
% (#1085).  Before the fix the \null jumped in front of the marker+fill,
% collapsing one side of the centering.
\TEST{post-transparent null keeps a trailing fill glue in place}{
  \setbox0=\hbox to 200pt{\hfill 中文 \hfill\null}%
  \box0
  \clearpage
}

\TEST{post-transparent null keeps a trailing fil glue in place}{
  \setbox0=\hbox to 200pt{\hfill 中文 \hfil\null}%
  \box0
  \clearpage
}

% Boundary case: a *finite* glue (here a fixed 30pt without shrink) is still
% relocated behind the \null exactly as before, because only infinite fil/fill
% glue is excluded by the finiteness guard.  This pins that the fix does NOT
% widen to a full interword-shape test (which would wrongly drop the math-space
% \hskip handling); the \null legitimately precedes the fixed glue here and the
% width is unaffected since a rigid glue does not participate in glue setting.
\TEST{post-transparent null still relocates a finite non-interword glue}{
  \setbox0=\hbox{中文 \hskip 30pt\null}%
  \box0
  \clearpage
}

% An explicit-group and a bare CJK run reach the same recovery path; both
% must center symmetrically like the braced form.
\TEST{post-transparent null after an explicit group keeps fill symmetric}{
  \setbox0=\hbox to 200pt{\hfill \begingroup 中文 \endgroup \hfill\null}%
  \box0
  \clearpage
}

\END

\end{document}
