\input{regression-test}

\documentclass{article}

\usepackage{xeCJK}
\usepackage{siunitx}

\setCJKmainfont{FandolSong-Regular.otf}

\newbox\BoundaryCandidate
\newbox\BoundaryOracle
\newbox\BoundaryCandidateContext
\newbox\BoundaryOracleContext
\newdimen\BoundaryIntrinsicDelta
\newdimen\BoundaryDelta
\newcount\BoundaryChecks
\newcount\BoundaryFailures

\ExplSyntaxOn
% Test-only white-box reset/assertions; these internal variables are not API.
\cs_new_protected:Npn \BoundaryReset
  {
    \tl_gclear:N \g__xeCJK_last_node_tl
    \bool_gset_false:N \g__xeCJK_glue_check_pending_bool
  }
\cs_new:Npn \BoundaryCaptureDepth
  { \int_use:N \g__xeCJK_boundary_capture_depth_int }
\cs_new:Npn \BoundaryCaptureStackCount
  { \int_eval:n { \seq_count:N \g__xeCJK_boundary_active_seq } }
\cs_new:Npn \BoundaryCaptureSuspendDepth
  { \int_use:N \g__xeCJK_boundary_suspend_depth_int }
\ExplSyntaxOff

\newcommand\BoundaryAssertIdle[2]{%
  \ifnum\BoundaryCaptureDepth=0\relax
    \ifnum\BoundaryCaptureStackCount=0\relax
    \else
      \global\advance\BoundaryFailures by 1
      \TYPE{FAIL: #1/#2 left a nonempty capture stack}%
    \fi
  \else
    \global\advance\BoundaryFailures by 1
    \TYPE{FAIL: #1/#2 left a nonzero capture depth}%
  \fi
  \ifnum\BoundaryCaptureSuspendDepth=0\relax
  \else
    \global\advance\BoundaryFailures by 1
    \TYPE{FAIL: #1/#2 left a nonzero capture suspension depth}%
  \fi
}

\newcommand\BoundaryVariant[4]{%
  \global\advance\BoundaryChecks by 1
  \BoundaryReset
  \setbox\BoundaryCandidateContext=\hbox{#3}%
  \BoundaryAssertIdle{#1}{#2}%
  \BoundaryReset
  \setbox\BoundaryOracleContext=\hbox{#4}%
  \BoundaryDelta=\dimexpr
    \wd\BoundaryCandidateContext-\wd\BoundaryOracleContext-
    \BoundaryIntrinsicDelta\relax
  \ifdim\BoundaryDelta<0pt \BoundaryDelta=-\BoundaryDelta\fi
  \ifdim\BoundaryDelta<0.01pt
  \else
    \global\advance\BoundaryFailures by 1
    \TYPE{FAIL: #1/#2 boundary delta is \the\BoundaryDelta}%
  \fi
}

\newcommand\BoundaryMatrix[5]{%
  \BoundaryReset
  \setbox\BoundaryCandidate=\hbox{#3}%
  \BoundaryAssertIdle{#1}{standalone}%
  \BoundaryReset
  \setbox\BoundaryOracle=\hbox{#4}%
  \BoundaryIntrinsicDelta=\dimexpr
    \wd\BoundaryCandidate-\wd\BoundaryOracle\relax
  \BoundaryVariant{#1}{00}{#2#3#5}{#2#4#5}%
  \BoundaryVariant{#1}{10}{#2 #3#5}{#2 #4#5}%
  \BoundaryVariant{#1}{01}{#2#3 #5}{#2#4 #5}%
  \BoundaryVariant{#1}{11}{#2 #3 #5}{#2 #4 #5}%
}

\newcommand\BoundaryRunSiunitxMatrices{%
  \BoundaryMatrix{unit-CDC}{中}{\unit{kg}}{kg}{文}
  \BoundaryMatrix{unit-WDW}{A}{\unit{kg}}{kg}{B}
  \BoundaryMatrix{qty-CDC}{中}{\qty{5}{kg}}{5kg}{文}
  \BoundaryMatrix{qty-WDW}{A}{\qty{5}{kg}}{5kg}{B}
  \BoundaryMatrix{num-CDC}{中}{\num{3.14}}{3.14}{文}
  \BoundaryMatrix{num-WDW}{A}{\num{3.14}}{3.14}{B}
  \BoundaryMatrix{si-CDC}{中}{\si{kg}}{kg}{文}
  \BoundaryMatrix{SI-CDC}{中}{\SI{5}{kg}}{5kg}{文}
  \BoundaryMatrix{unit-opt-CDC}{中}{\unit[per-mode=symbol]{kg.m/s}}{kg.m/s}{文}
  % #1092: every typesetting command is its own top-level entry and needs
  % its own registration; the cmd hooks of \qty/\num do not cover them.
  % As for \num above, the oracle is text with the same edge characters:
  % the registration fixes both ends as Default, so with xCJKecglue=false a
  % source space next to CJK becomes \CJKecglue, unlike a bare `$5$'.
  \BoundaryMatrix{qtyrange-CDC}{中}{\qtyrange{5}{7}{kg}}{5\,kg to 7\,kg}{文}
  \BoundaryMatrix{qtyrange-WDW}{A}{\qtyrange{5}{7}{kg}}{5\,kg to 7\,kg}{B}
  \BoundaryMatrix{numrange-CDC}{中}{\numrange{5}{7}}{5 to 7}{文}
  \BoundaryMatrix{numrange-WDW}{A}{\numrange{5}{7}}{5 to 7}{B}
  \BoundaryMatrix{qtylist-CDC}{中}{\qtylist{5;7}{kg}}{5\,kg and 7\,kg}{文}
  \BoundaryMatrix{numlist-CDC}{中}{\numlist{5;7}}{5 and 7}{文}
  \BoundaryMatrix{qtyproduct-CDC}{中}{\qtyproduct{5x7}{kg}}{5x7\,kg}{文}
  \BoundaryMatrix{numproduct-CDC}{中}{\numproduct{5x7}}{5x7}{文}
  \BoundaryMatrix{complexnum-CDC}{中}{\complexnum{1+2i}}{1+2i}{文}
  \BoundaryMatrix{complexqty-CDC}{中}{\complexqty{1+2i}{kg}}{(1+2i)\,kg}{文}
  \BoundaryMatrix{duration-CDC}{中}{\duration{1;30;0}}{1\,h 30\,min 0\,s}{文}
  \BoundaryMatrix{ang-CDC}{中}{\ang{30}}{30°}{文}
  \BoundaryMatrix{SIrange-CDC}{中}{\SIrange{5}{7}{kg}}{5\,kg to 7\,kg}{文}
  \BoundaryMatrix{SIlist-CDC}{中}{\SIlist{5;7}{kg}}{5\,kg and 7\,kg}{文}
  % A CJK range phrase and a bracketed unit stay inside the output, so the
  % outer edges are still Default.
  \BoundaryMatrix{numrange-cjkphrase-CDC}{中}{\numrange[range-phrase=至]{5}{7}}{5至7}{文}
  \BoundaryMatrix{qtyrange-bracket-CDC}{中}{\qtyrange[range-units=bracket]{5}{7}{kg}}{(5 to 7)\,kg}{文}
}

\begin{document}

\OMIT
% Warm up siunitx math fonts and any one-shot deprecation messages
% before the recorded region.
\setbox0=\hbox{\unit{kg}\qty{5}{kg}\num{3.14}\si{kg}\SI{5}{kg}$x$}
\setbox0=\hbox{\qtyrange{5}{7}{kg}\numrange{5}{7}\qtylist{5;7}{kg}\numlist{5;7}%
  \qtyproduct{5x7}{kg}\numproduct{5x7}\complexnum{1+2i}\complexqty{1+2i}{kg}%
  \duration{1;30;0}\ang{30}\SIrange{5}{7}{kg}\SIlist{5;7}{kg}}
\TIMO

\START

\TEST{package-default glue, xCJKecglue=false siunitx matrices}{
  \begingroup
    \xeCJKsetup{xCJKecglue=false}
    \BoundaryRunSiunitxMatrices
  \endgroup
}

\TEST{package-default glue, xCJKecglue=true siunitx matrices}{
  \begingroup
    \xeCJKsetup{xCJKecglue=true}
    \BoundaryRunSiunitxMatrices
  \endgroup
}

\xeCJKsetup{CJKecglue={\hskip 5pt},CJKglue={\hskip 1pt}}

\TEST{distinguishing glue, xCJKecglue=false siunitx matrices}{
  \begingroup
    \xeCJKsetup{xCJKecglue=false}
    \BoundaryRunSiunitxMatrices
  \endgroup
}

\TEST{distinguishing glue, xCJKecglue=true siunitx matrices}{
  \begingroup
    \xeCJKsetup{xCJKecglue=true}
    \BoundaryRunSiunitxMatrices
  \endgroup
}

\TEST{siunitx inside math mode leaves the capture stack idle}{
  \BoundaryReset
  \setbox\BoundaryCandidateContext=\hbox{$x=\unit{kg}$}%
  \BoundaryAssertIdle{math-inside}{00}
  \BoundaryReset
  \setbox\BoundaryCandidateContext=\hbox{$x=\qtyrange{5}{7}{kg}$}%
  \BoundaryAssertIdle{math-inside-range}{00}
}

\TYPE{siunitx boundary checks: \the\BoundaryChecks}
\TYPE{siunitx boundary failures: \the\BoundaryFailures}

\END

\end{document}
