  \EntryWidth{latin-then-leftparen}{x\uline{（中}x}{x{（中}x}
  \EntryWidth{latin-then-color-leftparen}{x\uline{\color{red}（中}x}{x{\color{red}（中}x}
  \EntryWidth{latin-ctrl-space-then-leftparen}{x\ \uline{（中}x}{x\ {（中}x}
