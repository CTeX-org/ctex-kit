  \EntryWidth{outer-latin-math-then-nested-color-glue-nested-leftparen}
    {x\uline{$a$\sout{\color{red}\hfill\xout{（中}}}x}{x{$a${\color{red}\hfill{（中}}}x}
  \EntryWidth{outer-latin-math-then-empty-mbox-after-decoration}
    {x\uline{$a$\sout{\mbox{$b$}}}x\mbox{\mbox{}（中}}{x{$a${\mbox{$b$}}}x\mbox{\mbox{}（中}}
  \EntryWidth{outer-latin-math-then-math-mbox-then-hbox-empty-mbox}
    {x\uline{$a$\sout{\mbox{$b$}}\hbox{\mbox{}（中}}x}{x{$a${\mbox{$b$}}\hbox{\mbox{}（中}}x}
  \EntryWidth{outer-latin-math-then-nested-glue-empty-nested-leftparen}
    {x\uline{$a$\sout{\color{red}\hfill\xout{}\xout{（中}}}x}{x{$a${\color{red}\hfill{}{（中}}}x}
  \EntryWidth{latin-math-color-then-next-decoration-in-hbox}
    {x\uline{$a$\sout{\color{red}}}\hbox{\uline{\mbox{}\sout{（中}}}x}
    {x{$a${\color{red}}}\hbox{{\mbox{}{（中}}}x}
  \begingroup
  \xeCJKsetup{CJKecglue={\hskip 5pt}}
  \EntryWidth{ecglue-nested-group-space-then-math-end-cjk}
    {{中} \uline{\sout{\kern1pt$a$}}后}{{中} {{\kern1pt$a$}}后}
  \EntryWidth{ecglue-outer-mbox-space-kern-then-nested}
    {\mbox{中} \uline{\kern1pt\sout{中}} 后}{\mbox{中} {\kern1pt{中}} 后}
  \EntryWidth{ecglue-single-mbox-space-kern-then-latin-group}
    {\mbox{中} \uline{\kern1pt{x}} 后}{\mbox{中} {\kern1pt{x}} 后}
  \EntryWidth{ecglue-single-group-space-kern-then-hbox-latin}
    {{中} \uline{\kern1pt\hbox{中}}x}{{中} {\kern1pt\hbox{中}}x}
  \endgroup
}


% 线型命令写在 \mbox、\fbox 里、正文含全角左标点时，标点报告的 CJK 不写进盒子的
% capture 层，盒子两侧的空格与间距与直接输入一致（box-uline-leftparen-*）。正文以
% \mbox、\textcolor 或嵌套线型命令结尾、花括号前还有空格时，命令后的空格与直接输入
% 一样保留（trailing-*-then-space-*）。known-makebox-width-then-latin 是已登记的差异：
% 定宽 \makebox 里的西文前补的左边界间距被盒子吸收，普通空格写法比 ~ 写法少一个空格。
\TEST{boxes around decorations and decorations ending with a box and a space}{
  \EntryWidth{box-uline-leftparen-mbox-spaced}
    {第 \mbox{\CJKunderline{\hspace*{1em}（1）\hspace*{1em}}} 题}
    {第 \mbox{{\hspace*{1em}（1）\hspace*{1em}}} 题}
  \EntryWidth{box-uline-leftparen-fbox-spaced}
    {第 \fbox{\CJKunderline{\hspace*{1em}（1）\hspace*{1em}}} 题}
    {第 \fbox{{\hspace*{1em}（1）\hspace*{1em}}} 题}
  \EntryWidth{box-uline-leftquote-mbox-spaced}
    {第 \mbox{\CJKunderline{\hspace*{1em}“1”\hspace*{1em}}} 题}
    {第 \mbox{{\hspace*{1em}“1”\hspace*{1em}}} 题}
  \EntryWidth{box-uline-leftparen-fbox-cjk}{中 \fbox{\CJKunderline{（中）}} 中}{中 \fbox{{（中）}} 中}
  \EntryWidth{box-uline-leftparen-fbox-latin}{x\fbox{\CJKunderline{（中）}}x}{x\fbox{{（中）}}x}
  \EntryWidth{trailing-textcolor-then-space-cjk}
    {姓名 \CJKunderline{\textcolor{blue}{张三} } 学号}{姓名 {\textcolor{blue}{张三} } 学号}
  \EntryWidth{trailing-mbox-then-space-cjk}
    {姓名 \CJKunderline{\mbox{张三} } 学号}{姓名 {\mbox{张三} } 学号}
  \EntryWidth{trailing-mbox-then-space-latin}{前\uline{\mbox{中} }x}{前{\mbox{中} }x}
  \EntryWidth{trailing-nested-then-space-cjk}{前\CJKunderline{\CJKsout{中} } 后}{前{{中} } 后}
  \EntryWidth{trailing-nested-then-space-latin}{前\CJKunderline{\CJKsout{中} }x}{前{{中} }x}
  \EntryNodes{known-makebox-width-then-latin}{第 \CJKunderline{\makebox[4em]{3}} 题}
}

% 正文只有注册的盒子、没有字符，命令两侧都不写空格时，盒子对边界透明，命令两侧的
% 字符之间与直接输入一样补 \CJKecglue。box-then-* 与 *-space-* 是对照：盒子之后
% 还有 glue、kern、规则、\special、penalty 或正文末尾空格，或正文以语法空格开头时，
% 直接输入不补，这里也不补。
\TEST{decorations whose body is only boxes}{
  \EntryWidth{box-only-makebox-latin-cjk}{x\CJKunderline{\makebox[3em]{}}后}{x{\makebox[3em]{}}后}
  \EntryWidth{box-only-makebox-cjk-latin}{中\CJKunderline{\makebox[3em]{}}x}{中{\makebox[3em]{}}x}
  \EntryWidth{box-only-fbox-latin-cjk}{x\uline{\fbox{}}后}{x{\fbox{}}后}
  \EntryWidth{box-only-two-boxes-latin-cjk}
    {x\uline{\makebox[2em]{}\makebox[1em]{}}后}{x{\makebox[2em]{}\makebox[1em]{}}后}
  \EntryWidth{box-only-colorbox-latin-cjk}
    {x\uline{\colorbox{yellow}{\hspace*{2em}}}后}{x{\colorbox{yellow}{\hspace*{2em}}}后}
  \EntryWidth{box-only-color-fbox-latin-cjk}{x\uline{\color{red}\fbox{}}后}{x{\color{red}\fbox{}}后}
  \EntryWidth{box-only-textcolor-fbox-latin-cjk}
    {x\uline{\textcolor{red}{\fbox{}}}后}{x{\textcolor{red}{\fbox{}}}后}
  \EntryWidth{box-only-nested-latin-cjk}{x\uline{\sout{\fbox{}}}后}{x{{\fbox{}}}后}
  \EntryWidth{box-only-nested-two-boxes-latin-cjk}
    {x\uline{\sout{\makebox[2em]{}\makebox[1em]{}}}后}{x{{\makebox[2em]{}\makebox[1em]{}}}后}
  \EntryWidth{box-then-hspace-latin-cjk}{x\uline{\fbox{}\hspace*{1em}}后}{x{\fbox{}\hspace*{1em}}后}
  \EntryWidth{box-then-kern-latin-cjk}{x\uline{\fbox{}\kern1pt}后}{x{\fbox{}\kern1pt}后}
  \EntryWidth{box-then-rule-latin-cjk}{x\uline{\fbox{}\rule{1em}{1pt}}后}{x{\fbox{}\rule{1em}{1pt}}后}
  \EntryWidth{space-then-box-cjk-latin}{中\uline{ \fbox{}}x}{中{ \fbox{}}x}
  \EntryWidth{box-then-glue-latin-cjk}{x\uline{\fbox{}\hspace{1em}}后}{x{\fbox{}\hspace{1em}}后}
  \EntryWidth{box-then-special-latin-cjk}{x\uline{\fbox{}\special{x}}后}{x{\fbox{}\special{x}}后}
  \EntryWidth{box-nobreak-box-latin-cjk}{x\uline{\fbox{}\nobreak\fbox{}}后}{x{\fbox{}\nobreak\fbox{}}后}
  \EntryWidth{box-then-space-cjk-latin}{中\uline{\fbox{} }x}{中{\fbox{} }x}
}
\END

