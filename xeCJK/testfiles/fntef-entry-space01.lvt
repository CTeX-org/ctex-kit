% 嵌套线型命令的内层正文以全角左标点开头时，补报类别不能在内层盒子里的标点与
% 西文之间插入左边界间距。三层嵌套时，中间层盒子末尾为识别最内层盒子临时补的
% marker 要在盒子关闭前删去，不能留在盒子里；中间层正文以字符结尾时，字符自己
% 的 marker 不能被当成这个临时 marker 删掉。内层正文以颜色命令开头时，为标记
% 颜色 whatsit 放下的 marker 仍在列表末尾就会删去：连续的颜色命令只保留最后一个，
% 第一个字符出现时删去；颜色之后接更深一层装饰或正文没有字符时，在进入下一层或
% 内层正文结束时删去。颜色之后先排出 \hspace 等内容时，这个零宽 marker 压在它们
% 之下，留在内层盒子里（nested-color-hspace-keeps-marker 固定这一点）。
\TEST{no boundary glue inside a nested decoration}{
  \EntryNodes{nested-leftquote-latin}{他说\CJKunderline{\CJKsout{“OK”}}吗}
  \EntryNodes{three-level-no-marker}{符 \uline{\sout{\xout{中}}} 后}
  \EntryNodes{three-level-keep-char-marker}{符 \uline{\sout{\xout{中}中}} 后}
  \EntryNodes{nested-color-no-marker}{x\uline{\sout{\textcolor{red}{中}}}x}
  \EntryNodes{nested-two-color-no-marker}{x\uline{\sout{\color{red}\color{blue}中}}x}
  \EntryNodes{nested-color-deeper-no-marker}{x\uline{\sout{\color{red}\xout{中}}}x}
  \EntryNodes{nested-color-only-no-marker}{x\uline{\sout{\textcolor{red}{}}}x}
  \EntryNodes{nested-color-hspace-keeps-marker}{x\uline{\sout{\color{red}\hspace{1em}中}}x}
}

% 嵌套线型命令之后若又排出别的盒子，这个盒子不能被误认成嵌套装饰，也不能在
% 检查时丢掉 \raise 的位移。\raise\copy 不新建盒子，最容易暴露这两点；命令
% 后的空格应与直接输入一样保留。
\TEST{box after a nested decoration}{
  \EntryNodes{nested-raisebox}{符 \CJKunderline{\CJKsout{中}\raisebox{1pt}{x}} 后}
  \EntryNodes{nested-raise-copy}{符 \CJKunderline{\CJKsout{中}\raise2pt\copy\FillBox} 后}
}

% 打开 CheckFullRight 时，全角右标点自己先删去后面的空格再查看下一个记号；
% 正文末尾的空格仍要按普通内容处理，结果与不打开选项时相同。
\TEST{trailing full-width right punctuation with CheckFullRight}{
  \xeCJKsetup{CheckFullRight=true}
  \EntryWidth{cfr-trailing-space-latin}{符 \CJKunderline{中。 } x}{符 {中。 } x}
  \EntryWidth{cfr-trailing-space-cjk}{符 \CJKunderline{中。 } 后}{符 {中。 } 后}
  \EntryWidth{cfr-inner-spaces-cjk}{答 \CJKunderline{ 中。 } 后}{答 { 中。 } 后}
  \EntryWidth{cfr-nested-trailing-space-latin}{符 \uline{\sout{中。 }} x}{符 {中。 } x}
  \EntryWidth{cfr-three-level-trailing-space-latin}{符 \uline{\sout{\xout{中。 }}} x}{符 {中。 } x}
  \EntryWidth{cfr-period-space-latin}{符 \CJKunderline{中。} x}{符 中。 x}
  \EntryWidth{cfr-period-latin}{符 \CJKunderline{中。}x}{符 中。x}
  \EntryWidth{cfr-period-space-cjk}{符 \CJKunderline{中。} 后}{符 中。 后}
  \EntryWidth{cfr-relax-space-latin}{符 \CJKunderline{中。\relax} x}{符 中。\relax{} x}
  \EntryWidth{cfr-nested-period-space-latin}{符 \CJKunderline{\CJKsout{中。}} x}{符 中。 x}
  \EntryWidth{cfr-mid-space}{符 \CJKunderline{中。 中} x}{符 中。 中 x}
  \EntryWidth{cfr-space-then-no-space}{符 \CJKunderline{中。 {}中。} x}{符 中。 {}中。 x}
  \EntryWidth{cfr-active-space}{\EntryActiveSpaceCase}{中。za}
  \EntryWidth{cfr-nested-space-then-no-space}{符 \CJKunderline{\CJKsout{中。 中。}} x}{符 中。 中。 x}
  \xeCJKsetup{CheckFullRight=false}
  \EntryWidth{cfr-off-period-space-latin}{符 \CJKunderline{中。} x}{符 中。 x}
  \EntryWidth{cfr-off-active-space}{符 \CJKunderline{\EntryActiveSpaceCase} x}{符 \EntryActiveSpaceCase{} x}
}

% 装饰位于段末时，段末删除行尾 glue 不能删掉装饰末尾的像素补偿 glue。
\TEST{trailing content at paragraph end}{
  \EntryParEnd{fill}{符 \CJKunderline{中\hspace*{2em}}}
  \EntryParEnd{period}{符 \CJKunderline{中。}}
  \EntryParEnd{parend-cjk}{符 \CJKunderline{中}}
}

% 正文以全角左标点结尾时，与直接输入一样：命令后的空格在汉字前删去、在西文前
% 保留为词间空格，西文前不补间距。标点紧接正文末尾时才这样处理；标点之后还有
% \relax、\hspace 等记号时，按直接输入 |中（\relax{} 后| 处理（标点在正文内的
% 分组里时不在此列，尚未处理）。嵌套线型命令里，全角左标点之后 xeCJK 自己排出的
% glue 不算正文末尾的内容，用户写的 |~| 等仍算；更深一层的线型命令排出的盒子，
% 按它的第一个与最后一个字符与前后的字符连接，内层正文以空格开头时这枚空格与
% 直接输入一样处理（包括 \space、多层分组、xCJKecglue 与 CJKspace 的情形）；
% 内层正文在第一个字符之前先排出 ~、\hspace、\kern、\nobreak、\strut、\special
% 等内容时，外层左边界不再补在这些内容与字符之间；颜色命令对边界透明，与直接
% 输入一样不算内容，颜色写在外层正文、中间层或前一个兄弟装饰里时也是如此。
% 三层以上嵌套时，中间层在更深一层装饰之前先排出这些内容，同样不补左边界。
% 内层正文以公式加空格结尾时、\sbox 里同样如此。
% \sbox 用例的 oracle 是导言区预先存好的 |\sbox{中{ 中}}|：前一个写法留下的
% 源码空格检查状态会进入 \sbox，在用例里现场排出的结果随用例顺序变化，这是核心的
% 既有问题。
