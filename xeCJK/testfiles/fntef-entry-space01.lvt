\input{regression-test}

\documentclass{article}

\usepackage{xcolor}
\usepackage{xeCJK}
\usepackage{xeCJKfntef}
\setCJKmainfont{FandolSong-Regular.otf}
\pagestyle{empty}

% #1091：线型装饰命令（借 ulem 扫描的 \CJKunderline 等）的以下几类边界缺陷。
%
% 一、ulem 结束正文时，会在一个随即丢弃的片段盒子里排出定界符 |*|。命令边界
%     capture 曾把它当成正文的首个或末个西文字符：
%     - 正文没有字符（空参数、只有 \hspace 和盒子的填空线）时，左边界被补到
%       装饰末尾，结尾的语法空格被画成一段多余的装饰线，右侧又多出一枚间距；
%     - 正文以全角标点开头（《》「」）时同样没有可观察的首类别，出现同样的
%       多余装饰；
%     - 正文以嵌套装饰或标点结尾、末尾没有可读 marker 时，右边界按西文处理，
%       例如 \CJKunderline{中。}文 在句号后多出一枚 3.33pt 的间距。
% 二、正文在第一个字符之前先排出有宽度的内容（盒子、规则、显式 glue）时，
%     命令前的源码空格被放到这些内容之后，甚至装饰之后，填空线因此不居中。
% 三、正文在最后一个字符之后还有 glue、盒子、规则等内容时，命令后的源码空格
%     仍按这个字符处理，例如 |姓名 \CJKunderline{张三\hspace*{4em}} 学号| 中
%     的空格被删去；直接输入时这枚空格前面是 glue，会原样保留。正文直接以全角
%     右标点结尾时，命令后的空格和西文前的间距都应与直接输入一样不出现；标点
%     之后还有分组结束、\relax、{}、包装宏里的记号或正文末尾空格时，命令后的
%     空格与直接输入一样保留。嵌套线型命令的内层以全角右标点结尾时同样如此。
% 四、正文以语法空格开头时，这段空格先被画成装饰线，入口空格排在它之后，
%     装饰线在两者之间断开。
%
% 判据分三类：
%   - 节点列表（TEST 1、2、3、8、11、12、17，以及 TEST 18、19 里的 \EntryNodes
%     用例）：固定 glue 与装饰的相对位置。命令前的空格必须出现在第一个
%     \rule(*+*)x0.0 \penalty 10000 \cleaders（ulem 片段）之前；正文开头的语法空格画成的 \cleaders 在入口空格之后；嵌套装饰之后
%     的盒子保留 \raise 位移。只比较总宽度分辨不出这些位置。
%   - 与直接输入比较宽度（TEST 2、TEST 3 各一项，TEST 4 到 TEST 7、TEST 9、TEST 10、
%     TEST 13、TEST 15、TEST 16、TEST 18 到 TEST 20），打印 PASS／FAIL；装饰命令本身不
%     增加宽度，所以两者必须相等。TEST 16 的 nested-issue-fill-tie、
%     nested-fill-only-tie、nested-box-only-tie、three-level-issue-fill-tie 例外：
%     它们以命令两侧写 ~ 的装饰形式为 oracle，因为命令前空格保留是既定设计，与
%     直接输入不等宽。
%   - 段末自然宽度（TEST 14）：把装饰放在段末，比较行内容的自然宽度与同一
%     内容的 \hbox，确认段末删除行尾 glue 时没有删掉装饰末尾的像素补偿 glue。
% 节点列表的每个用例单独输出一页，页前的 CASE 行标明它是哪一个。全文件的
% 标签互不相同（TEST 13 以 cfr- 开头），看 PASS／FAIL 或 CASE 行即可知道出处。
% 每个用例之后都检查 capture 栈、暂停深度和 #1091 的入口状态已经归零。

\newsavebox{\FillBox}
\sbox{\FillBox}{\rule{8pt}{5pt}}
\newcommand\EntryAns[1]{#1\relax}
% 字符码为 32 的活动字符（\verb、\obeyspaces 下的空格就是这样的记号）。它不是
% 空格记号，标点之后遇到它时不能当作空格删去。
\begingroup
\lccode`\~=32
\lowercase{\endgroup
  \def~{z}%
  \newcommand\EntryActiveSpaceCase{中。~a}}
\newsavebox{\NestSameBox}
\sbox{\NestSameBox}{\CJKsout{中}}
\newbox\EntryCandidate
\newbox\EntryOracle
\newsavebox\EntryBox
\newsavebox\EntryBoxOracle
\sbox\EntryBoxOracle{中{ 中}}
\newsavebox\EntryBoxEcOracle
\xeCJKsetup{xCJKecglue=true}
\sbox\EntryBoxEcOracle{中{ 中}}
\xeCJKsetup{xCJKecglue=false}

\ExplSyntaxOn
\cs_new_protected:Npn \EntryAssertIdle #1
  {
    \bool_lazy_all:nF
      {
        { \int_compare_p:nNn { \g__xeCJK_boundary_capture_depth_int } = { 0 } }
        { \int_compare_p:nNn { \seq_count:N \g__xeCJK_boundary_active_seq } = { 0 } }
        { \int_compare_p:nNn { \g__xeCJK_boundary_suspend_depth_int } = { 0 } }
        { \int_compare_p:nNn { \g__xeCJK_ulem_entry_depth_int } = { 0 } }
        { ! \g__xeCJK_ulem_space_defer_bool }
      }
      { \TYPE { FAIL:~#1~left~capture~state~behind } }
  }
\ExplSyntaxOff

% #1 标签，#2 装饰写法，#3 直接输入 oracle
\newcommand\EntryWidth[3]{%
  \setbox\EntryCandidate=\hbox{#2}%
  \EntryAssertIdle{#1}%
  \setbox\EntryOracle=\hbox{#3}%
  \ifdim\wd\EntryCandidate=\wd\EntryOracle
    \TYPE{PASS: #1 (\the\wd\EntryCandidate)}%
  \else
    \TYPE{FAIL: #1 (\the\wd\EntryCandidate\space vs \the\wd\EntryOracle)}%
  \fi
}

% #1 标签，#2 内容；\loggingoutput 输出完整深度的节点列表，嵌套盒子里的节点也在内
\newcommand\EntryNodes[2]{%
  \setbox\EntryCandidate=\hbox{#2}%
  \EntryAssertIdle{#1}%
  \TYPE{CASE: #1}%
  \box\EntryCandidate
  \clearpage
}

% 仿 issue 的写法：issue 用 \CJKunderline* 包住西文 xxxx，这里换成
% \CJKunderline 与规则盒子；宏定义第二行行末的换行也是一枚空格
\newcommand{\myfillin}{%
  \sbox{\FillBox}{\rule{0.8em}{0.5em}}
  \CJKunderline{\hspace*{0.5em plus .5em minus .5em}\usebox{\FillBox}\hspace*{0.5em plus .5em minus .5em}}}
% issue 的原样写法
\newcommand{\issuefillin}{%
  \CJKunderline*
    {\hspace*{0.5em plus .5em minus .5em}xxxx\hspace*{0.5em plus .5em minus .5em}}}

% #1 标签，#2 内容；把 #2 放在段末排版，比较这一行内容的自然宽度与 \hbox{#2}
\newbox\EntryPar
\newcommand\EntryParEnd[2]{%
  \setbox\EntryPar=\vbox{\hsize=300pt \parindent=0pt \noindent #2\par
    \setbox0=\lastbox \global\setbox\EntryCandidate=\hbox{\unhbox0}}%
  \EntryAssertIdle{#1}%
  \setbox\EntryOracle=\hbox{#2}%
  \ifdim\wd\EntryCandidate=\wd\EntryOracle
    \TYPE{PASS: #1 (\the\wd\EntryCandidate)}%
  \else
    \TYPE{FAIL: #1 (\the\wd\EntryCandidate\space vs \the\wd\EntryOracle)}%
  \fi
}

\begin{document}

\START

\loggingoutput

% 普通空格与 ~ 写法下，填空线前后都各有 glue，不再有一枚跑到装饰之后。
\TEST{issue 1091 fill-in blank keeps the source space in front}{
  \EntryNodes{space}{普通字符 \myfillin{} 后续文字}
  \EntryNodes{tie}{普通字符~\myfillin{} 后续文字}
  \EntryNodes{issue-space}{普通字符 \issuefillin{} 后续文字}
  \EntryNodes{issue-tie}{普通字符~\issuefillin{} 后续文字}
}

% 正文先排出盒子、带零宽规则的 \hspace*、显式 glue 或 \quad：命令前的空格
% 排在第一个 ulem 片段之前，正文内部不再补左边界 glue。命令前是分组结束或
% 盒子加空格、正文先排出 \kern 再接嵌套命令或 \mbox 时同样如此
% （group-space-kern-then-nested、mbox-space-kern-then-mbox），再接 \textcolor、
% 用户分组里的汉字或原始 \hbox 时也是如此：记下的空格要等关闭片段盒子本层的
% \UL@stop 才排出，不能由用户分组里的 \UL@stop 排进片段盒子
% （group-space-kern-then-textcolor 等）；正文先有颜色命令、再排出 \kern 时同样只记下
% 空格（mbox-space-color-kern-then-nested、mbox-space-textcolor-kern-then-cjk）；
% \hspace* 写在用户分组里时也是如此，以 ~ 写法为位置对照（group-fill、group-fill-tie）。
% 用户分组里只有 \nobreak、随后是语法空格或 \hspace* 时，空片段之后下一段装饰线
% 之前就排出记下的空格，不落在两段装饰线之间（empty-group-then-*）。
% quad-mbox 的首字符在 \mbox 里，那里 ulem 已恢复 \ 的原义，左边界走普通 glue
% 通道；它同样不能在 \quad 与 x 之间补 \CJKecglue。
\TEST{source space goes before leading visible content}{
  \EntryNodes{box}{符 \CJKunderline{\usebox{\FillBox}} 后}
  \EntryNodes{hspace-star}{符 \CJKunderline{\hspace*{5pt}x} 后}
  \EntryNodes{hskip}{符 \CJKunderline{\hspace{5pt}x} 后}
  \EntryNodes{box-then-cjk}{符 \CJKunderline{\usebox{\FillBox}中} 后}
  \EntryNodes{quad}{符 \CJKunderline{\quad 中} 后}
  \EntryWidth{quad-mbox}{符\CJKunderline{\quad\mbox{x}}后}{符\quad\mbox{x}后}
  \EntryNodes{sout}{符 \CJKsout{\usebox{\FillBox}} 后}
  \EntryNodes{uline}{符 \uline{\usebox{\FillBox}} 后}
  \EntryNodes{nested}{符 \uline{\CJKsout{\usebox{\FillBox}}} 后}
  \EntryNodes{fbox-spaced}{前 \uline{\fbox{}中} 后}
  \EntryNodes{group-space-kern-then-nested}{{中} \CJKunderline{\kern1em\CJKsout{中中}\kern1em} 后}
  \EntryNodes{mbox-space-kern-then-mbox}{\mbox{中} \uline{\kern1pt\mbox{中}} 后}
  \EntryNodes{group-space-kern-then-textcolor}
    {{中} \CJKunderline{\kern1em\textcolor{red}{中中}\kern1em} 后}
  \EntryNodes{ctrl-space-kern-then-textcolor}{前\ \uline{\kern1pt\textcolor{red}{中}} 后}
  \EntryNodes{mbox-space-kern-then-color-group}{\mbox{中} \uline{\kern1pt{\color{red}中}} 后}
  \EntryNodes{mbox-space-group-nobreak}{\mbox{中} \uline{{\nobreak 中}} 后}
  \EntryNodes{group-space-kern-then-hbox}{{中} \uline{\kern1pt\hbox{中}}后}
  \EntryNodes{mbox-space-kern-then-group}{\mbox{中} \uline{\kern1pt{中}} 后}
  \EntryNodes{group-space-kern-math-then-nested}{{中} \uline{\kern1pt$a$\sout{中}} 后}
  \EntryNodes{mbox-space-color-kern-then-nested}{\mbox{中} \uline{\color{red}\kern1pt\sout{中}} 后}
  \EntryNodes{mbox-space-textcolor-kern-then-cjk}{\mbox{中} \uline{\textcolor{red}{\kern1pt}中} 后}
  \EntryNodes{group-fill}{前 \CJKunderline{\textbf{\hspace*{1em}xx\hspace*{1em}}} 后}
  \EntryNodes{group-fill-tie}{前~\CJKunderline{\textbf{\hspace*{1em}xx\hspace*{1em}}} 后}
  \EntryNodes{empty-group-then-space}{{中} \uline{{\nobreak} 中} 后}
  \EntryNodes{empty-group-then-space-tie}{{中}~\uline{{\nobreak} 中} 后}
  \EntryNodes{empty-group-then-fill}{{中} \CJKunderline{{\nobreak} \hspace*{2em}} 后}
  \EntryNodes{empty-group-then-fill-tie}{{中}~\CJKunderline{{\nobreak} \hspace*{2em}} 后}
}

% 正文开头只有颜色 special 这类不可见节点时，首个字符仍按原规则决定左边界：
% CJK 与 CJK 之间的源码空格按 CJKspace=false 删去。没有空格、也没有字符时
% 两侧都不补间距。正文以零宽的 \hspace 开头、命令前有空格时同样按首个字符处理，
% 左边界 glue 排在第一个 ulem 片段之前，零宽的 glue 不画成装饰线。其后是公式时，
% 入口在公式片段处解除，空格保留在装饰之前，与 ~ 写法等宽（hspace0-math-spaced）。
\TEST{invisible leading content keeps the first-character rule}{
  \EntryNodes{color-cjk}{符 \CJKunderline{\color{red}中} 后}
  \EntryNodes{color-latin}{符 \CJKunderline{\color{red}x} 后}
  \EntryNodes{no-space}{符\CJKunderline{\hspace*{5pt}}后}
  \EntryNodes{hspace0-spaced}{前 \uline{\hspace{0pt}中} 后}
  \EntryWidth{hspace0-math-spaced}{前 \uline{\hspace{0pt}$a$中} 后}{前~{\hspace{0pt}$a$中} 后}
}

% 没有字符的正文不产生额外的装饰或间距。
\TEST{empty body adds no decoration or spacing}{
  \EntryWidth{underline}{符\CJKunderline{}后}{符后}
  \EntryWidth{underline-relax}{符\CJKunderline{\relax}后}{符后}
  \EntryWidth{empty-uline}{符\uline{}后}{符后}
  \EntryWidth{empty-sout}{符\CJKsout{}后}{符后}
  \EntryWidth{empty-latin}{x\CJKunderline{}y}{xy}
}

% 正文末尾没有可读 marker 时，右边界按正文实际的末字符决定。
\TEST{right boundary follows the real last character}{
  \EntryWidth{nested-cjk}{\CJKunderline{\CJKsout{中}}文}{中文}
  \EntryWidth{nested-latin}{\CJKunderline{\CJKsout{中}}x}{中x}
  \EntryWidth{nested-space-cjk}{\CJKunderline{\CJKsout{中}} 文}{中 文}
  \EntryWidth{period-cjk}{\CJKunderline{中。}文}{中。文}
}

% 以全角左标点开头的正文与直接输入等宽；有源码空格时也一样。
\TEST{leading full-width punctuation}{
  \EntryWidth{fullleft-no-space}{书\CJKunderline{《红》}的}{书《红》的}
  \EntryWidth{fullleft-space}{书 \CJKunderline{《红》}的}{书 《红》的}
  \EntryWidth{uline-space}{书 \uline{「红」}的}{书 「红」的}
}

% 普通 CJK 与西文正文的左边界不受影响。
\TEST{ordinary first characters are unchanged}{
  \EntryWidth{cjk-space}{符 \CJKunderline{中} 后}{符 中 后}
  \EntryWidth{latin-space}{符 \CJKunderline{x} 后}{符 x 后}
  \EntryWidth{first-cjk}{符\CJKunderline{中}后}{符中后}
  \EntryWidth{first-latin}{符\CJKunderline{x}后}{符x后}
}

% 正文开头的语法空格画成装饰线，入口空格排在这段线之前。正文随后以字符开始时
% 入口空格仍按首类别处理：CJK 之间换成 \CJKglue，西文前保留空格。只有空格的正文
% 两侧各留一枚空格。
\TEST{leading syntax space is drawn after the source space}{
  \EntryNodes{lead-fill}{符 \CJKunderline{ \hspace*{2em} } 后}
  \EntryNodes{lead-box}{符 \CJKunderline{ \usebox{\FillBox}} 后}
  \EntryNodes{lead-cjk}{符 \CJKunderline{ 中} 后}
  \EntryNodes{lead-latin}{符 \CJKunderline{ x} 后}
  \EntryNodes{only-space}{符 \CJKunderline{ } 后}
  \EntryNodes{lead-uline}{符 \uline{ \hspace*{2em}} 后}
  \EntryNodes{lead-fullleft}{符 \CJKunderline{ 《中》} 后}
  \EntryNodes{lead-fullleft-latin}{x \CJKunderline{ 《中》} z}
}

% 正文最后一个字符之后还有别的内容时，命令后的空格与直接输入一样保留，后面的
% 字符也不补边界间距。正文以字符、颜色切换、\mbox 或嵌套线型命令结尾时仍按
% 这个字符处理。嵌套线型命令的内层正文以这些内容结尾时同样如此。
\TEST{trailing content after the last character}{
  \EntryWidth{hspace}{符 \CJKunderline{中\hspace*{2em}} 后}{符 中\hspace*{2em} 后}
  \EntryWidth{name}{姓名 \CJKunderline{张三\hspace*{4em}} 学号}{姓名 张三\hspace*{4em} 学号}
  \EntryWidth{fillbox}{符 \CJKunderline{中\usebox{\FillBox}} 后}{符 中\usebox{\FillBox}{} 后}
  \EntryWidth{tail-uline}{符 \uline{中\hspace*{2em}} 后}{符 中\hspace*{2em} 后}
  \EntryWidth{wave}{符 \CJKunderwave{中\hspace*{2em}} 后}{符 中\hspace*{2em} 后}
  \EntryWidth{sout-box}{符 \CJKsout{中\usebox{\FillBox}} 后}{符 中\usebox{\FillBox}{} 后}
  \EntryWidth{star}{符 \CJKunderline*{中\hspace*{2em}} 后}{符 中\hspace*{2em} 后}
  \EntryWidth{phantom}{符 \CJKunderline{\phantom{中}} 后}{符 \phantom{中} 后}
  \EntryWidth{phantom-after}{符 \CJKunderline{中\phantom{中}} 后}{符 中\phantom{中} 后}
  \EntryWidth{kern}{符 \CJKunderline{中\kern5pt} 后}{符 中\kern5pt{} 后}
  \EntryWidth{penalty}{符 \CJKunderline{中\penalty0} 后}{符 中\penalty0{} 后}
  \EntryWidth{special}{符 \CJKunderline{中\special{x}} 后}{符 中\special{x} 后}
  \EntryWidth{hbox}{符 \CJKunderline{中\hbox to 5pt{}} 后}{符 中\hbox to 5pt{} 后}
  \EntryWidth{rule}{符 \CJKunderline{中\rule{2pt}{2pt}} 后}{符 中\rule{2pt}{2pt} 后}
  \EntryWidth{tail-quad}{符 \CJKunderline{中\quad} 后}{符 中\quad{} 后}
  \EntryWidth{ctrl-space}{符 \CJKunderline{中\ } 后}{符 中\ {} 后}
  \EntryWidth{math-fill}{符 \CJKunderline{中$x$\hspace*{1em}} 后}{符 中$x$\hspace*{1em} 后}
  \EntryWidth{nested-fill}{符 \CJKunderline{\CJKsout{中}\hspace*{1em}} 后}{符 中\hspace*{1em} 后}
  \EntryWidth{nested-box}{符 \CJKunderline{\CJKsout{中}\hbox to 5pt{}} 后}{符 中\hbox to 5pt{} 后}
  \EntryWidth{nested-then-hbox}{符 \CJKunderline{\CJKsout{中}\hbox{中}} 后}{符 中\hbox{中} 后}
  \EntryWidth{nested-then-copy}{符 \CJKunderline{\CJKsout{中}\usebox{\NestSameBox}} 后}{符 中\usebox{\NestSameBox}{} 后}
  \EntryWidth{nested-fillbox}{符 \CJKunderline{\CJKsout{中}\usebox{\FillBox}} 后}{符 中\usebox{\FillBox}{} 后}
  \EntryWidth{space-then-fill}{符 \CJKunderline{中 \hspace*{1em}} 后}{符 中 \hspace*{1em} 后}
  \EntryWidth{box-then-space}{符 \CJKunderline{中\usebox{\FillBox} } 后}{符 {中\usebox{\FillBox} } 后}
  \EntryWidth{kern-then-space}{符 \CJKunderline{中\kern5pt\relax{} } 后}{符 {中\kern5pt\relax{} } 后}
  \EntryWidth{box-then-space-latin}{符\CJKunderline{中\usebox{\FillBox} }x}{符{中\usebox{\FillBox} }x}
  \EntryWidth{no-space-cjk}{符\CJKunderline{中\hspace*{1em}}后}{符中\hspace*{1em}后}
  \EntryWidth{no-space-latin}{符\CJKunderline{中\hspace*{1em}}x}{符中\hspace*{1em}x}
  \EntryWidth{box-no-space-latin}{符\CJKunderline{中\usebox{\FillBox}}x}{符中\usebox{\FillBox}{}x}
  \EntryWidth{last-cjk}{符 \CJKunderline{中} 后}{符 中 后}
  \EntryWidth{last-nested}{符 \CJKunderline{\CJKsout{中}} 后}{符 中 后}
  \EntryWidth{last-nested-uline}{符 \uline{\CJKsout{中}} 后}{符 中 后}
  \EntryWidth{last-color}{符 \CJKunderline{\textcolor{red}{中}} 后}{符 \textcolor{red}{中} 后}
  \EntryWidth{last-color-switch}{符 \CJKunderline{中\color{red}} 后}{符 {中\color{red}} 后}
  \EntryWidth{last-mbox}{符 \CJKunderline{中\mbox{文}} 后}{符 中\mbox{文} 后}
  \EntryWidth{last-underdot}{符 \CJKunderline{\CJKunderdot{中}} 后}{符 中 后}
  \EntryWidth{inner-fill}{中 \uline{\sout{中\hspace*{1em}}} 吗}{中 中\hspace*{1em} 吗}
  \EntryWidth{inner-fill-latin}{中\uline{\sout{中\hspace*{1em}}}x}{中中\hspace*{1em}x}
  \EntryWidth{inner-hspace}{中 \uline{\sout{中\hspace{1em}}} 吗}{中 中\hspace{1em} 吗}
  \EntryWidth{inner-quad}{中 \uline{\sout{中\quad}} 吗}{中 中\quad{} 吗}
  \EntryWidth{inner-fillbox}{中 \uline{\sout{中\usebox{\FillBox}}} 吗}{中 中\usebox{\FillBox}{} 吗}
  \EntryWidth{inner-fillbox-latin}{中\uline{\sout{中\usebox{\FillBox}}}x}{中中\usebox{\FillBox}{}x}
  \EntryWidth{inner-kern}{中 \uline{\sout{中\kern2pt}} 吗}{中 中\kern2pt{} 吗}
  \EntryWidth{inner-penalty}{中 \uline{\sout{中\penalty0}} 吗}{中 中\penalty0{} 吗}
  \EntryWidth{inner-special}{中 \uline{\sout{中\special{x}}} 吗}{中 中\special{x} 吗}
  \EntryWidth{inner-latin-fill}{中\uline{\sout{x\hspace*{1em}}}中}{中x\hspace*{1em}中}
  \EntryWidth{inner-period-cjk-fill}{中 \uline{\sout{中。中\hspace*{1em}}} 吗}{中 中。中\hspace*{1em} 吗}
