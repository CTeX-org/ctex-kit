  \EntryWidth{nested-ctrl-space-then-kern}{前\ \uline{\sout{\kern1pt中}} 后}{前\ {{\kern1pt中}} 后}
  \EntryWidth{nested-empty-group-space-then-tie}{前{} \uline{\sout{~中}} 后}{前{} {{~中}} 后}
  \EntryWidth{nested-mbox-space-then-rule}
    {\mbox{中} \CJKunderline{\CJKsout{\rule{1pt}{1pt}中}} 后}{\mbox{中} {{\rule{1pt}{1pt}中}} 后}
