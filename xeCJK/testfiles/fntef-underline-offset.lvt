\input{regression-test}

\documentclass{article}

\usepackage{xeCJK,xeCJKfntef}
\setCJKmainfont{FandolSong-Regular.otf}

\showboxdepth=5
\showboxbreadth=20

\newcount\centeredleaderscount
\newcount\expandedleaderscount
\newcount\alignedleaderscount
\makeatletter
\let\originalmarkoverwith\markoverwith
\def\markoverwith#1{%
  \ifx\ULleaders\cleaders
    \global\advance\centeredleaderscount\@ne
  \fi
  \ifx\ULleaders\xleaders
    \global\advance\expandedleaderscount\@ne
  \fi
  \ifx\ULleaders\leaders
    \global\advance\alignedleaderscount\@ne
  \fi
  \originalmarkoverwith{#1}}
\makeatother

\ExplSyntaxOn
\cs_new_protected:Npn \test_fntef_pattern_size:nn #1#2
  {
    \group_begin:
      #1 \selectfont
      \hbox_set:Nn \l_tmpa_box { \__xeCJK_fntef_wave_symbol: }
      \TYPE
        {
          Wave~unit~at~#2pt:
          ~wd=\dim_eval:n { \box_wd:N \l_tmpa_box },
          ~ht=\dim_eval:n { \box_ht:N \l_tmpa_box },
          ~dp=\dim_eval:n { \box_dp:N \l_tmpa_box }
        }
      \hbox_set:Nn \l_tmpa_box { \__xeCJK_fntef_xout_symbol: }
      \TYPE
        {
          Xout~unit~at~#2pt:
          ~wd=\dim_eval:n { \box_wd:N \l_tmpa_box },
          ~ht=\dim_eval:n { \box_ht:N \l_tmpa_box },
          ~dp=\dim_eval:n { \box_dp:N \l_tmpa_box }
        }
    \group_end:
  }
\NewDocumentCommand \TestFntefPatternSize { m m }
  { \test_fntef_pattern_size:nn {#1} {#2} }
\cs_new_protected:Npn \test_fntef_same_width:nn #1#2
  {
    \hbox_set:Nn \l_tmpa_box { 字 }
    \hbox_set:Nn \l_tmpb_box {#2}
    \dim_compare:nNnTF
      { \box_wd:N \l_tmpa_box } = { \box_wd:N \l_tmpb_box }
      { \TYPE{#1:~PASS} }
      {
        \TYPE
          {
            #1:~FAIL~
            direct=\dim_eval:n { \box_wd:N \l_tmpa_box },~
            decorated=\dim_eval:n { \box_wd:N \l_tmpb_box }
          }
      }
  }
\NewDocumentCommand \TestFntefSameWidth { m m }
  { \test_fntef_same_width:nn {#1} {#2} }
\cs_new_protected:Npn \test_fntef_empty:nn #1#2
  {
    \hbox_set:Nn \l_tmpa_box { }
    \hbox_set:Nn \l_tmpb_box {#2}
    \bool_lazy_all:nTF
      {
        {
          \dim_compare_p:nNn
            { \box_wd:N \l_tmpb_box } = { \box_wd:N \l_tmpa_box }
        }
        {
          \dim_compare_p:nNn
            { \box_ht:N \l_tmpb_box } = { \box_ht:N \l_tmpa_box }
        }
        {
          \dim_compare_p:nNn
            { \box_dp:N \l_tmpb_box } = { \box_dp:N \l_tmpa_box }
        }
      }
      { \TYPE{#1:~PASS} }
      {
        \TYPE
          {
            #1:~FAIL~
            wd=\dim_eval:n { \box_wd:N \l_tmpb_box },~
            ht=\dim_eval:n { \box_ht:N \l_tmpb_box },~
            dp=\dim_eval:n { \box_dp:N \l_tmpb_box }
          }
      }
  }
\NewDocumentCommand \TestFntefEmpty { m m }
  { \test_fntef_empty:nn {#1} {#2} }
\int_new:N \g__fntef_test_nested_right_int
\cs_new_protected:Npn \test_fntef_nested_right:nn #1#2
  {
    \group_begin:
      \int_gzero:N \g__fntef_test_nested_right_int
      \cs_set_eq:NN \__fntef_test_periodic_right_skip_aux:
        \__xeCJK_ulem_periodic_right_skip_aux:
      \cs_set_protected:Npn \__xeCJK_ulem_periodic_right_skip_aux:
        {
          \int_gincr:N \g__fntef_test_nested_right_int
          \__fntef_test_periodic_right_skip_aux:
        }
      \msg_redirect_name:nnn { xeCJK } { fntef-nesting } { none }
      \hbox_set:Nn \l_tmpa_box {#2}
      \int_compare:nNnTF { \g__fntef_test_nested_right_int } = { 1 }
        { \TYPE{#1:~PASS} }
        {
          \TYPE
            {
              #1:~FAIL~right-segments=
              \int_use:N \g__fntef_test_nested_right_int
            }
        }
    \group_end:
  }
\NewDocumentCommand \TestFntefNestedRight { m m }
  { \test_fntef_nested_right:nn {#1} {#2} }
\NewDocumentCommand \TestUseFntefRulePatterns { }
  {
    \cs_set_protected:Npn \__xeCJK_fntef_wave_symbol:
      {
        \tex_vrule:D
          width  \dim_eval:n { 1 em / 4 }
          height .15 em
          depth  0 pt
      }
    \cs_set_protected:Npn \__xeCJK_fntef_xout_symbol:
      {
        \tex_vrule:D
          width  \dim_eval:n { 1 em / 4 }
          height .93 em
          depth  0 pt
      }
  }
\ExplSyntaxOff

\begin{document}

\START

\loggingoutput

\OMIT
\setbox0=\hbox{\hskip3pt\CJKunderline{国}}
\setbox2=\hbox{\hskip3pt\CJKunderline-{国}\CJKunderline-{国}}
\setbox4=\hbox{\CJKxout{国}}
\TIMO

\TEST{CJKunderline uses centered leaders at a nonzero offset}{
  \box0
  \clearpage
}

\TEST{CJKunderline subtract keeps centered end spacing}{
  \box2
  \clearpage
}

\TEST{line commands select the intended leaders}{
  \global\centeredleaderscount=0
  \global\expandedleaderscount=0
  \global\alignedleaderscount=0
  \setbox4=\hbox{%
    \CJKunderdblline{国}\CJKunderdblline-{国}%
    \CJKunderwave{国国}\CJKunderwave-{国国}%
    \CJKsout{国}\CJKsout-{国}%
    \CJKxout{国}\CJKxout-{国}%
    \CJKunderanyline{.2em}{\rule{.2em}{.4pt}}{国}%
    \CJKunderanyline-{.2em}{\rule{.2em}{.4pt}}{国}}
  \TYPE{Centered leader calls: \the\centeredleaderscount}
  \TYPE{Expanded leader calls: \the\expandedleaderscount}
  \TYPE{Aligned leader calls: \the\alignedleaderscount}
}

\TEST{fntef patterns scale to one quarter em}{
  \TestFntefPatternSize{\fontsize{8}{10}}{8}
  \TestFntefPatternSize{\fontsize{10.53937}{13}}{10.53937}
  \TestFntefPatternSize{\fontsize{15}{18}}{15}
}

\TEST{single-character periodic decorations preserve text width}{
  \TestFntefSameWidth{CJKunderwave}{\CJKunderwave{字}}
  \TestFntefSameWidth{CJKunderwave subtract}{\CJKunderwave-{字}}
  \TestFntefSameWidth{CJKxout}{\CJKxout{字}}
  \TestFntefSameWidth{CJKxout subtract}{\CJKxout-{字}}
}

\TEST{empty periodic decorations remain empty}{
  \TestFntefEmpty{CJKunderwave empty}{\CJKunderwave{}}
  \TestFntefEmpty{CJKunderwave subtract empty}{\CJKunderwave-{}}
  \TestFntefEmpty{CJKxout empty}{\CJKxout{}}
  \TestFntefEmpty{CJKxout subtract empty}{\CJKxout-{}}
  \TestFntefEmpty{CJKunderwave node-free}{\CJKunderwave{\relax}}
  \TestFntefEmpty{CJKunderwave subtract node-free}{\CJKunderwave-{\relax}}
  \TestFntefEmpty{CJKxout node-free}{\CJKxout{\relax}}
  \TestFntefEmpty{CJKxout subtract node-free}{\CJKxout-{\relax}}
}

\TestUseFntefRulePatterns

\TEST{CJKunderwave shares an aligned grid and subtracts its endpoints}{
  \setbox4=\hbox{\hskip3pt
    \CJKunderwave{国国}\quad
    \CJKunderwave{国，国}\quad
    \CJKunderwave-{国国}\CJKunderwave-{国国}\quad
    {\fontsize{10.95}{13.6}\selectfont
      \CJKunderwave{国国}\quad
      \CJKunderwave-{国国}\CJKunderwave-{国国}}}
  \box4
  \clearpage
}

\TEST{CJKxout shares an aligned grid and subtracts its endpoints}{
  \setbox4=\hbox{\hskip3pt
    \CJKxout{国国}\quad
    \CJKxout{国，国}\quad
    \CJKxout-{国国}\CJKxout-{国国}\quad
    {\fontsize{10.95}{13.6}\selectfont
      \CJKxout{国国}\quad
      \CJKxout-{国国}\CJKxout-{国国}}}
  \box4
  \clearpage
}

\TEST{custom underwave symbol remains supported}{
  \begingroup
    \global\expandedleaderscount=0
    \xeCJKsetup{underwave/symbol=\rule{.5em}{.4pt}}
    \setbox4=\hbox{\CJKunderwave{国国}}
    \TYPE{Custom underwave text width: \the\wd4}
    \TYPE{Custom underwave expanded leader calls: \the\expandedleaderscount}
    \box4
    \clearpage
  \endgroup
}

\TEST{periodic decorations survive repeated saved-box use}{
  \setbox4=\hbox{\CJKunderwave{国国}\quad\CJKxout{国国}}
  \setbox6=\hbox{\copy4\copy4}
  \TYPE{Saved decoration width: \the\wd4}
  \TYPE{Repeated decoration width: \the\wd6}
  \box6
  \clearpage
}

\TEST{nested periodic decorations keep the outer right-end state}{
  \TestFntefNestedRight{wave in wave}
    {\CJKunderwave{字字\CJKunderwave{字}}}
  \TestFntefNestedRight{xout subtract in wave subtract}
    {\CJKunderwave-{字字\CJKxout-{字}}}
  \TestFntefNestedRight{wave in xout}
    {\CJKxout{字字\CJKunderwave{字}}}
  \TestFntefNestedRight{xout subtract in xout subtract}
    {\CJKxout-{字字\CJKxout-{字}}}
}

\END

\end{document}
