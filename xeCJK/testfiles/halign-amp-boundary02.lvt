\input{regression-test}

\documentclass{article}

\usepackage{amsmath}
\usepackage{xcolor}
\usepackage{xeCJK}
\setCJKmainfont{FandolSong-Regular.otf}

\begin{document}

\START

\loggingoutput

% #1043 的第二种语境：tabular（而非 eqnarray）里 \colorbox 参数含 catcode-4 的 &。
% 机制与判别力说明见 halign-amp-boundary01.lvt。
%
% 独立成文件而非并入 01：xeCJK 的 checkopts 带 -halt-on-error，缺陷态下 01 的用例
% 一报错就中止编译，同一文件里其后的 TEST 出现 0 次、判别力无法观察。
% 判别力已实测：删除 \@@_boundary_math_set:n 体内的替换后本文件 rc 1。

\TEST{colorbox with ampersand in tabular}{
  \begin{tabular}{c}
    \colorbox{yellow}{$\begin{array}{cc}1 &0\end{array}$}\\
  \end{tabular}
  \clearpage
}

\END

\end{document}
