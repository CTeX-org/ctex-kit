\input{regression-test}

\documentclass{article}

\usepackage{xeCJK,xeCJKfntef,color}
\setCJKmainfont{FandolSong-Regular.otf}

\ExplSyntaxOn
\cs_set_protected:Npn \__xeCJK_fntef_wave_symbol:
  { \tex_vrule:D width \dim_eval:n { 1 em / 4 } height .15 em depth 0 pt }
\cs_set_protected:Npn \__xeCJK_fntef_xout_symbol:
  { \tex_vrule:D width \dim_eval:n { 1 em / 4 } height .80 em depth 0 pt }
\cs_set_protected:Npn \__xeCJK_fntef_wave_left_endpoint_symbol:
  { \tex_vrule:D width \dim_eval:n { 1 em / 8 } height .15 em depth 0 pt }
\cs_set_eq:NN \__xeCJK_fntef_wave_right_endpoint_symbol:
  \__xeCJK_fntef_wave_left_endpoint_symbol:
\cs_set_protected:Npn \__xeCJK_fntef_xout_left_endpoint_symbol:
  { \tex_vrule:D width \dim_eval:n { 1 em / 8 } height .40 em depth 0 pt }
\cs_set_eq:NN \__xeCJK_fntef_xout_right_endpoint_symbol:
  \__xeCJK_fntef_xout_left_endpoint_symbol:
\ExplSyntaxOff

\begin{document}

\START

\loggingoutput

\TEST{CJKunderline across linebreak}{
  \hsize=8em
  \CJKunderline{字字字字字字字字字字字字字字字字字字字字}
  \clearpage
}

\TEST{CJKsout with custom options}{
  \hsize=15em
  \CJKsout*[thickness=2.5ex, format=\color{yellow}]{虚室生白，吉祥止止。}
  \clearpage
}

\TEST{CJKunderline star continuous}{
  \hsize=8em
  \CJKunderline*{字字字字字字字字字字字字字字字字字字字字}
  \clearpage
}

\TEST{CJKunderwave across linebreak}{
  \hsize=8.5em
  \CJKunderwave{字字字字字字字字字字字字}
  \par
  \CJKunderwave-{字字字字字字}\CJKunderwave-{字字字字字字}
  \clearpage
}

\TEST{CJKxout across linebreak}{
  \hsize=8.5em
  \CJKxout{字字字字字字字字字字字字}
  \par
  \CJKxout-{字字字字字字}\CJKxout-{字字字字字字}
  \clearpage
}

\END

\end{document}
