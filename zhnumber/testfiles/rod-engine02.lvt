%
%% \zhrod 在不支持的引擎下必须报错 (#366).
%%
%% 为什么单独一个文件: 本仓库 support/build-config.lua 设了 checkopts = "-halt-on-error",
%% 抛错的断言会让其后所有 \TEST 静默不执行而 check 仍报绿, 所以「一个 .lvt 只能断言一次
%% 抛错」。rod-engine01 那一次给了 \zhrodbox, \zhrod 只能另开一个文件 —— 否则它的报错
%% 分支零覆盖 (实测: 把 \zhrod 的报错分支改成静默的 \typeout, 两套 check 仍全绿)。
%% 这条约束与 #1008 的 counter-options01/02 拆分同源。
\documentclass{article}
\usepackage{zhnumber}
\begin{document}
\START
\ExplSyntaxOn

%% 支持的引擎下产出算筹字符; 不支持的引擎下报「需要 XeTeX 或 LuaTeX」并终止.
%% 必须真的执行 \zhrod —— 不支持的引擎下它是 protected 的, 只用 \tl_set:Ne 捕获不会
%% 触发报错 (这一点 #1008 已记过)。
\TEST{zhrod~output~or~error}{
  \zhrod { 12 }
}

\ExplSyntaxOff
\END
\end{document}
