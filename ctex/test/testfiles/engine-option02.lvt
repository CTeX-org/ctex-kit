\input{regression-test}

\documentclass{article}

\ExplSyntaxOn

% ctex aborts when the engine file named by the option does not exist. Report
% that message and stop: the rejected load must not continue into the missing
% file. The critical message is raised inside a conditional, so \END would also
% record "Bad conditionals"; write the end marker it would write and end the
% run with the primitive instead.
\cs_new_eq:NN \__ctex_test_msg_critical:nnn \msg_critical:nnn
\cs_set_protected:Npn \msg_critical:nnn #1#2#3
  {
    \str_if_eq:nnTF { #1 / #2 } { ctex / engine-file-not-found }
      {
        \START
        \AUTHOR{Mingyu ~ Hsia}
        \TYPE { engine~file~not~found:~#3 }
        \TYPE {^^JEND-TEST-LOG^^J}
        \use:c { @@end }
      }
      { \__ctex_test_msg_critical:nnn {#1} {#2} {#3} }
  }

\ExplSyntaxOff

\usepackage[engine = doesnotexist]{ctex}
\end{document}
