\input{regression-test}

%% 查不到读音时的报错路径 (#550, XeTeX / xeCJK 路线).
%%
%% 与 pinyin-query02 分开: checkopts 带 -halt-on-error, 第一处错误即终止编译,
%% 同一文件里报错之后的断言静默不执行而 check 仍可能报绿. 中断源是该门禁选项,
%% 不是 \msg_expandable_error:nnn 的语义 (不加该选项时后续断言照常执行).

\documentclass{article}
\usepackage{xeCJK}
\usepackage[query]{xpinyin}
\setCJKmainfont{FandolSong-Regular.otf}

\begin{document}

\START

%% 报错必须在可展开的上下文里也发得出来.
%%
%% \msg_error:nnn 是 protected 的: 在 \edef 里它既不报错也不展开, 会把自己
%% 整条原样留在结果里, 于是错误的排序键被静默写出去. 所以报错要走
%% \msg_expandable_error:nnn.
%%
%% 这一项用「查不到读音」这条路径来固定该行为: 数据库里没有的字符 (拉丁字母 Q)
%% 走 \@@_query_missing:n. 若它退回 protected 形式, \edef 的结果里会出现
%% \__xpinyin_query_missing:n 而不是空, 这一格随之变化.
\TYPE{=== error in expandable context ===}
\edef\XPYmiss{\xpinyinvalue{Q}}
\TYPE{missing-in-edef: [\meaning\XPYmiss]}



\END

\end{document}
