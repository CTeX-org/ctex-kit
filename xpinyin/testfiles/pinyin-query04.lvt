%% 参数校验: 花括号包一层的情形 (#550, XeTeX / xeCJK 路线).
%%
%% 与 pinyin-query02 分开的原因同该文件: checkopts 带 -halt-on-error, 一个文件
%% 里只有第一处报错断言会执行. `{{中}}` 与 `\XPYhz` 走的是同一机制 ——
%% \tl_count:n 把两者各算一个记号, 会放它们过去, 随后照旧漏出底层 TeX 错误;
%% \str_count:n 先转成字符串再数, 能一并挡住. 两格分列以各自保有判别力.
%%
%% 判据是**报错本身**: -halt-on-error 下第一处错误即终止编译, 所以下面那行
%% \TYPE 到不了, 所以下面那行已注释掉; 基线里固定的是错误信息与出错位置.
%% (实测: 它在 .tlg 里从未出现, 注释掉前后基线逐字节相同.)

\documentclass{article}
\usepackage{xeCJK}
\usepackage[query]{xpinyin}
\setCJKmainfont{FandolSong-Regular.otf}

\begin{document}

\START

\TYPE{=== argument check: braced group ===}
\edef\XPYbraced{\xpinyinvalue{{中}}}
%% 下面这行到不了 (见上), 保留是为了说明当初想断言什么; 真正的判据在报错本身.
%% \TYPE{braced: [\meaning\XPYbraced]}

\END

\end{document}
