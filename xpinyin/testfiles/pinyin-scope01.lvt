\input{regression-test}

%% 注音的开关与作用域 (XeTeX / xeCJK 路线).
%%
%% 本文件断言的是「哪些汉字被注了音、注的是什么」, 这两件事都**不能用盒子尺寸
%% 观察**: \@@_make_pinyin_box:nnn 把拼音放进 \hbox_overlap_right:n 这个零宽盒子,
%% 汉字之外不占位置, 所以换读音或整段关掉注音, 宽度都不变 (实测
%% `\xpinyin{长}{chang2}` 与 `\xpinyin{长}{zhang3}` 同为 10pt, 注音与不注音的
%% `汉语` 同为 20pt). 尺寸维度见 pinyin-setup01.lvt.
%%
%% 所以这里让页面真正输出, 用 \loggingoutput 把 shipout 的节点列表写进日志:
%% 拼音字形以 3.99994pt (缺省 ratio .4 下的 10pt 正文) 出现, 汉字以 10pt 出现,
%% 两者在基线里一眼可分.
%%
%% 不用 \showbox / \box_log:N —— 它们抛 `! OK.`, 而 checkopts 带 -halt-on-error,
%% 会当场终止编译, 其后用例静默不执行却仍可能报绿 (实测如此).

\documentclass{article}
\usepackage{xeCJK}
\usepackage{xpinyin}
\usepackage{color}

\setCJKmainfont{FandolSong-Regular.otf}
\newfontfamily\PinyinTestFont{DejaVuSerif.ttf}
\xpinyinsetup{font=\PinyinTestFont}

\begin{document}

\OMIT
\hbox{\PinyinTestFont ma}\hbox{\pinyin{ma1}}\hbox{\xpinyin*{文}}
\TIMO

\START

\loggingoutput

%% 1. \xpinyin* 给范围内每个汉字注音.
\xpinyin*{汉语拼音}\par

%% 2. \disablepinyin 之后的汉字不再注音; \enablepinyin 恢复.
%%    基线里应当只看到「汉」和「文」的拼音, 中间的「语」只有汉字没有拼音.
\xpinyin*{汉\disablepinyin 语\enablepinyin 文}\par

%% 3./4. \xpinyin 指定读音覆盖数据库首选读音, 与不指定时形成对照.
%%
%% 指定的读音**必须与数据库首选不同**, 否则这一对用例恒真.
%% 「长」在 xpinyin.db 里是 `\XPYU{长}{38271}{zhǎng}`, 首选就是 zhǎng
%% (多音读音是 `cháng,zhǎng`) —— 初版写 `\xpinyin{长}{zhang3}` 要的正是首选值,
%% 第 3、4 项输出完全相同, 什么也没验证.
%% 现在第 3 项显式要 cháng (非首选), 与第 4 项的 zhǎng 构成真正的对照.
\xpinyin{长}{chang2}\par
\xpinyin*{长}\par

%% 5. pinyinscope 环境形式, 与 \xpinyin* 等价.
\begin{pinyinscope}
汉语
\end{pinyinscope}\par

%% 6. 环境的可选参数只在环境内生效, 出环境后应当回到缺省 ratio (.4).
%%
%% 基线里的定位办法 (基线有 28 处 3.99994pt, 需要说明看哪一处): 本项是全文件
%% **唯一**出现 8.00003pt 的地方 —— 环境内的「汉」用 ratio=.8 排成 8.00003pt,
%% 紧随其后、环境外的「语」回到缺省的 3.99994pt. 两行在基线里相邻, 对照即在
%% 该处; 若可选参数泄漏到环境外, 后一行会同为 8.00003pt.
\begin{pinyinscope}[ratio=.8]
汉
\end{pinyinscope}\xpinyin*{语}\par

%% 7. 多音字读音本身: 「重」在数据库里带多个读音 (`\XPYUM{重}{37325}{chóng,zhòng}`),
%%    首选是 zhòng.
\xpinyin*{重要}\par

%% 7b. multiple 键: 只给**多音字**的拼音附加格式, 单音字不受影响.
%%
%% 判据只能是节点列表: 颜色不改变任何尺寸, 所以 pinyin-setup01 那种宽高比较
%% 完全看不见这个键 (那里固定的正是「加了 format 后尺寸不变」). 这里让
%% `\special{color push rgb 1 0 0}` 本身进基线.
%%
%% 三格构成对照, 缺一不可 —— 只写第一格时, 把「是否多音字」的判断去掉
%% (即一律套用 multiple) 也照样通过:
%%   * 「重」是多音字 -> 拼音被 color push/pop 包住;
%%   * 「文」不是多音字 (数据库只有 \XPYU 没有 \XPYUM) -> 同样设了 multiple
%%     也不应着色;
%%   * 不设 multiple 的「重」-> 不应着色, 说明着色确实来自这个键.
\xpinyin*[multiple=\color{red}]{重}\par
\xpinyin*[multiple=\color{red}]{文}\par
\xpinyin*{重}\par

%% 7c. format 键: 给**全部**拼音附加格式, 与 multiple 只管多音字正好相反.
%%
%% 这一项与 7b 互为对照, 两者都需要: 只有 7b 时, 把 format 与 multiple 的作用
%% 范围搞混 (例如让 format 也只作用于多音字) 不会被任何用例发现.
%% 用蓝色而非红色, 使基线里两个键的着色可以分辨。
%%
%% pinyin-setup01 对 format 的断言只是「加了它尺寸不变」, 那是必要的但看不见
%% 着色本身; 着色路径 (`\l_@@_format_tl`) 必须在这里以节点列表固定。
%%   * 单音字「文」设 format -> 应着色 (对比 7b: 设 multiple 时它不着色);
%%   * 不设 format 的「文」-> 不应着色。
\xpinyin*[format=\color{blue}]{文}\par
\xpinyin*{文}\par

%% 8. 嵌套: \xpinyin 出现在 \xpinyin* 内部时, 内层指定的读音优先, 外层其余汉字
%%    仍走数据库.
%%    同样要挑非首选读音才有判别力: 「重」的数据库首选是 zhòng
%%    (`\XPYU{重}{37325}{zhòng}`), 所以这里指定 chóng, 与第 7 项的 zhòng 对照.
\xpinyin*{\xpinyin{重}{chong2}要}\par

%% 9. footnote 缺省为 false: 脚注里的汉字不注音.
%%    \l_@@_restore_footnote_tl 靠 \@parboxrestore 在 grouptype 11 时关掉注音,
%%    所以观察点是脚注文本里的汉字**没有**拼音伴随.
\begin{pinyinscope}
汉\footnote{语}
\end{pinyinscope}\par

%% 10. \setpinyin: 改写数据库里某个字的首选读音, 影响其后**所有**自动注音,
%%     与 \xpinyin 的「只改这一处」不同 (第 3 项).
%%
%%     判别力同样要挑非首选读音: 「长」的数据库首选是 zhǎng, 这里改成 cháng.
%%     两格对照 —— 改写生效后 \xpinyin*{长} 应得 cháng (而第 4 项同样的
%%     \xpinyin*{长} 在改写之前得的是 zhǎng, 两者在同一份基线里可直接对比)。
%%     `\setpinyin` 是手册里的公开命令, 此前整个测试集对它零覆盖。
\setpinyin{长}{chang2}
\xpinyin*{长}\par
%% 改写是持久的, 不限于紧随其后的那一次注音.
\xpinyin*{长}\par

\newpage

\END

\end{document}
