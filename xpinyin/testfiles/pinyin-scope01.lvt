\input{regression-test}

%% 注音的开关与作用域 (XeTeX / xeCJK 路线).
%%
%% 本文件断言的是「哪些汉字被注了音、注的是什么」, 这两件事都**不能用盒子尺寸
%% 观察**: \@@_make_pinyin_box:nnn 把拼音放进 \hbox_overlap_right:n 这个零宽盒子,
%% 汉字之外不占位置, 所以换读音或整段关掉注音, 宽度都不变 (实测
%% `\xpinyin{长}{chang2}` 与 `\xpinyin{长}{zhang3}` 同为 10pt, 注音与不注音的
%% `汉语` 同为 20pt). 尺寸维度见 pinyin-setup01.lvt.
%%
%% 所以这里让页面真正输出, 用 \loggingoutput 把 shipout 的节点列表写进日志:
%% 拼音字形以 3.99994pt (缺省 ratio .4 下的 10pt 正文) 出现, 汉字以 10pt 出现,
%% 两者在基线里一眼可分.
%%
%% 不用 \showbox / \box_log:N —— 它们抛 `! OK.`, 而 checkopts 带 -halt-on-error,
%% 会当场终止编译, 其后用例静默不执行却仍可能报绿 (实测如此).

\documentclass{article}
\usepackage{xeCJK}
\usepackage{xpinyin}
\usepackage{color}

\setCJKmainfont{FandolSong-Regular.otf}
\newfontfamily\PinyinTestFont{DejaVuSerif.ttf}
\xpinyinsetup{font=\PinyinTestFont}

\begin{document}

\OMIT
\hbox{\PinyinTestFont ma}\hbox{\pinyin{ma1}}\hbox{\xpinyin*{文}}
\TIMO

\START

\loggingoutput

%% 1. \xpinyin* 给范围内每个汉字注音.
\xpinyin*{汉语拼音}\par

%% 2. \disablepinyin 之后的汉字不再注音; \enablepinyin 恢复.
%%    基线里应当只看到「汉」和「文」的拼音, 中间的「语」只有汉字没有拼音.
\xpinyin*{汉\disablepinyin 语\enablepinyin 文}\par

%% 2b. \l_@@_enable_all_bool 是局部赋值, 随 TeX 分组恢复.
%%
%% \disablepinyin* 用的是 \bool_set_false:N (局部) 而非 \bool_gset_false:N,
%% 所以退组后总开关应自动回到真, 不需要显式 \enablepinyin.
%%
%% 这一项的写法有两个**必要**条件, 少任何一个都会变成恒真断言, 两者都是实测
%% 把 \bool_set_false:N 改成 \bool_gset_false:N 后逐项比对得出的:
%%
%% (1) 组外的观察点必须用**不带星号**的 \xpinyin. \xpinyin* 的星号分支进组后
%%     无条件调 \enablepinyin (见 \xpinyin 的星号分支), 而 \enablepinyin 会把总开关
%%     重新置真 (\enablepinyin 的第一个 \bool_if:NF 块) —— 它自己就把泄漏的禁用状态修好了.
%%
%% (2) **本项之前不能让 \l_@@_enable_bool 为真**, 所以这一段刻意放在所有
%%     \enablepinyin / \xpinyin* 之前 (后面的 2c、2d 两段都在本段之后
%%     \enablepinyin, 见那里的说明). 原因: \disablepinyin 的第二个块以
%%     `\bool_if:NT \l_@@_enable_bool` 为条件 (\disablepinyin 的第二个块). en 为真时, 注音会经由
%%     \@@_replace_CJKsymbol: 装好的 \CJKsymbol 自动钩子产生, 那条路**不查**
%%     \l_@@_enable_all_bool —— 于是即便 all 泄漏成假, 输出照旧.
%%     (探针实测: 两种写法下退组后读到的 all **都是** F; 区别不在 all 的值,
%%      而在 en 为真时多了一条绕过 all 的出口. 初版注释说成「all 被拉回真」,
%%      与实测不符, 已更正.)
%%     实测: 组前先调 \enablepinyin (en=T) 时, 变异后本项逐字节不变;
%%     组前 en=F 时, 变异后 `3.99994 yīn` 消失.
%%
%% 一并记下一条方法教训: 变异后**整份文件**确实变红过, 但红的是既有的第
%% 3/7b/7c/8 项, 与本项无关. 「整文件变红」不足以判定单项判别力, 必须按项
%% 切分比对 —— 初版正是被这一点误导, 把一条恒真断言当成有效覆盖.
%%
%% 判据: 组外的「音」有拼音 (3.99994pt 的 yīn); 变异下该行消失.
{\disablepinyin*}%
\xpinyin{音}{yin1}\par

%% 2c. 不带星号的 \disablepinyin 只关掉**自动**注音, 显式指定读音仍然生效.
%%
%% 这是两个布尔的分工: \disablepinyin 只置 \l_@@_enable_bool 为假, 而
%% \l_@@_enable_all_bool 仍为真, 所以 \xpinyin 的主分支照常走, 显式读音照排.
%% 第 2 项只覆盖了「自动注音被关掉」这一半, 单独看它无法区分「只关自动注音」
%% 与「把 \xpinyin 整个关掉」—— 后者若发生, 第 2 项仍然通过.
%%
%% 实测 (纯 xelatex, 不经 l3build): 本行的「语」得到 yǔ, 下一行 \xpinyin* 的
%% 「文」也得到 wén, 两者都在基线里以 3.99994pt 出现.
{\disablepinyin
\xpinyin{语}{yu3}\par
\xpinyin*{文}\par}

%% 2d. 带星号的 \disablepinyin* 是总开关: 显式读音与 \xpinyin* 一并失效.
%%
%% 与 2c 构成对照, 缺一不可 —— 只有 2c 时, 星号参数根本没被消费 (或消费了却
%% 不置 \l_@@_enable_all_bool) 都不会被发现; 只有 2d 时, 又无法说明普通形式
%% 保留了显式注音的能力.
%%
%% 判据是这两行**都不出现** 3.99994pt 的拼音字形, 只有 10pt 的汉字.
%% 实测: \disablepinyin* 之后 yǔ 与 wén 都不出现 (对照 2c 两者都出现).
{\disablepinyin*
\xpinyin{语}{yu3}\par
\xpinyin*{文}\par}

%% 2e. pinyinscope 环境内的禁用同样随环境结束恢复.
%%
%% 这才是 #265 报告的原始场景 (报告说的是「在 pinyinscope 环境或 TeX 分组内
%% 调用 \disablepinyin 时作用域泄漏」), 2b 用的是裸分组, 覆盖不到环境这一路.
%% 注意 pinyinscope 自己在开头就调 \enablepinyin, 所以按 2b 条件 (2) 的分析,
%% 这一项对全局赋值变异**没有**判别力 —— 它固定的是环境这条路径的正常输出
%% (环境内注音、环境外仍注音), 属回归价值而非变异判别力, 如实记在这里.
\begin{pinyinscope}
文
\end{pinyinscope}
\xpinyin{音}{yin1}\par

%% 2f. \enablepinyin 能把总开关重新置真 (即 \disablepinyin* 之后可恢复).
%%
%% \enablepinyin 的第一件事就是 \bool_if:NF \l_@@_enable_all_bool
%% { \bool_set_true:N \l_@@_enable_all_bool } (它的第一个 \bool_if:NF 块).
%% 这条恢复路径此前没有被任何用例固定.
%%
%% 观察点同样必须用**不带星号**的形式, 理由与 2b 的条件 (1) 不同:
%% \xpinyin* 那条路的注音是由 \CJKsymbol 自动钩子产生的, 不查
%% \l_@@_enable_all_bool, 所以拿它观察时这一项恒真 —— 实测把 \enablepinyin 那个守卫改成
%% \bool_if:NF \c_true_bool (即 \enablepinyin 永不置真总开关) 后, 用
%% \xpinyin*{语} 的写法整份文件仍全绿.
%% 读音取非首选的 chang2 ("长"数据库首选是 zhǎng), 使这一行与第 4 项的
%% \xpinyin*{长} 在基线里可区分.
%% 判据: 这一行应出现 cháng 的拼音; 上述变异下该行消失.
{\disablepinyin*
\enablepinyin
\xpinyin{长}{chang2}\par}

%% 3./4. \xpinyin 指定读音覆盖数据库首选读音, 与不指定时形成对照.
%%
%% 指定的读音**必须与数据库首选不同**, 否则这一对用例恒真.
%% 「长」在 xpinyin.db 里是 `\XPYU{长}{38271}{zhǎng}`, 首选就是 zhǎng
%% (多音读音是 `cháng,zhǎng`) —— 初版写 `\xpinyin{长}{zhang3}` 要的正是首选值,
%% 第 3、4 项输出完全相同, 什么也没验证.
%% 现在第 3 项显式要 cháng (非首选), 与第 4 项的 zhǎng 构成真正的对照.
\xpinyin{长}{chang2}\par
\xpinyin*{长}\par

%% 5. pinyinscope 环境形式, 与 \xpinyin* 等价.
\begin{pinyinscope}
汉语
\end{pinyinscope}\par

%% 6. 环境的可选参数只在环境内生效, 出环境后应当回到缺省 ratio (.4).
%%
%% 基线里的定位办法 (缺省字号出现 28 次, 需要说明看哪一处): 基线记的是字体
%% 规格而非带单位的尺寸, 形如 `\TU/DejaVuSerif.ttf(0)/m/n/3.99994`, 所以要
%% grep 不带 pt 的数字. 本项是全文件**唯一**出现 `m/n/8.00003` 的地方 ——
%% 环境内的「汉」按 ratio=.8 排成该字号, 紧随其后、环境外的「语」回到缺省的
%% `m/n/3.99994`. 两处按 `m/n/` 行前后相接 (基线原文里隔着 13 行 kern／glue／
%% special 与汉字字体行), 对照即在该处; 若可选参数泄漏到环境外, 后一处会同为
%% 8.00003.
\begin{pinyinscope}[ratio=.8]
汉
\end{pinyinscope}\xpinyin*{语}\par

%% 7. 多音字读音本身: 「重」在数据库里带多个读音 (`\XPYUM{重}{37325}{chóng,zhòng}`),
%%    首选是 zhòng.
\xpinyin*{重要}\par

%% 7b. multiple 键: 只给**多音字**的拼音附加格式, 单音字不受影响.
%%
%% 判据只能是节点列表: 颜色不改变任何尺寸, 所以 pinyin-setup01 那种宽高比较
%% 完全看不见这个键 (那里固定的正是「加了 format 后尺寸不变」). 这里让
%% `\special{color push rgb 1 0 0}` 本身进基线.
%%
%% 三格构成对照, 缺一不可 —— 只写第一格时, 把「是否多音字」的判断去掉
%% (即一律套用 multiple) 也照样通过:
%%   * 「重」是多音字 -> 拼音被 color push/pop 包住;
%%   * 「文」不是多音字 (数据库只有 \XPYU 没有 \XPYUM) -> 同样设了 multiple
%%     也不应着色;
%%   * 不设 multiple 的「重」-> 不应着色, 说明着色确实来自这个键.
\xpinyin*[multiple=\color{red}]{重}\par
\xpinyin*[multiple=\color{red}]{文}\par
\xpinyin*{重}\par

%% 7c. format 键: 给**全部**拼音附加格式, 与 multiple 只管多音字正好相反.
%%
%% 这一项与 7b 互为对照, 两者都需要: 只有 7b 时, 把 format 与 multiple 的作用
%% 范围搞混 (例如让 format 也只作用于多音字) 不会被任何用例发现.
%% 用蓝色而非红色, 使基线里两个键的着色可以分辨。
%%
%% pinyin-setup01 对 format 的断言只是「加了它尺寸不变」, 那是必要的但看不见
%% 着色本身; 着色路径 (`\l_@@_format_tl`) 必须在这里以节点列表固定。
%%   * 单音字「文」设 format -> 应着色 (对比 7b: 设 multiple 时它不着色);
%%   * 不设 format 的「文」-> 不应着色。
\xpinyin*[format=\color{blue}]{文}\par
\xpinyin*{文}\par

%% 8. 嵌套: \xpinyin 出现在 \xpinyin* 内部时, 内层指定的读音优先, 外层其余汉字
%%    仍走数据库.
%%    同样要挑非首选读音才有判别力: 「重」的数据库首选是 zhòng
%%    (`\XPYU{重}{37325}{zhòng}`), 所以这里指定 chóng, 与第 7 项的 zhòng 对照.
\xpinyin*{\xpinyin{重}{chong2}要}\par

%% 9. footnote 缺省为 false: 脚注里的汉字不注音.
%%    \l_@@_restore_footnote_tl 靠 \@parboxrestore 在 grouptype 11 时关掉注音,
%%    所以观察点是脚注文本里的汉字**没有**拼音伴随.
\begin{pinyinscope}
汉\footnote{语}
\end{pinyinscope}\par

%% 9b. footnote=true: 脚注里的汉字也注音.
%%
%% 这一格必须有, 否则第 9 项只固定了「缺省值下的输出」而非这个键的语义 ——
%% 与 multiple (7b) / format (7c) 各有「设 vs 不设」对照的做法一致.
%% 只写第 9 项时, 「设了 footnote=true 之后脚注真的会注音」从未被验证.
%% 基线里的判据: 脚注文本的「语」旁应出现拼音 (脚注字号更小, 实测拼音为
%% 3.19995pt, 与正文注音的 3.99994pt 可区分).
\begin{pinyinscope}[footnote=true]
汉\footnote{语}
\end{pinyinscope}\par

%% 10. \setpinyin: 改写数据库里某个字的首选读音, 影响其后**所有**自动注音,
%%     与 \xpinyin 的「只改这一处」不同 (第 3 项).
%%
%%     判别力同样要挑非首选读音: 「长」的数据库首选是 zhǎng, 这里改成 cháng.
%%     两格对照 —— 改写生效后 \xpinyin*{长} 应得 cháng (而第 4 项同样的
%%     \xpinyin*{长} 在改写之前得的是 zhǎng, 两者在同一份基线里可直接对比)。
%%     `\setpinyin` 是手册里的公开命令, 此前整个测试集对它零覆盖。
\setpinyin{长}{chang2}
\xpinyin*{长}\par
%% 改写是持久的, 不限于紧随其后的那一次注音.
\xpinyin*{长}\par

\newpage

\END

\end{document}
