\input{regression-test}

%% (pdf)LaTeX / CJKutf8 路线的注音回归.
%%
%% 为什么必须单独有这个文件: xpinyin 内部是**两套互不复用的适配层** ——
%% \@@_adjust_xeCJK_hook: 与 \@@_adjust_CJK_hook: (见 xpinyin.dtx). 字体选择、
%% 码位转换 (\@@_to_unicode_xetex:n vs \@@_UTF_to_unicode:n)、接管 \CJKsymbol
%% 的方式都不同. 只跑 XeTeX 的话 CJKutf8 那一半是零覆盖.
%%
%% 本文件跑在 pdftex 上, 与其余测试的 xetex 基线互不干扰: build.lua 的
%% checkengines 含 pdftex, stdengine 是 xetex, 所以本文件的基线是
%% pinyin-cjkutf8-01.pdftex.tlg.
%%
%% 拼音字体这里不换: T1 编码的 Latin Modern 靠 \accent 现场合成重音, ǖ 一类
%% 字符不需要字体本身收字 (实测无 "Missing character"), 因此不存在 XeTeX 路线上
%% 「候选与 oracle 同时缺字而假通过」的问题.
%%
%% 但**尺寸断言在这条路线上比 XeTeX 那条弱得多**, 必须说清, 否则容易误以为
%% 「无缺字」就等于「更可靠」: T1 Latin Modern 下锐音、钝音、caron 的合成结果
%% 宽高完全相同 (实测 ht 三者均 6.88875pt, wd 均 13.333pt), 只有 macron (一声)
%% 的 6.29724pt 和「无重音」(五声) 可与其余区分. 因此 TEST 1 的尺寸比较**拦不住
%% 二声、三声、四声之间的对调** —— 实测把 \@@_num_to_tone:Nn 里的 \' 与 \` 对调,
%% 本文件仍 All checks passed, 而 XeTeX 那四个文件全红.
%% 补文件末尾的 \loggingoutput 段固定实际节点, 作为这条路线的正面证据
%% (与 pinyin-tone01／tone02 的分工同理).

\documentclass{article}
\usepackage{CJKutf8}
\usepackage{xpinyin}
\usepackage[T1]{fontenc}
\usepackage{lmodern}

\begin{document}

\START

\ExplSyntaxOn

\box_new:N \g_test_cand_box
\box_new:N \g_test_oracle_box

\cs_new_protected:Npn \CmpPinyin #1#2#3
  {
    \hbox_set:Nn \g_test_cand_box   {#2}
    \hbox_set:Nn \g_test_oracle_box {#3}
    \tl_log:x
      {
        #1 :~
        wd = \dim_compare:nNnTF
               { \box_wd:N \g_test_cand_box } = { \box_wd:N \g_test_oracle_box }
               { same }
               { DIFF~ \dim_to_decimal:n { \box_wd:N \g_test_cand_box } ~vs~
                       \dim_to_decimal:n { \box_wd:N \g_test_oracle_box } } ,~
        ht = \dim_compare:nNnTF
               { \box_ht:N \g_test_cand_box } = { \box_ht:N \g_test_oracle_box }
               { same }
               { DIFF~ \dim_to_decimal:n { \box_ht:N \g_test_cand_box } ~vs~
                       \dim_to_decimal:n { \box_ht:N \g_test_oracle_box } } ,~
        dp = \dim_compare:nNnTF
               { \box_dp:N \g_test_cand_box } = { \box_dp:N \g_test_oracle_box }
               { same }
               { DIFF~ \dim_to_decimal:n { \box_dp:N \g_test_cand_box } ~vs~
                       \dim_to_decimal:n { \box_dp:N \g_test_oracle_box } }
      }
  }

\ExplSyntaxOff

\ExplSyntaxOn

%% \pinyin 不需要 CJK 环境: 它只排拉丁字母, 与汉字无关.
\TEST{tone~digits~map~to~accent~commands}{
  \CmpPinyin { ma1 } { \pinyin{ma1} } { m\=a }
  \CmpPinyin { ma2 } { \pinyin{ma2} } { m\'a }
  \CmpPinyin { ma3 } { \pinyin{ma3} } { m\v a }
  \CmpPinyin { ma4 } { \pinyin{ma4} } { m\`a }
  \CmpPinyin { ma5 } { \pinyin{ma5} } { ma }
  \CmpPinyin { mi3 } { \pinyin{mi3} } { m\v{\i} }
  \CmpPinyin { hu4 } { \pinyin{hu4} } { h\`u }
}

\TEST{v~is~u-umlaut~after~l~or~n}{
  \CmpPinyin { lv1 } { \pinyin{lv1} } { l\={\"u} }
  \CmpPinyin { lv2 } { \pinyin{lv2} } { l\'{\"u} }
  \CmpPinyin { lv3 } { \pinyin{lv3} } { l\v{\"u} }
  \CmpPinyin { lv4 } { \pinyin{lv4} } { l\`{\"u} }
  \CmpPinyin { nv2 } { \pinyin{nv2} } { n\'{\"u} }
  %% j 不是 l / n, v 仍是 u.
  \CmpPinyin { jv1 } { \pinyin{jv1} } { j\=u }
}

\ExplSyntaxOff

\ExplSyntaxOn

%% 注音要在 CJK 环境内. 这里的观察量是「注音后整盒变高、宽度不变」——
%% 拼音在零宽 overlap 盒里, 所以宽度与不注音时相同, 高度则因拼音抬到汉字上方
%% 而增加. 这与 XeTeX 路线的结构一致, 说明 CJK 适配层也走同一套装盒逻辑.
%% CJK 环境必须开在**盒子内部**. 写成 \begin{CJK} 包住 \hbox_set:Nn 时,
%% 汉字根本进不了盒子, 实测三项宽高全为 0pt —— 而 0pt = 0pt 会让「宽度不变」
%% 那一半照样报 unchanged, 看着像通过. 初版正是这么写的.
\TEST{annotation~adds~height~but~not~width}{
  \hbox_set:Nn \g_test_cand_box
    { \begin{CJK}{UTF8}{gbsn}\xpinyin*{汉语}\end{CJK} }
  \hbox_set:Nn \g_test_oracle_box
    { \begin{CJK}{UTF8}{gbsn}汉语\end{CJK} }
  \tl_log:x
    {
      annotated~ wd = \dim_to_decimal:n { \box_wd:N \g_test_cand_box } ,~
      ht = \dim_to_decimal:n { \box_ht:N \g_test_cand_box } ;~
      plain~ wd = \dim_to_decimal:n { \box_wd:N \g_test_oracle_box } ,~
      ht = \dim_to_decimal:n { \box_ht:N \g_test_oracle_box }
    }
  \tl_log:x
    {
      wd~ \dim_compare:nNnTF
            { \box_wd:N \g_test_cand_box } = { \box_wd:N \g_test_oracle_box }
            { unchanged } { CHANGED } ,~
      ht~ \dim_compare:nNnTF
            { \box_ht:N \g_test_cand_box } > { \box_ht:N \g_test_oracle_box }
            { grew } { NOT-GREW }
    }
}

%% ratio / vsep 在 CJK 路线上同样生效.
\TEST{ratio~and~vsep~apply~under~CJKutf8}{
  \hbox_set:Nn \g_test_cand_box
    { \begin{CJK}{UTF8}{gbsn}\xpinyin*{文}\end{CJK} }
  \hbox_set:Nn \g_test_oracle_box
    { \begin{CJK}{UTF8}{gbsn}\xpinyin*[ratio=.8]{文}\end{CJK} }
  \tl_log:x
    {
      ratio-default-vs-0.8:~
      a~ ht = \dim_to_decimal:n { \box_ht:N \g_test_cand_box } ,~
      b~ ht = \dim_to_decimal:n { \box_ht:N \g_test_oracle_box }
    }
  \hbox_set:Nn \g_test_oracle_box
    { \begin{CJK}{UTF8}{gbsn}\xpinyin*[vsep=2em]{文}\end{CJK} }
  \tl_log:x
    {
      vsep-1em-vs-2em:~ ht~ delta = \dim_to_decimal:n
        { \box_ht:N \g_test_oracle_box - \box_ht:N \g_test_cand_box }
    }
}

%% 指定读音覆盖数据库首选读音. 宽度看不出拼音内容 (零宽 overlap 盒), 所以这里
%% 用 \pinyin 单独排两个读音串来证明它们本就不同宽 —— 那是本项断言的前提;
%% 读音是否真的被用上, 由 XeTeX 路线的 pinyin-scope01 以节点列表固定.
\TEST{explicit~reading~is~accepted~under~CJKutf8}{
  \CmpPinyin { chang2-vs-zhang3-differ }
    { \pinyin{chang2} } { \pinyin{zhang3} }
  \hbox_set:Nn \g_test_cand_box
    { \begin{CJK}{UTF8}{gbsn}\xpinyin{长}{chang2}\end{CJK} }
  \tl_log:x
    {
      explicit-reading~ wd = \dim_to_decimal:n { \box_wd:N \g_test_cand_box } ,~
      ht = \dim_to_decimal:n { \box_ht:N \g_test_cand_box }
    }
}

\ExplSyntaxOn

%% TEST 6: \disablepinyin 的两种形式在 CJKutf8 路线上的分工 (#265 / PR #977).
%%
%% 这条路线必须单独覆盖: 开关本身与适配层无关 (两个布尔在 \xpinyin 里判断),
%% 但「关掉之后汉字仍能正常排出」要经过 \@@_adjust_CJK_hook: 那一半 ——
%% \xpinyin 的禁用分支走 \use_i:nn 丢弃读音参数, 若该分支在 CJK 路线上出错
%% (例如读音参数没被吃掉而漏排成正文), 只测 XeTeX 是发现不了的.
%%
%% 观察量是**高度**: 拼音在零宽 overlap 盒里, 注音不改变宽度, 但会把盒子抬高
%% (TEST 3 已固定这一点). 所以「有没有注音」用 ht 与不注音的基准比较即可,
%% 不需要节点列表. 三格的判据:
%%   * 普通 \disablepinyin  + 显式读音 -> 仍注音 -> ht 大于基准;
%%   * \disablepinyin*      + 显式读音 -> 不注音 -> ht 等于基准;
%%   * \disablepinyin*      + \xpinyin* -> 不注音 -> ht 等于基准.
%% 实测 (纯 pdflatex): 普通形式下 yǔ 与 wén 都排出, 星号形式下两者都不排出.
\TEST{disablepinyin~star~is~a~master~switch~under~CJKutf8}{
  %% 基准: 完全不注音的「语」.
  \hbox_set:Nn \g_test_oracle_box
    { \begin{CJK}{UTF8}{gbsn}语\end{CJK} }
  %% 普通形式不影响显式读音.
  \hbox_set:Nn \g_test_cand_box
    { \begin{CJK}{UTF8}{gbsn}\disablepinyin\xpinyin{语}{yu3}\end{CJK} }
  \tl_log:x
    {
      plain~ disablepinyin~ +~ explicit~ reading:~
      ht~ \dim_compare:nNnTF
            { \box_ht:N \g_test_cand_box } > { \box_ht:N \g_test_oracle_box }
            { annotated } { NOT-ANNOTATED } ,~
      wd~ \dim_compare:nNnTF
            { \box_wd:N \g_test_cand_box } = { \box_wd:N \g_test_oracle_box }
            { unchanged } { CHANGED }
    }
  %% 星号形式连显式读音一起关掉.
  \hbox_set:Nn \g_test_cand_box
    { \begin{CJK}{UTF8}{gbsn}\disablepinyin*\xpinyin{语}{yu3}\end{CJK} }
  \tl_log:x
    {
      star~ disablepinyin~ +~ explicit~ reading:~
      ht~ \dim_compare:nNnTF
            { \box_ht:N \g_test_cand_box } = { \box_ht:N \g_test_oracle_box }
            { not-annotated } { ANNOTATED } ,~
      wd~ \dim_compare:nNnTF
            { \box_wd:N \g_test_cand_box } = { \box_wd:N \g_test_oracle_box }
            { unchanged } { CHANGED }
    }
  %% 星号形式同样关掉自动注音.
  \hbox_set:Nn \g_test_cand_box
    { \begin{CJK}{UTF8}{gbsn}\disablepinyin*\xpinyin*{语}\end{CJK} }
  \tl_log:x
    {
      star~ disablepinyin~ +~ auto~ annotation:~
      ht~ \dim_compare:nNnTF
            { \box_ht:N \g_test_cand_box } = { \box_ht:N \g_test_oracle_box }
            { not-annotated } { ANNOTATED }
    }
}

%% TEST 7: 两个布尔都是局部赋值, 随分组恢复 (CJK 路线).
%%
%% 与 XeTeX 路线的第 2d 项同理: \disablepinyin* 用 \bool_set_false:N 而非
%% \bool_gset_false:N. 这里把禁用限制在一个显式分组里, 组外应自动恢复注音,
%% 不需要 \enablepinyin. 若误改成全局赋值, TEST 7 仍会通过 (它每格都在独立
%% 的 \hbox_set:Nn 里且互不依赖顺序), 只有本项会红.
%% 这一项的写法踩过两个坑, 都会让它变成恒真断言, 记在这里:
%%
%% 坑一 —— \hbox_set:Nn **不能**写在 CJK 环境内部. 与 TEST 3 的记录同源:
%% 写成 \begin{CJK} ... \hbox_set:Nn \gB { \xpinyin*{语} } ... \end{CJK} 时,
%% 实测该盒 ht = 0pt (汉字进不了盒子), 与任何基准比都得不出有意义的结论.
%% 所以每个盒子都必须自带 \begin{CJK}...\end{CJK}, 禁用用的子分组开在盒内.
%%
%% 坑二 —— 不能把「禁用组」和「组后的字」放进同一个盒子再比总高. 初版那么写,
%% 盒内既有组内的字又有组外的字; 实测把 \bool_set_false:N 改成
%% \bool_gset_false:N (禁用泄漏到组外) 时, 该盒仍比单个未注音汉字高
%% (8.46454pt vs 8.39754pt) —— 多出的高度来自盒内其他内容而不是「语」的拼音,
%% `>` 比较照报 restored. 现在盒内只放组后的那一个字.
%%
%% 另外基准必须取**从未禁用过**的另一个盒子: 若拿变异后的两个值互比, 它们会
%% 同为 8.39754pt 而仍然相等. 实测正确实现下两者同为 12.75551pt, 全局赋值变异
%% 下同时掉到 8.39754pt, 与未禁用基准比较即失配.
\TEST{disable~is~group-local~under~CJKutf8}{
  %% 候选: 盒内先在一个子分组里禁用, 组结束后再注音.
  \hbox_set:Nn \g_test_cand_box
    { \begin{CJK}{UTF8}{gbsn}{ \disablepinyin* }\xpinyin*{语}\end{CJK} }
  %% 基准: 从未禁用过的同一个字.
  \hbox_set:Nn \g_test_oracle_box
    { \begin{CJK}{UTF8}{gbsn}\xpinyin*{语}\end{CJK} }
  \tl_log:x
    {
      after~ group~ vs~ never-disabled:~
      ht~ \dim_compare:nNnTF
            { \box_ht:N \g_test_cand_box } = { \box_ht:N \g_test_oracle_box }
            { identical } { DIFFERENT } ,~
      wd~ \dim_compare:nNnTF
            { \box_wd:N \g_test_cand_box } = { \box_wd:N \g_test_oracle_box }
            { identical } { DIFFERENT }
    }
  %% 再对「未注音」取一次正面证据: 只有上面的等高比较时, 若两边都退化成不注音
  %% (例如禁用泄漏且基准也被影响) 仍会相等. 与未注音基准比较可排除这种情形.
  \hbox_set:Nn \g_test_oracle_box
    { \begin{CJK}{UTF8}{gbsn}语\end{CJK} }
  \tl_log:x
    {
      after~ group~ vs~ unannotated:~
      ht~ \dim_compare:nNnTF
            { \box_ht:N \g_test_cand_box } > { \box_ht:N \g_test_oracle_box }
            { annotated } { NOT-ANNOTATED }
    }
}

\ExplSyntaxOff

%% TEST 8 (\loggingoutput, 在 \TEST 之外): 这条路线的正面证据 —— 用 \loggingoutput 固定 shipout 的实际节点.
%%
%% 上面的尺寸比较区分不了二／三／四声 (T1 Latin Modern 三者宽高全同, 见文件头),
%% 所以必须让节点本身进基线. T1 下重音有两种实现形态, 基线会一并固定:
%%   * 一声 macron 与三声 caron 走 \accent, 节点是
%%     `\kern (for accent)` + 重音字符 + `\kern` + 基字母;
%%   * 二声、四声在 T1 里有预组合字形, 节点就是单个字符.
%% 二／四声因此在基线里是两个**不同的**预组合字符, 对调实现即失配.
%% 不能用 \box_log:N／\box_show:N／\showbox 取节点: 三者都抛 `! OK.`, 而
%% checkopts 带 -halt-on-error, 会当场终止编译, 其后用例静默不执行却仍可能报绿.
%% 改用 \loggingoutput 让 shipout 例程把整页节点写进日志.
%%
%% 必须放在 \TEST 里: 页面在 \END 之前确实排出 (原始日志有 "Completed box
%% being shipped out"), 但 l3build 只把 \TEST 区间内的内容归一化进 .tlg,
%% 写在 \TEST 之外时节点列表进不了基线 —— 那样这一项就等于没有断言.
%% 写在顶层而不是 \TEST 里 —— 与 pinyin-tone02.lvt 同一写法.
%% 放进 \TEST 时实测节点列表进不了 .tlg (原始日志有 "Completed box being
%% shipped out", 但归一化后该段被丢弃), 那样这一项等于没有断言.
\loggingoutput
\pinyin{ma1}\par\pinyin{ma2}\par\pinyin{ma3}\par
\pinyin{ma4}\par\pinyin{ma5}\par
\newpage

\END

\end{document}
